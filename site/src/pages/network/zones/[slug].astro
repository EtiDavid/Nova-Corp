---
import ZonePath from "../../../components/nova/xf/ZonePath.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

import { zones, rulesForZone, networkEvidence, type Zone } from "../../../data/network";
import { getSystem } from "../../../data/model";
export function getStaticPaths(){return zones.map(zone=>({params:{slug:zone.slug},props:{zone}}));}
interface Props {zone:Zone}
const {zone}=Astro.props;
const base=import.meta.env.BASE_URL;
const rules=rulesForZone(zone.slug);
const isVpn=zone.slug==="vpn_remote";
const isClient=zone.slug==="client";
const zoneCopy:Record<string,string[]>={"wan": ["wan", "vtnet0", "Upstream DHCP; recorded 192.168.178.71", "No local WAN DHCP scope", "WAN is the firewall's outside interface. It gives Nova Corp a way out to the internet. It is not a management network.", "An outside packet only gets in if a rule accepts it. The upstream router's port forwarding is separate from pfSense's own NAT and rules.", "Outside router", "Incoming connection", "pfSense rules", ""], "lan": ["lan", "vtnet1", "10.99.99.1/24", "10.99.99.100–10.99.99.199", "LAN is the original untagged network from the first pfSense build (CR-002). It stays in the lab next to the tagged VLANs. It is not one of the five VLANs, and removing it is still an open item.", "Two broad allow rules cover IPv4 and IPv6. A configured IPv6 rule does not prove IPv6 routing works.", "Legacy LAN device", "Broad saved allow", "Other networks via firewall", ""], "mgmt": ["opt1", "vtnet1.10 · VLAN 10", "10.10.10.1/24", "10.10.10.100–10.10.10.199", "IT needs its own administration network, and pfSense has a management interface here. Proxmox management is still on the upstream home network, not in this VLAN.", "Two broad management permits remain. The CLIENT network has its own rules that block access to this one. Isolating privileged administration is the next planned change, CR-016.", "Management device (planned use)", "MGMT rule evaluation", "Management interface", "firewall-management-exposure"], "infra": ["opt2", "vtnet1.20 · VLAN 20", "10.10.20.1/24", "10.10.20.100–10.10.20.199", "The domain controllers and the file server live here, so staff reach shared services through the firewall.", "DC01 is 10.10.20.10, DC02 is 10.10.20.11 and FILES01 is 10.10.20.20. The INFRA IPv4 rule is broad. Traffic between two servers in this VLAN is switched at the Proxmox bridge and does not reach pfSense.", "NOVA-CLIENT on VLAN 40", "Routed permitted traffic", "DC01 / DC02 / FILES01", "fileserver-subnet"], "app": ["opt3", "vtnet1.30 · VLAN 30", "10.10.30.1/24", "10.10.30.100–10.10.30.199", "APP is reserved for future application servers. Nothing is deployed in it yet.", "Its one IPv4 pass-to-any rule is broad. Restricting it is future work.", "Future application (planned)", "Configured broad allow", "Other destinations", ""], "client": ["opt4", "vtnet1.40 · VLAN 40", "10.10.40.1/24", "10.10.40.100–10.10.40.199", "Employees need company services, not admin tools. NOVA-CLIENT is the workstation I use to test that difference.", "The first two CLIENT rules block the firewall's web admin ports and the MGMT network. The third allows other IPv4 traffic. After I added the blocks (CR-015), I retested DNS, Active Directory, SMB and internet access.", "NOVA-CLIENT 10.10.40.100", "Two blocks, then remaining allow", "Allowed business services", "firewall-management-exposure"], "dmz": ["opt5", "vtnet1.50 · VLAN 50", "10.10.50.1/24", "10.10.50.100–10.10.50.199", "DMZ is reserved for future services that face the outside. Nothing is deployed in it yet.", "Its IPv4 rule is broad. Tighter rules and testing of a public-facing service are future work.", "Future public service (planned)", "Configured broad allow", "Other destinations", ""], "vpn_remote": ["opt6", "tun_wg0 · WireGuard", "10.10.60.1/24", "No DHCP; configured peer 10.10.60.10/32", "A remote laptop can use a separate encrypted tunnel to reach selected company services. VPN_REMOTE is a WireGuard tunnel, not a VLAN.", "Four pass rules allow ping to the gateway and selected domain controller traffic. Two blocks stop access to the rest of INFRA and the protected networks. The tunnel is configured but not in use yet, and the test from an outside network is deferred to CR-016.", "Remote laptop (configured peer)", "WireGuard, then the VPN rules", "Selected domain controller services", "wireguard-handshake"]};
const [iface,device,ip,dhcp,purpose,behavior,origin,path,destination,incident]=zoneCopy[zone.slug];
---
<BaseLayout title={zone.name+" network"} description={"Explore the actual "+zone.name+" network, its connected systems and ordered firewall rules."} breadcrumbs={[{label:"Network",href:"network/"},{label:zone.name}]}>
<section class="page-head"><div class="container">
 <div class="eyebrow">{zone.kind} / Network area</div><h1>{zone.name}</h1><p class="lead" style="margin-top:17px">{zone.purpose}</p>
</div></section>
<section class="section compact"><div class="container grid-main"><div>
  <section class="content-section"><h2>What is the {zone.name} network?</h2><p>{purpose}</p><h2 style="margin-top:24px">Why does Nova Corp use it?</h2><p>{behavior}</p><ZonePath origin={origin} path={path} destination={destination} zone={zone.name} />{isClient&&<p><a href={base+"network/rules/1795199640/"}>Blocked management web ports</a> · <a href={base+"network/rules/1795195682/"}>Blocked MGMT network</a></p>}{incident&&<p><a href={base+"incidents/"+incident+"/"}>Read the related investigation →</a></p>}</section>
  <section class="content-section">
    <h2>Firewall rules on this interface</h2>
    <p class="muted" style="margin:13px 0 18px">Rules are listed in the order pfSense checks them. An earlier block overrides a later allow.</p>
    <ol class="rule-stack">{rules.map(rule=><li class="rule-step">
      <a href={base+"network/rules/"+rule.id+"/"} class="rule-entry">
        <span class={"rule-action "+(rule.action==="BLOCK"?"block":"pass")}>{rule.action}</span>
        <span><strong>{rule.description}</strong><small>{rule.protocol} · {rule.destination} · {rule.ports}</small></span>
        <span aria-hidden="true">→</span>
      </a></li>)}</ol>
  </section>

  <section class="content-section">
   <h2>Which systems are related?</h2>
   <div class="card-list">{zone.devices.map(id=>{const system=getSystem(id);return system?<a class="system-card" href={base+"systems/"+system.slug+"/"}><small>{system.category}</small><h3>{system.name}</h3><p>{system.summary}</p><span class="readmore">Open system →</span></a>:null})}</div>
  </section>
  {isClient&&<section class="content-section"><div class="paper panel"><h2>Follow an employee request</h2><p class="muted" style="margin:12px 0 18px">The workstation enters CLIENT. Two rules block the firewall's web management and the management network, then one rule allows other traffic. When I tested the blocks, DNS, sign-in, file shares and internet kept working.</p><a class="btn small" href={base+"network/rules/1795199640/"}>Start with the first block →</a><p style="margin-top:15px"><a href={base+"files/"}>Then follow a permitted company file request →</a></p></div></section>}
  {isVpn&&<div class="note warning"><strong>This is a WireGuard tunnel, not a VLAN.</strong> It is configured but not in use yet, and the test from an outside network is deferred to CR-016.</div>}
  <section class="content-section"><details><summary>Technical checks</summary><p><strong>Where:</strong> pfSense shell.</p><h3>Check the interface</h3><pre><code>{"ifconfig "+device.split(" ")[0]}</code></pre><p><strong>Expected:</strong> {ip}; compare interface settings and the saved inventory.</p><h3>Inspect active firewall rules</h3><pre><code>pfctl -sr</code></pre><p><strong>Expected:</strong> the intended rules for this interface appear in the configured order. Review actual traffic separately.</p>{isClient&&<><h3>Confirm business traffic</h3><p><strong>Where:</strong> NOVA-CLIENT.</p><pre><code>Test-NetConnection 10.10.20.20 -Port 445</code></pre><p><strong>Expected:</strong> TcpTestSucceeded: True.</p></>}</details></section><section class="content-section"><h2>Engineering journals</h2><p><a href={base+"reference/explore/network/zones/"+zone.slug.toUpperCase()+"/"}>Complete network-zone documentation →</a></p><p><a href={base+"reference/explore/network/DHCP/"}>Address assignment and DHCP →</a></p><p><a href={base+"journals/change_request_cr002/"}>Network installation journal →</a></p></section>
 </div><aside>
   <div class="sidebox"><h3>Zone profile</h3><dl class="fact-list"><div><dt>Kind</dt><dd>{zone.kind}</dd></div><div><dt>Interface</dt><dd>{iface}</dd></div><div><dt>Device</dt><dd>{device}</dd></div><div><dt>Address assignment</dt><dd>{dhcp}</dd></div><div><dt>Documented subnet</dt><dd>{zone.address}</dd></div><div><dt>Gateway</dt><dd>{zone.gateway}</dd></div><div><dt>Explicit rules</dt><dd>{rules.length}</dd></div></dl></div>
   <div class="sidebox"><h3>Source</h3><p class="muted">The full network profile is in the repository.</p><a class="evidence-link" href={networkEvidence.zone(zone.slug)}>Open network profile ↗</a></div>
   <div class="sidebox"><a href={base+"network/"}>← All network areas</a><p style="margin-top:12px"><a href={base+"network/rules/"}>All firewall rules →</a></p></div>
 </aside></div></section>
</BaseLayout>
<style>.zone-flow{background:var(--surface);border:1px solid var(--rule);padding:18px;border-radius:12px;margin:24px 0}.zone-flow-track{display:flex;align-items:center;gap:8px}.zone-flow-track>div,.zone-flow-track>a{flex:1;min-width:0;text-align:center;padding:12px 8px;border:1px solid var(--rule);border-radius:8px;background:var(--surface);overflow-wrap:anywhere}.zone-flow-track>span{color:var(--c-amber);animation:zoneflow 2s ease-in-out infinite}.zone-flow figcaption{text-align:center;font-size:.84rem;margin-top:12px;color:var(--ink)}@keyframes zoneflow{50%{transform:translateX(3px);opacity:.6}}@media(prefers-reduced-motion:reduce){.zone-flow-track>span{animation:none}}@media(max-width:600px){.zone-flow-track{flex-direction:column}.zone-flow-track>span{transform:rotate(90deg);animation:none}.zone-flow-track>div,.zone-flow-track>a{width:100%;box-sizing:border-box}}</style>
