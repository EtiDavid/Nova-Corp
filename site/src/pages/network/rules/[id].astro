---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { rules, findZone, aliases, networkEvidence, type Rule } from "../../../data/network";
export function getStaticPaths(){return rules.map(rule=>({params:{id:rule.id},props:{rule}}));}
interface Props {rule:Rule}
const {rule}=Astro.props;
const base=import.meta.env.BASE_URL;
const zone=findZone(rule.zone);
const related=aliases.filter(a=>rule.aliases.includes(a.name));
const hasManagementEvidence=rule.zone==="client"&&(rule.order===1||rule.order===2);
---
<BaseLayout title={rule.description} description={rule.description+" — see actual pfSense interface, priority and source evidence."} breadcrumbs={[{label:"Network",href:"network/"},{label:"Rules",href:"network/rules/"},{label:"Rule on "+zone?.name}]}>
<section class="page-head"><div class="container">
<div class="eyebrow">{zone?.name} / Ordered firewall rule</div>
<h1>{rule.description}</h1><p class="lead" style="margin-top:17px">The recorded action is <strong>{rule.action}</strong>, at position <strong>{rule.order}</strong> on the incoming {zone?.name} interface.</p>
<div style="margin-top:19px"><span class={"rule-action "+(rule.action==="BLOCK"?"block":"pass")}>{rule.action}</span><span class="muted" style="margin-left:12px;font-size:.83rem">Saved and enabled at the last documented snapshot, not a live packet trace</span></div>
</div></section>
<section class="section compact"><div class="container grid-main"><div>
<section class="content-section">
 <h2>What traffic does it match?</h2>
 <div class="paper panel" style="margin-top:19px"><dl class="fact-list">
  <div><dt>Incoming interface</dt><dd><a href={base+"network/zones/"+rule.zone+"/"}>{zone?.name}</a></dd></div>
  <div><dt>Order within interface</dt><dd>{rule.order}</dd></div>
  <div><dt>Saved action</dt><dd>{rule.action}</dd></div>
  <div><dt>IP family · protocol</dt><dd>{rule.family} · {rule.protocol}</dd></div>
  <div><dt>Source</dt><dd>{rule.source}</dd></div>
  <div><dt>Destination</dt><dd>{rule.destination}</dd></div>
  <div><dt>Service/port specification</dt><dd>{rule.ports}</dd></div>
 </dl></div>
</section>
<section class="content-section">
 <h2>Follow the related objects</h2>
 {related.length>0?<div class="card-list">{related.map(a=><a class="system-card" href={base+"network/aliases/"+a.slug+"/"}><small>{a.kind} alias</small><h3>{a.name}</h3><p>{a.description}</p><span class="readmore">Open alias →</span></a>)}</div>:<div class="note">No reusable alias is recorded on this rule in the selected public model. Its saved source and destination values remain visible in the technical facts above.</div>}
</section>
<section class="content-section">
 <h2>What does the evidence establish?</h2>
 <div class="paper panel"><p class="muted">{hasManagementEvidence?"These CLIENT management-blocking controls were part of the November hardening review, which tested denied management reachability alongside preserved business access. This rule profile itself is a dated configuration record, not a packet capture for every possible source and target.":"This page records the exact configured rule fields. The presence of a pass or block entry is not evidence that every flow was separately tested end to end. See the original engineering journal for any observed packets and test outcomes."}</p>
 <a class="evidence-link" href={networkEvidence.rule(rule.id)}>Original detailed firewall rule ↗</a>
 {hasManagementEvidence&&<p style="margin-top:15px"><a href={networkEvidence.incident}>See the management-reachability investigation ↗</a></p>}
 </div>
</section>
</div><aside>
 <div class="sidebox"><h3>Position matters</h3><p class="muted">Earlier rules on the same interface are evaluated before later ones. The order here comes from the saved pfSense configuration.</p><a class="evidence-link" href={base+"network/zones/"+rule.zone+"/"}>See full {zone?.name} rule order →</a></div>
 <div class="sidebox"><h3>Engineering identifier</h3><code class="technical">{rule.id}</code><p class="muted" style="margin-top:10px">This exact tracker value is retained only in technical detail so engineers can compare it with the original rule record.</p></div>
 <div class="sidebox"><a href={base+"network/rules/"}>← All firewall rules</a><p style="margin-top:12px"><a href={base+"network/"}>Network Gatehouse →</a></p></div>
</aside></div></section>
</BaseLayout>
