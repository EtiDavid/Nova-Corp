---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OriginalPdfEvidenceGallery from "../../components/OriginalPdfEvidenceGallery.astro";
import EngineeringSourceEmbed from "../../components/EngineeringSourceEmbed.astro";
import EvidencePanel from "../../components/EvidencePanel.astro";
const base=import.meta.env.BASE_URL;
const volumes=[["C:","Windows and DFS namespace","63.15 GiB","34.39 GiB"],["D:","Company documents (NovaData)","59.98 GiB","59.49 GiB"],["B:","Windows backup target (NovaBackup)","99.98 GiB","97.98 GiB"]];
---
<BaseLayout title="Windows volumes and NovaData" description="Where Nova Corp stores Windows, company documents and file backups." breadcrumbs={[{label:"NOVA-FILES01",href:"systems/nova-files01/"},{label:"Windows volumes"}]}>
<section class="page-head"><div class="container"><div class="eyebrow">File server storage</div><h1>Windows volumes and NovaData</h1><p class="lead">The server separates Windows, company documents and backup storage into different volumes.</p></div></section>
<section class="section compact"><div class="container prose"><h2>What is D:\NovaData?</h2><p>It is the folder on the dedicated D: data volume where Nova Corp keeps its five departmental folders.</p><h2>Why does it exist?</h2><p><strong>Problem:</strong> If employee documents are scattered across the Windows system drive, managing disk space and planning recovery becomes harder.</p><p><strong>Solution:</strong> Store business documents separately from Windows and direct backups to B:. This makes storage easier to manage, but the volumes are still inside the same nested lab failure domain.</p><h2>Storage specifications</h2><p>Historical recorded capacity and free space, not live readings.</p><div class="card-list">{volumes.map(([drive,purpose,capacity,free])=><div class="paper panel"><h3>{drive}</h3><p>{purpose}</p><p>Capacity: {capacity} · Free: {free}</p></div>)}</div><OriginalPdfEvidenceGallery ids={["fileserver-novadata-baseline","fileserver-backup-volume","fileserver-proxmox-hardware"]} heading="The actual company data folder, backup volume and virtual disk attachments"/><EvidencePanel subject="Complete Windows volume view" requested="A single reviewed Disk Management or Get-Volume screenshot showing C:, D: and B: together is still needed; the original screenshots above establish separate parts of that configuration."/><h2>How to check it</h2><p>From the server, list volumes and inspect the departmental folders. These are suggested read-only checks, not a new recorded test.</p><pre><code>{'Get-Volume\nGet-ChildItem D:\\NovaData'}</code></pre><p><a href={base+"files/"}>Browse the five departmental folders →</a> · <a href={base+"files/backup/"}>Backup policy and tests →</a></p><details><summary>Original complete storage inventory</summary><EngineeringSourceEmbed sourcePath="docs/explore/files/VOLUMES.md" title="Recorded Windows volume inventory"/></details><h2>Related incidents</h2><p><a href={base+"incidents/backup-target-unavailable/"}>Backup disk taken offline →</a></p><h2>Engineering journals</h2><p><a href={base+"pdf-journals/CR-012_Windows_Server_Backup_and_Recovery_Journal.pdf"}>CR-012 original PDF →</a></p><p><a href={base+"systems/nova-files01/"}>Back to NOVA-FILES01 →</a></p></div></section>
</BaseLayout>