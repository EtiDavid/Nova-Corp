---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
interface Props { entry: CollectionEntry<"incidents">; }
export async function getStaticPaths() {
  const entries = await getCollection("incidents");
  return entries.map((entry: CollectionEntry<"incidents">)=>({params:{slug:entry.id},props:{entry}}));
}
const {entry} = Astro.props;
const {Content} = await render(entry);
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={entry.data.title} description={entry.data.summary} breadcrumbs={[{label:"Explore",href:"explore/"},{label:"Incident Lab",href:"areas/incident-lab/"},{label:entry.data.title}]}>
<section class="page-head"><div class="container">
 <div class="eyebrow">Incident Lab / Controlled engineering test</div>
 <h1>{entry.data.title}</h1>
 <p class="lead" style="margin-top:16px">{entry.data.summary}</p>
 <div style="display:flex;align-items:center;gap:12px;margin-top:19px"><span class={"status "+(entry.data.status==="deferred"?"deferred":"")}>{entry.data.status==="tested"?"Recorded test":"Deferred"}</span><span class="muted" style="font-size:.82rem">{entry.data.date} · {entry.data.outcome}</span></div>
</div></section>
<section class="section compact"><div class="container grid-main">
  <article class="prose"><Content /></article>
  <aside>
   <div class="sidebox"><h3>Original evidence</h3><p class="muted" style="font-size:.9rem">Open the published engineering investigation for exact commands, expected and actual results, and supporting journal references.</p><a class="evidence-link" href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">Open full source ↗</a></div>
   <div class="sidebox"><h3>Continue exploring</h3>{entry.data.systems.map((slug:string)=><p style="margin-bottom:12px"><a href={base+"systems/"+slug+"/"}>{slug.toUpperCase()} →</a></p>)}<a href={base+"areas/incident-lab/"}>← All investigations</a></div>
  </aside>
</div></section>
</BaseLayout>
