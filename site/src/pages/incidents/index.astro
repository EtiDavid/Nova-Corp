---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { typeLabel } from "../../lib/nova";
const base = import.meta.env.BASE_URL;
const all = await getCollection("incidents");
const order = ["real", "controlled", "blind", "tabletop"];
const crRank = (c?: string | null) => (c === "CR-A" ? 100 : c ? parseInt(c.slice(3), 10) : 0);
// Featured first, then the most recently built change first. The site shows no dates.
const cases = [...all].sort((a: CollectionEntry<"incidents">, b: CollectionEntry<"incidents">) =>
  ((a.data as any).featured ?? 99) - ((b.data as any).featured ?? 99) || crRank((b.data as any).cr) - crRank((a.data as any).cr) || a.id.localeCompare(b.id));
const typeOf = (e: CollectionEntry<"incidents">) => (e.data as any).type as string;
const count = (t: string) => all.filter((e: CollectionEntry<"incidents">) => (e.data as any).type === t).length;
const featured = all.find((e: CollectionEntry<"incidents">) => e.id === "dns-client-outage");
---
<BaseLayout title="Incidents" description="What broke in the Nova Corp lab, how I worked out why, and how I proved the fix: unexpected incidents, controlled tests, blind tests and tabletop exercises." breadcrumbs={[{ label: "Incidents" }]}>
  <section class="page-head tight"><div class="container">
    <h1>Incidents: when something broke, here is how I found out why.</h1>
    <p class="lead" style="margin-top:14px">Each case starts with what an employee saw, then the checks I ran, the cause, and how I proved the fix.</p>
  </div></section>
  {featured && <section class="container"><div class="outcome" style="max-width:820px">
    <span class="chip tested">Featured replay</span>
    <h2 style="font-size:1.4rem">"The IT folder won't open."</h2>
    <p>{featured.data.summary} Step through five recorded checks.</p>
    <a class="btn" href={base + "incidents/dns-client-outage/"} style="width:fit-content">Follow the investigation <span aria-hidden="true">→</span></a>
  </div></section>}
  <section class="v4-section" style="border-top:0"><div class="container">
    <div class="tabs" role="group" aria-label="Filter incidents by type" id="filters">
      <button type="button" data-f="all" aria-pressed="true">All ({all.length})</button>
      {order.map((t) => <button type="button" data-f={t} aria-pressed="false">{typeLabel[t]} ({count(t)})</button>)}
    </div>
    <div class="outcomes" id="case-grid">
      {cases.map((e: CollectionEntry<"incidents">) => (<article class="outcome" data-g={typeOf(e)}>
        <span class={"chip type " + typeOf(e)}>{typeLabel[typeOf(e)]}</span>
        <h3>{e.data.shortTitle ?? e.data.title}</h3>
        <p>{e.data.saw ?? e.data.summary}</p>
        <p class="result">{e.data.outcome}</p>
        <a href={base + "incidents/" + e.id + "/"}>Read the investigation</a>
      </article>))}
    </div>
    <p class="muted" style="margin-top:28px">More investigations are in the <a href="https://github.com/EtiDavid/Nova-Corp/tree/main/docs/explore/incidents">public incident archive ↗</a>; they are not all rewritten as case studies yet.</p>
  </div></section>
  <script is:inline>
  (function () {
    var btns = [].slice.call(document.querySelectorAll("#filters button"));
    var cards = [].slice.call(document.querySelectorAll("#case-grid .outcome"));
    function apply(f) {
      btns.forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.f === f ? "true" : "false"); });
      cards.forEach(function (c) { c.hidden = !(f === "all" || c.dataset.g === f); });
    }
    btns.forEach(function (b) { b.addEventListener("click", function () { apply(b.dataset.f); }); });
    var t = new URLSearchParams(location.search).get("type");
    var alias = { unplanned: "real", failure: "all", recovery: "all" };
    t = alias[t] || t;
    apply(["real", "controlled", "blind", "tabletop"].indexOf(t) >= 0 ? t : "all");
  })();
  </script>
</BaseLayout>
