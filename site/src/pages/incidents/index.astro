---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
const base = import.meta.env.BASE_URL;
const group: Record<string, string> = {
  "dns-client-outage": "failure", "dc01-outage": "failure", "firewall-management-exposure": "failure",
  "file-permission-denial": "failure", "wireguard-handshake": "failure", "proxmox-storage-pressure": "failure",
  "backup-target-unavailable": "recovery", "vpn-validation-deferred": "deferred"
};
const labels: Record<string, string> = { failure: "Failure investigated", recovery: "Recovery tested", deferred: "Deferred test" };
const all = await getCollection("incidents");
const order = ["failure", "recovery", "deferred"];
const cases = all.map((e: CollectionEntry<"incidents">) => ({ e, g: e.id in group ? group[e.id] : (e.data.status === "deferred" ? "deferred" : "failure") }))
  .sort((a: {e: CollectionEntry<"incidents">; g: string}, b: {e: CollectionEntry<"incidents">; g: string}) => order.indexOf(a.g) - order.indexOf(b.g) || a.e.data.title.localeCompare(b.e.data.title));
const featured = all.find((e: CollectionEntry<"incidents">) => e.id === "dns-client-outage");
---
<BaseLayout title="Investigations" description="Replay real troubleshooting from the Nova Corp lab: DNS, Domain Controller outage, firewall rules, file permissions, VPN and recovery." breadcrumbs={[{ label: "Investigations" }]}>
  <section class="page-head tight"><div class="container">
    <div class="byline">Investigations</div>
    <h1>When something broke, here is how I found out why.</h1>
    <p class="lead" style="margin-top:14px">Each case starts with what an employee saw, then the checks I ran, the cause, and how I proved the fix.</p>
  </div></section>
  {featured && <section class="container"><div class="outcome" style="max-width:820px">
    <span class="chip tested">Featured replay</span>
    <h2 style="font-size:1.4rem">"The IT folder won't open."</h2>
    <p>{featured.data.summary} Step through five recorded checks.</p>
    <a class="btn" href={base + "incidents/dns-client-outage/"} style="width:fit-content">Follow the investigation <span aria-hidden="true">→</span></a>
  </div></section>}
  <section class="v4-section" style="border-top:0"><div class="container">
    <article class="outcome"><span class="chip tested">Unexpected deployment issue</span><h3>The same network, two different subnet masks.</h3><p>CR-008: two domain controllers had /32 prefixes; the file server used /24.</p><a href={base+"incidents/fileserver-subnet/"}>Read the investigation →</a></article><div class="tabs" role="group" aria-label="Filter investigations" id="filters">
      <button type="button" data-f="all" aria-pressed="true">All</button>
      <button type="button" data-f="failure" aria-pressed="false">Failure</button>
      <button type="button" data-f="recovery" aria-pressed="false">Recovery</button>
      <button type="button" data-f="deferred" aria-pressed="false">Deferred</button>
    </div>
    <div class="outcomes" id="case-grid">
      {cases.map(({ e, g }: {e: CollectionEntry<"incidents">; g: string}) => <article class="outcome" data-g={g}>
        <span class={"chip " + (g === "deferred" ? "deferred" : "tested")}>{labels[g]}</span>
        <h3>{e.data.title}</h3>
        <p>{e.data.summary}</p>
        <p class="result">{e.data.outcome}</p>
        <a href={base + "incidents/" + e.id + "/"}>{g === "deferred" ? "Read what was not tested" : "Read the investigation"}</a>
      </article>)}
    </div>
    <p class="muted" style="margin-top:28px">More investigations are in the <a href="https://github.com/EtiDavid/Nova-Corp/tree/main/docs/explore/incidents">public incident archive ↗</a>; they are not all rewritten as case studies yet.</p>
  </div></section>
  <script is:inline>
  (function () {
    var btns = [].slice.call(document.querySelectorAll("#filters button"));
    var cards = [].slice.call(document.querySelectorAll("#case-grid .outcome"));
    function apply(f) {
      btns.forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.f === f ? "true" : "false"); });
      cards.forEach(function (c) { c.hidden = !(f === "all" || c.dataset.g === f); });
    }
    btns.forEach(function (b) { b.addEventListener("click", function () { apply(b.dataset.f); }); });
    var t = new URLSearchParams(location.search).get("type");
    apply(["failure", "recovery", "deferred"].indexOf(t) >= 0 ? t : "all");
  })();
  </script>
</BaseLayout>
