---
import NovaLayout from "../../../layouts/NovaLayout.astro";
import "../../../styles/incident-records.css";
import "../../../styles/reference-library.css";
import IncidentOriginalRecord from "../../../components/IncidentOriginalRecord.astro";
import OriginalPdfEvidenceGallery from "../../../components/OriginalPdfEvidenceGallery.astro";
import { incidentDocuments, originalSourceURL, siteArticle } from "../../../data/incidentDocuments";
import Term from "../../../components/nova/Term.astro";
import MapSvg from "../../../components/nova/MapSvg.astro";
import { loadNova, typeLabel, segmentId } from "../../../lib/nova";
const base = import.meta.env.BASE_URL;
const slug = "dns-client-outage";
const nova = await loadNova();
const me = nova.incidents.find((i: any) => i.slug === slug);
const involved = me.systems.map(nova.stationById).filter(Boolean).filter((s: any) => s.id !== "nova-dc02");
const src = incidentDocuments[slug];
const journal = base + "journals/" + src.journal.split("/").at(-1)?.replace(/\.pdf$/i, "") + "/";
const journalGitHub = originalSourceURL(src.journal);
const recordGitHub = originalSourceURL(src.source);
const related = nova.relatedIncidents(slug);
// Commands, expectations and recorded results are copied from the public incident record INC-CR014-02.
const worked = [
  { q: "Is the share failing, and is name lookup failing too?", cmd: 'Test-Path "\\\\nova-files01\\IT"\nResolve-DnsName nova-files01.nova.corp',
    exp: "The share fails and the normal resolver times out.", act: "Test-Path returned False. Resolve-DnsName returned ERROR_TIMEOUT.", bad: true },
  { q: "Can I reach the server without DNS?", cmd: "Test-NetConnection 10.10.20.20 -Port 445",
    exp: "TCP 445 succeeds if the server and network are healthy.", act: "TcpTestSucceeded: True. The file server was not the problem.", bad: false },
  { q: "Does the company DNS server know the answer?", cmd: "Resolve-DnsName nova-files01.nova.corp -Server 10.10.20.10",
    exp: "An A record for 10.10.20.20.", act: "DC01 returned 10.10.20.20. DNS itself was fine.", bad: false },
  { q: "Which DNS server is the workstation really using?", cmd: "Get-DnsClientServerAddress -AddressFamily IPv4",
    exp: "10.10.20.10 and 10.10.20.11.", act: "The adapter was set to 192.0.2.53. That was the cause.", bad: true }
];
const proof = [
  { q: "Can clients find the domain controllers again?", cmd: 'Resolve-DnsName -Type SRV "_ldap._tcp.dc._msdcs.nova.corp"\nnltest /dsgetdc:nova.corp /force',
    exp: "Both domain controller SRV records, and a successful DC selection.", act: "DC01 and DC02 were advertised and nltest selected DC01.", bad: false },
  { q: "Does the original request work?", cmd: 'Test-Path "\\\\nova-files01\\IT"', exp: "True.", act: "True. ipconfig /all confirmed the restored DNS servers.", bad: false }
];
---
<NovaLayout title="The file server looked down. It was DNS." description="A workstation could not open the IT share by name. Port 445 on the file server worked; the workstation was asking the wrong DNS server. How I worked it out and proved the fix." current="incidents">
  <section class="incident-head"><div class="wrap">
    <p class="tiny"><a href={base + "incidents/"}>← All incidents</a></p>
    <h1 style="margin-top:10px">The file server looked down. It was DNS.</h1>
    <div class="meta">
      <span class={"type " + me.type}>{typeLabel[me.type]}</span>
      <span>{me.date}</span>
      <span>{involved.map((s: any) => <a class="chip" href={base + "systems/" + s.id + "/"}>{s.name}</a>)}</span>
      <a class="chip" href={base + "changes/" + me.cr + "/"}>{me.cr}</a>
    </div>
  </div></section>

  <div class="wrap">
    <section class="v20" aria-labelledby="h-20">
      <h2 id="h-20" style="grid-column:1/-1;font-size:1.05rem">The 20-second version</h2>
      <div><h3>What users saw</h3><p>{me.saw}</p></div>
      <div><h3>What was actually wrong</h3><p>{me.cause}</p></div>
      <div><h3>What fixed it</h3><p>{me.fix}</p></div>
      <div><h3>How I proved it</h3><p>{me.proof}</p></div>
    </section>

    <div class="inc-grid">
      <aside class="inc-map" aria-label="Where it broke">
        <div class="map-card">
          <MapSvg id="nl-inc" broken={segmentId(me.segment.line, me.segment.from, me.segment.to)} emphasise={["nova-client", "nova-dc01", "nova-files01"]} linesOn={["identity", "files"]} viewBox="20 95 700 380" mini
            label="Line map cropped to the workstation, DC01 and the file server. The identity line between the workstation and DC01 is drawn broken in red." />
          <p class="caption" id="map-caption"><b style="color:var(--broken-text)">Red dashed:</b> the DNS lookup path from the workstation. The file path to FILES01 (green) never broke.</p>
        </div>
      </aside>
      <div class="inc-main">
        <h2 style="margin-top:28px">How I worked it out</h2>
        <ol class="steps">
          {worked.map(st => (
            <li class="step"><h3>{st.q}</h3><pre>{st.cmd}</pre><p class="exp">Expected: {st.exp}</p><p class={"act" + (st.bad ? " bad" : "")}>Actual: {st.act}</p></li>
          ))}
        </ol>

        <h2 id="fix" style="margin-top:36px">The fix, and how I proved it</h2>
        <p style="margin-top:8px"><b>What I changed:</b> I restored the client's <Term id="dns">DNS</Term> servers to <code>10.10.20.10</code> and <code>10.10.20.11</code> and cleared the resolver cache.</p>
        <ol class="steps">
          {proof.map(st => (
            <li class="step"><h3>{st.q}</h3><pre>{st.cmd}</pre><p class="exp">Expected: {st.exp}</p><p class="act">Actual: {st.act}</p></li>
          ))}
        </ol>

        <h2 style="margin-top:36px">What this doesn't prove</h2>
        <p class="boxnote" style="margin-top:10px">The wrong <Term id="dns">DNS</Term> server was set on purpose for this exercise, and the cause was hidden from me while I diagnosed it, so this shows my method rather than a production outage. The results above are the journal's recorded summaries, not raw terminal output, and the exact test date is not yet reconciled.</p>

        <h2 style="margin-top:36px">Evidence</h2>
        <div class="incident-sidebar-journal" style="margin-top:8px">
          <p><a class="nv-link" href={journal}>Full journal (CR-014), all pages on this site →</a></p>
          <p class="tiny"><a href="#full-investigation">↓ Every recorded step</a> · <a class="incident-master-link" href={journalGitHub} target="_blank" rel="noopener noreferrer">Original PDF on GitHub ↗</a> · <a href={recordGitHub} target="_blank" rel="noopener noreferrer">Original incident record ↗</a></p>
        </div>
        <OriginalPdfEvidenceGallery subject={"incidents/" + slug} heading="Original recorded results from the journal" />
        <details class="orig-record" open style="margin-top:16px"><summary><b>The complete original investigation</b> (every recorded step)</summary><IncidentOriginalRecord slug={slug} /></details>

        <h2 style="margin-top:36px">Related</h2>
        <div class="related">{related.map((r: any) => <a class="chip" href={base + "incidents/" + r.slug + "/"}>{r.title}</a>)}</div>
      </div>
    </div>
  </div>
  <script is:inline>
  (function () {
    var seg = document.querySelector('#nl-inc [data-seg="identity:client-dc01"]'), fix = document.getElementById("fix"), cap = document.getElementById("map-caption");
    if (!seg || !fix || !("IntersectionObserver" in window)) return;
    new IntersectionObserver(function (e) {
      var passed = e[0].isIntersecting || e[0].boundingClientRect.top < 0;
      seg.classList.toggle("broken", !passed);
      cap.innerHTML = passed ? "<b style=\"color:var(--ok)\">Repaired:</b> the workstation asks the domain controllers again, and the share opens." : "<b style=\"color:var(--broken-text)\">Red dashed:</b> the DNS lookup path from the workstation. The file path to FILES01 (green) never broke.";
    }, { threshold: 0.1 }).observe(fix);
  })();
  </script>
</NovaLayout>
