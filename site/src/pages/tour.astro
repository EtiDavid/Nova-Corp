---
import BaseLayout from "../layouts/BaseLayout.astro";
const base=import.meta.env.BASE_URL;
const recruiter=[{title:"Keeping employees working",copy:"I deliberately stopped a domain controller and verified that staff could still sign in and open their permitted files.",link:"incidents/dc01-outage/",label:"See the resilience test"},{title:"Recovering important documents",copy:"I restored a deleted document and confirmed that its contents matched the original.",link:"incidents/backup-target-unavailable/",label:"See the recovery test"},{title:"Protecting management access",copy:"I found a firewall access weakness, corrected the rules and checked that employees could still use their business services.",link:"incidents/firewall-management-exposure/",label:"See the security investigation"}];
const steps=[
  {title:"Meet the company",copy:"Nova Corp is fictional, but its servers, network and controlled experiments are built and documented in a real home lab.",link:"company/",label:"Open the interactive map"},
  {title:"Keep the network organized",copy:"A firewall separates the workstation, infrastructure and management network areas. Its rules were reviewed and tested for specific flows.",link:"company/?view=network",label:"See the network view"},
  {title:"Help employees sign in",copy:"Two Domain Controllers handle directory and DNS services. A controlled outage tested whether the second could keep work moving.",link:"systems/nova-dc01/",label:"Meet the identity server"},
  {title:"Set rules for company computers",copy:"Central Group Policy can configure security settings and user experience. A linked GPO is different from a client actually processing it.",link:"policies/",label:"Explore Group Policy"},
  {title:"Protect company documents",copy:"The shared file server uses identity groups plus share and folder permissions, so not everyone can open everything.",link:"systems/nova-files01/",label:"Visit the file server"},
  {title:"Recover when something breaks",copy:"A deleted file was restored from Windows Backup. An earlier file version was independently recovered from Shadow Copy.",link:"company/?view=recovery",label:"See the recovery view"},
  {title:"Investigate when something fails",copy:"A shared folder problem might be DNS, a server outage or permissions. Follow the tests, repair and what was actually observed.",link:"incidents/",label:"Read the investigations"},
  {title:"See the engineering evidence",copy:"Every story is attached to dated records, exact results and limitations. A configured backup is not automatically a proven restore.",link:"sources/",label:"View original evidence"}
];
---
<BaseLayout title="Guided company tour" description="A short, plain-English introduction to Nova Corp and its documented infrastructure." breadcrumbs={[{label:"Guided tour"}]}>
  <section class="page-head"><div class="container"><div class="eyebrow">Guided introduction</div><h1>From your first login to a recovered file.</h1><p class="lead" style="margin-top:16px">Choose a short hiring overview or the eight-stop technical walkthrough. Nova Corp is a real home lab, not a production employer network.</p></div></section>
  <section class="section compact"><div class="container grid-main">
    <div>{[["recruiter","Two-minute recruiter overview",recruiter],["technical","Technical walkthrough",steps]].map(([id,title,items])=><section class="content-section" id={String(id)}><h2>{title}</h2><div class="walkthrough">{(items as typeof steps).map((step,i)=><div class="walk-step" id={id+"-"+(i+1)}><small>Step {i+1} of {(items as typeof steps).length}</small><h3>{step.title}</h3><p style="margin:10px 0 15px">{step.copy}</p><a class="text-link" href={base+step.link}>{step.label} →</a><div class="tour-nav">{i>0&&<a href={"#"+id+"-"+i}>← Previous</a>}{i+1<(items as typeof steps).length?<a href={"#"+id+"-"+(i+2)}>Next →</a>:<a href={base+"about/"}>About &amp; contact →</a>}</div></div>)}</div></section>)}<a class="btn" href={base+"David_Eti_Systems_Infrastructure_CV.pdf"}>Download CV</a></div>
    <aside class="sidebox"><h3>Tour guide</h3><p><a href="#recruiter">Recruiter overview</a></p><p><a href="#technical">Technical walkthrough</a></p><p class="muted">Every stop links to the system, recorded test and source.</p><a class="evidence-link" href={base+"company/"}>Prefer exploring freely? →</a></aside>
  </div></section>
</BaseLayout>

<style>.walk-step{scroll-margin-top:100px}.tour-nav{display:flex;flex-wrap:wrap;gap:18px;margin-top:16px}.walk-step small{color:#dfc291}</style>