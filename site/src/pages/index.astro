---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchitectureSvg from "../components/ArchitectureSvg.astro";
const base = import.meta.env.BASE_URL;
const cv = base + "David_Eti_Systems_Infrastructure_CV.pdf";
---
<BaseLayout title="Home" description="An enterprise infrastructure lab you can explore. Built and tested by David Eti: Windows Server, Active Directory, pfSense, recovery and real troubleshooting.">
  <section class="v4-hero"><div class="container v4-hero-grid">
    <div>
      <div class="byline">Built and tested by David Eti</div>
      <h1>I built a small company's IT infrastructure — then tested what happens when it fails.</h1>
      <p class="lead">Explore the real Windows, networking, security and recovery work behind my Nova Corp home lab. Choose a system, follow a request, or replay a troubleshooting investigation.</p>
      <div class="button-row" style="margin-top:26px">
        <a class="btn" href={base + "company/"}>Explore the infrastructure <span aria-hidden="true">→</span></a>
        <a class="btn ghost" href={base + "incidents/"}>See what I fixed</a>
      </div>
      <div class="contact-row">
        <span class="who">David Eti · Seeking system administrator, infrastructure and DevOps roles in Belgium and the Netherlands</span>
      </div>
      <div class="contact-row" style="margin-top:10px">
        <a class="btn ghost small" href={cv}>Download CV</a>
        <a class="btn ghost small" href="mailto:etidavid26@gmail.com">Email</a>
        <a class="btn ghost small" href="https://www.linkedin.com/in/eti-david">LinkedIn ↗</a>
      </div>
      <p class="truth">Nova Corp is fictional; the infrastructure and recorded tests are from my real home lab. This is a documented snapshot, not a live console.</p>
    </div>
    <figure class="figure-card">
      <ArchitectureSvg />
      <figcaption>Original illustration of the documented architecture.</figcaption>
    </figure>
  </div></section>

  <section class="v4-section" aria-labelledby="proved"><div class="container">
    <div class="byline">Three things I proved</div>
    <h2 id="proved">Tested failures, with the evidence.</h2>
    <div class="outcomes">
      <article class="outcome">
        <span class="chip tested">Tested</span>
        <h3>Sign-ins survive a Domain Controller outage</h3>
        <p class="q">Can employees still work if DC01 goes offline?</p>
        <p class="result">I took DC01 offline in a controlled test; the workstation kept working through DC02 and replication was checked when DC01 returned.</p>
        <a href={base + "incidents/dc01-outage/"}>Read the investigation</a>
      </article>
      <article class="outcome">
        <span class="chip tested">Tested</span>
        <h3>A deleted file came back, byte for byte</h3>
        <p class="q">Can a lost document be recovered after backup trouble?</p>
        <p class="result">After a deliberate backup failure and repair, a deleted file was restored with the same SHA-256 hash as the original.</p>
        <a href={base + "incidents/backup-target-unavailable/"}>Read the investigation</a>
      </article>
      <article class="outcome">
        <span class="chip tested">Tested</span>
        <h3>An employee PC blocked from firewall admin</h3>
        <p class="q">Why could a workstation open the firewall console?</p>
        <p class="result">I placed specific block rules ahead of a broad allow; the management path was blocked and business access kept working.</p>
        <a href={base + "incidents/firewall-management-exposure/"}>Read the investigation</a>
      </article>
    </div>
  </div></section>

  <section class="v4-section" aria-labelledby="works"><div class="container split">
    <div>
      <div class="byline">How the company works</div>
      <h2 id="works">A workstation, a firewall, two identity servers and a file server.</h2>
      <p class="lead">Signing in and opening a shared folder are two separate paths: one asks the Domain Controllers for DNS and identity, the other connects to the file server. Select any system on the interactive map to see what it does and the evidence behind it.</p>
      <p style="margin-top:20px"><a class="btn" href={base + "company/"}>Open the interactive map <span aria-hidden="true">→</span></a></p>
    </div>
    <figure class="figure-card"><ArchitectureSvg /><figcaption>Everything runs on one Proxmox host, nested in VMware Workstation.</figcaption></figure>
  </div></section>

  <section class="v4-section" aria-labelledby="featured"><div class="container">
    <div class="byline">Featured investigation</div>
    <h2 id="featured">"The IT folder won't open."</h2>
    <blockquote class="ticket-quote">The file server looked down. It wasn't — a lookup by name timed out, while a direct connection to the server on port 445 succeeded.</blockquote>
    <p class="lead">Testing DNS separately from network reachability showed the workstation was asking the wrong resolver, which avoided a needless server rebuild.</p>
    <p style="margin-top:20px"><a class="btn" href={base + "incidents/dns-client-outage/"}>Follow the investigation <span aria-hidden="true">→</span></a></p>
  </div></section>

  <section class="v4-section" aria-labelledby="builder"><div class="container split">
    <div>
      <div class="byline">The engineer</div>
      <h2 id="builder">I learn infrastructure by building it and breaking it.</h2>
      <p class="lead">I designed, built, tested and documented every part of this lab myself. <a href={base + "about/"}>About me</a> · <a href="https://github.com/EtiDavid/Nova-Corp">Source on GitHub ↗</a></p>
    </div>
    <div class="outcome">
      <span class="chip planned">Planned</span>
      <h3>Next planned hardening</h3>
      <p>A privileged administrative VPN and tighter management-plane firewall controls (CR-016). Planned; not started.</p>
      <a href={base + "roadmap/"}>See the roadmap</a>
    </div>
  </div></section>
</BaseLayout>
