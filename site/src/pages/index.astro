---
import BaseLayout from "../layouts/BaseLayout.astro";
import ScrollableLabSandbox from "../components/ScrollableLabSandbox.astro";
import LabIncidentLibrary from "../components/LabIncidentLibrary.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Home" description="Explore the enterprise infrastructure David Eti built, validated and deliberately tested through real troubleshooting investigations.">
  <section class="exp-hero atlas-home" aria-labelledby="exp-headline">
    <div class="container atlas-intro" data-reveal>
      <div class="atlas-intro-top">
        <span class="exp-eyebrow">Nova Corp / A real infrastructure home lab</span>
        <span class="atlas-portfolio-mark">BUILT · BROKEN · RECOVERED</span>
      </div>
      <div class="atlas-intro-layout">
        <div>
          <h1 id="exp-headline">I built the infrastructure. <em>Then I tested what happens when it fails.</em></h1>
          <p class="exp-subtitle">Explore how I built an enterprise-style environment inside a single physical host — from nested virtualization to networking, Active Directory and tested recovery.</p>
        </div>
        <div class="atlas-intro-aside">
          <div class="button-row" aria-label="Start exploring the Nova Corp lab">
            <a class="btn" href="#hx-explorer">Explore the infrastructure <span aria-hidden="true">↘</span></a>
            <a class="btn ghost" href={base+"tour/"}>Take the guided tour <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </div>
    <div class="atlas-wide">
      <ScrollableLabSandbox />
    </div>
  </section>

  <LabIncidentLibrary />
</BaseLayout>
