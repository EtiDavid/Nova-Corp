---
import AccountGroups from "../../../components/nova/xf/AccountGroups.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { organizationalUnits, identities, type Ou, directorySource } from "../../../data/directory";
import { companyPolicies } from "../../../data/policies";
import { computersForOu } from "../../../data/computers";
const base=import.meta.env.BASE_URL;
export function getStaticPaths(){return organizationalUnits.map(ou=>({params:{slug:ou.slug},props:{ou}}));}
interface Props{ou:Ou}
const {ou}=Astro.props;
const parent=organizationalUnits.find(p=>p.slug===ou.parent);
const children=organizationalUnits.filter(p=>p.parent===ou.slug);
const direct=identities.filter(u=>u.ou===ou.slug);
const controllers=ou.slug==="domain-controllers";
const workstations=ou.slug==="workstations";
const servers=ou.slug==="servers";
const directPolicies=companyPolicies.filter(p=>p.link?.ouSlug===ou.slug);
const parentPolicies=companyPolicies.filter(p=>p.link?.ouSlug===ou.parent);
const domainPolicy=companyPolicies.find(p=>p.slug==="domain-password");
const computerEntries=computersForOu(ou.slug);
---
<BaseLayout title={ou.name+" · Organizational Unit"} description={"Open the documented "+ou.name+" Active Directory organizational unit and its connected identities and systems."} breadcrumbs={[{label:"Directory",href:"directory/"},{label:ou.name}]}>
<section class="page-head"><div class="container">
<div class="eyebrow">Active Directory / Organizational Unit</div>
<h1>{ou.name}</h1><p class="lead" style="margin-top:17px">{ou.meaning}</p>
</div></section>
<section class="section compact"><div class="container"><AccountGroups /></div></section>
<section class="section compact"><div class="container grid-main"><div>
  {parent && <div class="note" style="margin-bottom:24px">This OU is inside <a href={base+"directory/ous/"+parent.slug+"/"}>{parent.name}</a>. Parent location is part of the directory hierarchy, not automatic membership in a resource group.</div>}
  <section class="content-section"><h2>Why does Nova Corp use this OU?</h2><p>{ou.meaning} Organizational Units keep the directory organized and can be used as policy targets. They do not grant departmental file permissions by themselves.</p><p><a href={base+"directory/"}>nova.corp</a> → {parent&&<><a href={base+"directory/ous/"+parent.slug+"/"}>{parent.name}</a> → </>}<strong>{ou.name}</strong></p></section>
  <section class="content-section">
    <h2>What is stored in this OU?</h2>
    {children.length>0 && <div class="card-list" style="margin-top:18px">{children.map(child=><a class="system-card" href={base+"directory/ous/"+child.slug+"/"}><small>Child Organizational Unit</small><h3>{child.name}</h3><p>{child.meaning}</p><span class="readmore">Open OU →</span></a>)}</div>}
    {direct.length>0 && <div class="card-list" style="margin-top:18px">{direct.map(u=><a class="system-card" href={base+"people/"+u.slug+"/"}><small>{u.category.replace("-"," ")} · {u.enabled?"Enabled":"Disabled"}</small><h3>{u.name}</h3><p>Lab directory sign-in: <code>{u.logon}</code></p><span class="readmore">Open identity →</span></a>)}</div>}
    {computerEntries.length>0&&<div class="card-list" style="margin-top:18px">{computerEntries.map(computer=><a class="system-card" href={base+"computers/"+computer.slug+"/"}><small>Domain computer object</small><h3>{computer.name}</h3><p>{computer.purpose}</p><span class="readmore">Open registered computer →</span></a>)}</div>}


    {ou.slug==="security-groups" && <a class="system-card" style="margin-top:18px" href={base+"groups/"}><small>Group catalog</small><h3>Company access groups</h3><p>Browse Global department membership and Domain Local resource-permission groups.</p><span class="readmore">Open the groups →</span></a>}
    {ou.slug==="contractors" && <div class="note warning" style="margin-top:18px">A removable-storage Group Policy is linked to this OU. Its complete physical-device enforcement was not tested end to end in the nested lab. <a href="https://github.com/EtiDavid/Nova-Corp/blob/main/docs/explore/policies/CONTRACTOR_USB.md">See source ↗</a></div>}
    {direct.length===0&&children.length===0&&!controllers&&!workstations&&!servers&&ou.slug!=="security-groups" && <div class="note" style="margin-top:18px">The snapshot lists no users or child OUs here.</div>}
  </section>
  <section class="content-section">
    <h2>Which Group Policies are connected here?</h2>
    <p class="muted" style="margin:12px 0 19px">This shows <strong>configured OU links</strong> and possible inherited parent/domain scope—not a verified list of policies that actually reached the account or computer.</p>
    {directPolicies.length>0&&<div class="card-list">{directPolicies.map(policy=><a class="system-card" href={base+"policies/"+policy.slug+"/"}><small>Linked directly to this OU · Enabled, not enforced</small><h3>{policy.name}</h3><p>{policy.summary}</p><span class="readmore">Read settings and tests →</span></a>)}</div>}
    {parentPolicies.length>0&&<div class="paper panel" style="margin-top:17px"><h3>Possible inherited policies from the parent OU</h3><p class="muted" style="margin:10px 0 14px">These links are attached to {parent?.name}. Actual processing depends on inheritance, security filters and client results.</p><ul class="plain-list">{parentPolicies.map(policy=><li><a href={base+"policies/"+policy.slug+"/"}>{policy.name}</a></li>)}</ul></div>}
    {domainPolicy&&<div class="note" style="margin-top:18px">The <a href={base+"policies/domain-password/"}>Default Domain Policy</a> is linked to the domain root, which can be in scope across company OUs. Link inheritance is not an independent effective-password-policy test for an individual account.</div>}
    <a class="evidence-link" style="margin-top:16px;display:inline-flex" href={base+"policies/"}>Browse all seven company policies →</a>
  </section>
  <section class="content-section"><h2>How this connects to access</h2><p class="muted" style="margin-top:14px">An OU says where an account lives and which policies could reach it. File access comes from group membership and permissions, never from the OU alone.</p><div class="button-row" style="margin-top:17px"><a class="btn ghost small" href={base+"groups/"}>Browse group membership →</a><a class="btn ghost small" href={base+"files/permissions/"}>Inspect file permissions</a></div></section>
<section class="content-section"><details><summary>Technical checks</summary><p><strong>Where:</strong> Domain controller or management PC with Active Directory tools.</p><pre><code>{"Get-ADOrganizationalUnit -Filter \"Name -eq "+String.fromCharCode(39)+ou.name+String.fromCharCode(39)+"\" | Select-Object Name,DistinguishedName"}</code></pre><p><strong>Expected:</strong> the named OU is returned in the documented parent location. Compare distinguished names if more than one object shares the name.</p></details></section><section class="content-section"><h2>Engineering journals</h2><p><a href={base+"reference/explore/DIRECTORY_SNAPSHOT_2026-11-22/"}>Original directory inventory →</a></p><p><a href={base+"journals/change_request_cr005/"}>Directory setup journal →</a></p></section>
</div>
<aside>
 <div class="sidebox"><h3>Where is it?</h3><p class="muted">Directory: <strong>nova.corp</strong></p><p class="muted" style="margin-top:8px">Parent: {parent?parent.name:"Domain root"}</p><p class="muted" style="margin-top:8px">Documented direct users: {direct.length}</p></div>
 <div class="sidebox"><h3>Source</h3><p class="muted">These come from the directory snapshot. The technical record has the object-level detail.</p><a class="evidence-link" href={base+"reference/explore/DIRECTORY_SNAPSHOT_2026-11-22/"}>Read the original directory record →</a></div>
 <div class="sidebox"><a href={base+"directory/"}>← All Organizational Units</a><p style="margin-top:12px"><a href={base+"map/"}>Company map →</a></p></div>
</aside></div></section>
</BaseLayout>
