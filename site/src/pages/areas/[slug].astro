---
import LegacyRedirect from "../../components/LegacyRedirect.astro";
import { areas } from "../../data/areas";
export function getStaticPaths() {
  const dest: Record<string, [string, string]> = {
    "control-room": ["company/?view=overview", "Explore: systems"],
    "identity-office": ["company/?view=identity", "Explore: identity"],
    "department-offices": ["company/?view=identity", "Explore: identity and access"],
    "network-gatehouse": ["company/?view=network", "Explore: network"],
    "file-records": ["company/?view=files", "Explore: files"],
    "recovery-centre": ["company/?view=recovery", "Explore: recovery"],
    "incident-lab": ["incidents/", "Investigations"],
    "roadmap-wing": ["roadmap/", "Roadmap"]
  };
  return areas.map(a => ({ params: { slug: a.id }, props: { to: (dest[a.id] ?? ["company/", "Explore"])[0], label: (dest[a.id] ?? ["company/", "Explore"])[1] } }));
}
const { to, label } = Astro.props;
---
<LegacyRedirect to={to} label={label} />
