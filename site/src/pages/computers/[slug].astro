---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { computerObjects, type ComputerObject, computerSource } from "../../data/computers";
import { findOu } from "../../data/directory";
import { getPolicy } from "../../data/policies";
export function getStaticPaths(){return computerObjects.map(computer=>({params:{slug:computer.slug},props:{computer}}));}
interface Props {computer:ComputerObject}
const {computer}=Astro.props;
const base=import.meta.env.BASE_URL;
const ou=findOu(computer.ouSlug);
const policy=computer.linkedPolicySlug?getPolicy(computer.linkedPolicySlug):undefined;
---
<BaseLayout title={computer.name+" · Directory computer"} description={computer.purpose} breadcrumbs={[{label:"Directory",href:"directory/"},{label:"Computers",href:"computers/"},{label:computer.name}]}>
<section class="page-head"><div class="container">
<div class="eyebrow">Active Directory / Computer object</div>
<h1>{computer.name}</h1><p class="lead" style="margin-top:17px">{computer.purpose}</p>
</div></section>
<section class="section compact"><div class="container grid-main"><div>
 <section class="content-section">
  <h2>A computer identity is different from a virtual machine.</h2>
  <div class="paper panel" style="margin-top:18px">
   <p class="muted">This Active Directory computer object is registered in <a href={base+"directory/ous/"+computer.ouSlug+"/"}>{ou?.name}</a>. The corresponding <a href={base+"systems/"+computer.systemSlug+"/"}>system profile</a> explains the VM/service layer.</p>
   <div class="button-row" style="margin-top:21px"><a class="btn small" href={base+"systems/"+computer.systemSlug+"/"}>Open the system profile →</a><a class="btn ghost small" href={base+"directory/ous/"+computer.ouSlug+"/"}>Open its OU</a></div>
  </div>
 </section>
 <section class="content-section">
  <h2>What does this computer help operate?</h2>
  <ul class="plain-list">{computer.roles.map(role=><li>{role}</li>)}</ul>
 </section>
 <section class="content-section">
  <h2>What about Group Policy?</h2>
  {policy?<div class="paper panel">
    <h3>{policy.name}</h3>
    <p class="muted" style="margin:11px 0 17px">The documented enabled, non-enforced link is attached to the <strong>{ou?.name}</strong> OU. This describes the saved policy target, not proof of client effective results.</p>
    <a class="btn small" href={base+"policies/"+policy.slug+"/"}>Inspect the configuration and evidence →</a>
  </div>:<div class="note">No additional computer-specific OU-linked GPO is claimed from the reviewed seven-object policy inventory for this member-server area. <a href={base+"policies/"}>Explore all Group Policies</a> to distinguish domain links from OU links.</div>}
  <p class="muted" style="margin-top:16px">The <a href={base+"policies/domain-password/"}>default domain policy</a> is linked at domain root. Link scope is not a fresh effective setting test on this computer.</p>
 </section>
 <section class="content-section"><details><summary>Technical checks</summary><p><strong>Where:</strong> Domain controller or management PC with Active Directory tools.</p><pre><code>{"Get-ADComputer -Identity \""+computer.name+"\" -Properties Enabled | Select-Object Name,Enabled,DistinguishedName"}</code></pre><p><strong>Expected:</strong> The registered computer appears in {ou?.name}. This proves directory placement, not current VM health.</p></details></section>
 <section class="content-section">
  <h2>Engineering journals</h2><p><a href={base+"reference/explore/DIRECTORY_SNAPSHOT_2026-11-22/"}>Original directory inventory →</a></p><div class="paper panel">
  <p class="muted">The source verifies the directory computer object's placement. VM configuration, actual services, failover, test output and physical-host dependencies are distinct evidence found on the technical system and original journals.</p>
  <a class="evidence-link" href={computerSource}>Read the Active Directory computer inventory ↗</a>
  </div>
 </section>
</div><aside>
  <div class="sidebox"><h3>Directory computer profile</h3><dl class="fact-list">
    <div><dt>Domain</dt><dd>nova.corp</dd></div>
    <div><dt>OU</dt><dd><a href={base+"directory/ous/"+computer.ouSlug+"/"}>{ou?.name}</a></dd></div>
    <div><dt>Separate VM profile</dt><dd><a href={base+"systems/"+computer.systemSlug+"/"}>{computer.name}</a></dd></div>
  </dl></div>
  <div class="sidebox"><a href={base+"computers/"}>← All computer objects</a><p style="margin-top:14px"><a href={base+"directory/"}>Directory →</a></p></div>
</aside></div></section>
</BaseLayout>
