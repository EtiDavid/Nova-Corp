---
import BaseLayout from "../layouts/BaseLayout.astro";
import { systems } from "../data/model";
import { areas } from "../data/areas";
import { shares } from "../data/fileCentre";
import { identities, organizationalUnits } from "../data/directory";
import { accessGroups } from "../data/groups";
import { zones, rules, aliases } from "../data/network";
import { companyPolicies } from "../data/policies";

const base=import.meta.env.BASE_URL;
const index=[
...techTerms.map(term=>({name:term.word,kind:"Technical explanation with full original source",description:term.brief,url:base+"learn/"+term.slug+"/"})),
...originalDocs.map(doc=>({name:doc.data.title,kind:"Original engineering Markdown",description:doc.data.sourcePath,url:base+"reference/"+doc.id+"/"})),
...areas.map(item=>({name:item.name,kind:"Company area",description:item.description,url:base+"company/"})),
...systems.map(item=>({name:item.name,kind:item.category,description:item.summary,url:base+"systems/"+item.slug+"/"})),
...shares.map(item=>({name:item.name+" department share",kind:"Shared folder",description:item.purpose,url:base+"files/shares/"+item.id+"/"})),
...organizationalUnits.map(item=>({name:item.name,kind:"Organizational Unit",description:item.meaning,url:base+"directory/ous/"+item.slug+"/"})),
...identities.map(item=>({name:item.name,kind:item.category.replace("-"," ")+" directory account",description:item.location+" · "+item.logon,url:base+"people/"+item.slug+"/"})),
...accessGroups.map(item=>({name:item.name,kind:item.kind,description:item.description,url:base+"groups/"+item.slug+"/"})),
...zones.map(item=>({name:item.name+" network",kind:item.kind,description:item.purpose,url:base+"network/zones/"+item.slug+"/"})),
...rules.map(item=>({name:item.description,kind:item.action+" firewall rule",description:item.zone.toUpperCase()+" · "+item.protocol+" · "+item.destination,url:base+"network/rules/"+item.id+"/"})),
...aliases.map(item=>({name:item.name,kind:item.kind+" alias",description:item.description,url:base+"network/aliases/"+item.slug+"/"})),
...companyPolicies.map(item=>({name:item.name,kind:"Group Policy",description:item.summary+" "+item.technicalName,url:base+"policies/"+item.slug+"/"})),
{name:"Backup disk disappears",kind:"Investigated incident",description:"A real file restore after a deliberately unavailable backup target.",url:base+"incidents/backup-target-unavailable/"},
{name:"Identity server goes offline",kind:"Investigated incident",description:"A controlled outage tested directory resilience.",url:base+"incidents/dc01-outage/"},
{name:"Exact SMB and NTFS access-control entries",kind:"Permission explorer",description:"Search 100 recorded SMB and NTFS access entries across company shares and selected folders.",url:base+"files/permissions/technical/"},
{name:"Incident investigations",kind:"Investigations",description:"Follow real controlled failure diagnoses and repairs.",url:base+"incidents/"},
{name:"Recovery options",kind:"Recovery guide",description:"What has been tested and what remains configured-only.",url:base+"recovery/"}
];
---
<BaseLayout title="Search Nova Corp" description="Find a company area, OU, directory account, group, shared folder, server or recovery test." breadcrumbs={[{label:"Search"}]}>
<section class="page-head"><div class="container"><div class="eyebrow">Find your way</div><h1>Search the company atlas.</h1><p class="lead" style="margin-top:15px">Look up a system, person, group, technical term or any of the 161 original engineering Markdown documents. Search for “Active Directory”, “CR-013”, “backup”, “Finance”, or “permissions”. All entries are still linked below if JavaScript is unavailable.</p></div></section>
<section class="section compact"><div class="container">
  <label for="atlas-search" style="font-weight:750">Search every published engineering document and company area</label>
  <div class="searchbox"><span aria-hidden="true">⌕</span><input data-search id="atlas-search" type="search" autocomplete="off" placeholder="Try Domain Controller, backup, file server..." /></div>
  <p class="search-count" role="status" aria-live="polite" data-count>{index.length} entries</p>
  <div class="card-list" data-results>
  {index.map(item=><a class="system-card" data-search-item data-search-text={(item.name+" "+item.kind+" "+item.description).toLowerCase()} href={item.url}><small>{item.kind}</small><h3>{item.name}</h3><p>{item.description}</p><span class="readmore">Open →</span></a>)}
  </div>
  <p data-empty class="empty" hidden>No matches. Try a broader term or open the <a href={base+"company/"}>company map</a>.</p>
</div></section>
<script>
const input = document.querySelector<HTMLInputElement>("[data-search]");
const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-search-item]"));
const count = document.querySelector<HTMLElement>("[data-count]");
const empty = document.querySelector<HTMLElement>("[data-empty]");
input?.addEventListener("input", () => {
  const query = input.value.toLowerCase().trim();
  let visible = 0;
  for (const card of cards) {
    const match = (card.dataset.searchText || "").includes(query);
    card.hidden = !match;
    if (match) visible++;
  }
  if (count) count.textContent = visible + (visible===1 ? " entry" : " entries");
  if (empty) empty.hidden = visible !== 0;
});
</script>
</BaseLayout>
