---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { identities, organizationalUnits, type DirectoryIdentity } from "../../data/directory";
import { findGroupByName, groupResources } from "../../data/groups";
import { companyPolicies } from "../../data/policies";
export function getStaticPaths(){return identities.map(person=>({params:{slug:person.slug},props:{person}}));}
interface Props{person:DirectoryIdentity}
const {person}=Astro.props;
const base=import.meta.env.BASE_URL;
const ou=organizationalUnits.find(x=>x.slug===person.ou);
const groupTargets=person.directGroups.map(name=>findGroupByName(name)).filter(Boolean);
const descriptions:Record<string,string>={"administrator":"Built-in privileged domain administration account.","guest":"Built-in Guest account, disabled in the recorded directory.","krbtgt":"Built-in Kerberos ticket service identity. Its disabled interactive-account status is normal.","test-user":"Enabled test account in the default Users container.","john-shaw":"Contractor account used to test Group Policy targeting.","alice-finance":"Finance account created during PowerShell bulk onboarding.","finance-test":"Finance test account used for authorization and lockout scenarios.","henry-hr":"HR account created during bulk user onboarding tests.","hr-test":"Test account retained in the HR department.","isaac-it":"IT account created for PowerShell user administration exercises.","david-it":"IT department account used during the original directory exercise.","moyo":"IT account used to test actual access to company documents.","maria-manager":"Management account created during bulk onboarding and group membership exercises.","management-test":"Management test account used for resource authorization analysis, including Finance Full Control.","gui-pilot":"Test account kept disabled after administration exercises.","sarah-sales":"Sales account disabled and moved to Nova Disabled Objects during offboarding; no longer in Sales_Users.","svc-backup":"Service identity created for backup-related operations; actual process use is not established.","svc-fileserver":"Service identity created for file-server operations; actual service logon is not established.","svc-monitoring":"Service identity created for monitoring work; centralized monitoring was not deployed in Phase 2.","sales-test":"Enabled Sales test account, distinct from disabled Sarah Sales."};
const sourcePaths:Record<string,string>={"finance-test":"accounts/fin-test","management-test":"accounts/mgmt-test","david-it":"DAVID","moyo":"MOYO","john-shaw":"JOHN_SHAW","alice-finance":"accounts/cr011-fin","henry-hr":"accounts/cr011-hr","isaac-it":"accounts/cr011-it","maria-manager":"accounts/cr011-mgmt","gui-pilot":"accounts/cr011-gui","sarah-sales":"accounts/cr011-sales"};
const sourcePath=sourcePaths[person.slug]??"accounts/"+person.slug;
const nested=person.directGroups.flatMap(name=>groupResources(name));
const builtIn:Record<string,string[]>={administrator:["Administrators","Domain Admins","Enterprise Admins","Schema Admins","Group Policy Creator Owners"],guest:["Guests"]};
const isExample=person.slug==="moyo";
const isManager=person.slug==="maria-manager";
const directlyLinked=companyPolicies.filter(p=>p.link?.ouSlug===person.ou);
const fromParent=companyPolicies.filter(p=>p.link?.ouSlug===ou?.parent);
const likelyPolicies=[...directlyLinked,...fromParent];
const label=person.category==="service"?"Service identity":person.category==="built-in"?"Built-in directory identity":person.category==="test"?"Lab test identity":"Fictional company lab identity";
---
<BaseLayout title={person.name} description={person.name+" is a recorded "+label.toLowerCase()+" in the Nova Corp Active Directory exercise."} breadcrumbs={[{label:"Directory",href:"directory/"},{label:person.name}]}>
<section class="page-head"><div class="container">
<div class="eyebrow">{label}</div>
<h1>{person.name}</h1><p class="lead" style="margin-top:17px">{descriptions[person.slug]}</p>

</div></section>
<section class="section compact"><div class="container grid-main account-page"><div>
  <section class="content-section">
   <h2>Active Directory profile</h2>
   <div class="paper panel" style="margin-top:20px">
     <dl class="fact-list account-details">
       <div><dt>Display name</dt><dd>{person.name}</dd></div><div><dt>Domain</dt><dd>nova.corp</dd></div><div><dt>AD username (sAMAccountName)</dt><dd><code>{person.logon}</code></dd></div>
       <div><dt>Organizational Unit / container</dt><dd>{ou?<a href={base+"directory/ous/"+ou.slug+"/"}>{person.location}</a>:person.location}</dd></div>
       <div><dt>Account type</dt><dd>{label}</dd></div>
       <div><dt>Account enabled</dt><dd>{person.enabled?"Yes":"No"}</dd></div>
     <div><dt>Direct security groups</dt><dd>{person.directGroups.length?person.directGroups.map(name=>{const g=findGroupByName(name);return <p>{g?<a href={base+"groups/"+g.slug+"/"}>{name}</a>:name}</p>}):builtIn[person.slug]?.join(", ")??"No custom membership recorded"}</dd></div><div><dt>Nested resource groups</dt><dd>{nested.length?nested.map(g=><p><a href={base+"groups/"+g.slug+"/"}>{g.name}</a></p>):"None recorded"}</dd></div></dl>
   </div>
  </section>
  {ou&&<section class="content-section">
    <h2>Policies that could reach this account</h2>
    <p class="muted" style="margin:12px 0 17px">These policies are linked to this account's OU or its documented parent. An OU link only establishes possible scope, not effective application.</p>
    <div class="card-list">{likelyPolicies.map(policy=><a class="system-card" href={base+"policies/"+policy.slug+"/"}>
      <small>{policy.link?.ouSlug===person.ou?"Direct OU link":"Parent OU link"} · Not proof of application</small>
      <h3>{policy.name}</h3><p>{policy.summary}</p><span class="readmore">See applied vs configured evidence →</span>
    </a>)}</div>
    <p class="muted" style="margin-top:15px">Domain-wide policy links are a separate inherited scope. <a href={base+"policies/domain-password/"}>See the default domain policy</a>.</p>
  </section>}
  <section class="content-section">
    <h2>Configured folder access</h2>{nested.length>0&&<div class="paper panel" style="margin-bottom:18px"><h3>How this account reaches a resource</h3><p><strong>{person.name}</strong> → {person.directGroups.map((name,i)=><Fragment>{i>0&&" · "}{findGroupByName(name)?<a href={base+"groups/"+findGroupByName(name)?.slug+"/"}>{name}</a>:name}</Fragment>)}</p>{nested.map(g=><p>↳ <a href={base+"groups/"+g.slug+"/"}>{g.name}</a> → <a href={base+"files/shares/"+g.folder+"/"}>{g.folder?.toUpperCase()} folder</a> · SMB {g.shareRight} / NTFS {g.ntfsRight}</p>)}<p class="muted">This is the path from the account to the folder as recorded in the directory.</p></div>}{nested.length>0&&<div class="card-list">{nested.map(g=><a class="system-card" href={base+"files/shares/"+g.folder+"/"}><h3>{g.folder?.toUpperCase()} folder</h3><p>Configured group rights: SMB {g.shareRight} · NTFS {g.ntfsRight}</p></a>)}</div>}
    {groupTargets.length>0?<div class="card-list" style="margin-top:19px">{groupTargets.map(group=>group&&<a class="system-card" href={base+"groups/"+group.slug+"/"}><small>Recorded direct group membership</small><h3>{group.name}</h3><p>{group.description}</p><span class="readmore">Follow the group →</span></a>)}</div>:
      <div class="note" style="margin-top:19px">This account is not a direct member of any department group I created. Built-in group memberships are separate.</div>}
    <p class="muted" style="margin-top:18px">Whether an account can open a file depends on its group membership and on the folder's permissions together.</p>
  </section>
  {person.slug==="john-shaw"&&<section class="content-section"><h2>Recorded policy test</h2><p>gpresult confirmed the contractor USB restriction and corporate wallpaper. Physical USB behavior was not verified end-to-end.</p><figure><img style="width:100%;height:auto" src={base+"evidence/03-contractor-user-gpresult.png"} alt="John Shaw Group Policy result"/><figcaption style="text-align:center">John Shaw’s recorded Group Policy processing result.</figcaption></figure><p><a href={base+"reference/Documentation/Change-Requests/Journal-CR-006/"}>Group Policy journal →</a></p></section>}
{isExample && <section class="content-section">
    <div class="paper panel">
      <div class="eyebrow">Follow one tested company request</div><h2 style="margin:13px 0">From Moyo to the IT folder.</h2><p>I tested a real session: IT allowed, Finance denied.</p><p><a href={base+"incidents/group-acl-name-mismatch/"}>Unexpected · Access checker error</a> · <a href={base+"incidents/file-permission-denial/"}>Controlled · Folder access denied</a></p>
      <ol class="walkthrough" style="list-style:none;padding-left:0">
        <li class="walk-step"><h3><a href={base+"directory/ous/it/"}>IT Organizational Unit</a></h3><p>Moyo's account is located inside the IT OU.</p></li>
        <li class="walk-step"><h3><a href={base+"groups/it-users/"}>IT_Users</a></h3><p>The recorded direct Global department membership.</p></li>
        <li class="walk-step"><h3><a href={base+"groups/dl-fs-it-modify/"}>DL_FS_IT_Modify</a></h3><p>IT_Users is nested into this Domain Local group, which appears in the resource ACLs.</p></li>
        <li class="walk-step"><h3><a href={base+"files/dfs/"}>Company DFS path</a></h3><p>The friendly IT folder address points to the actual share on NOVA-FILES01.</p></li>
        <li class="walk-step"><h3><a href={base+"files/shares/it/"}>SMB Change and NTFS Modify</a></h3><p>These configured permissions are separate; historical tests validated selected allowed and denied access results.</p></li>
      </ol>
      <a class="btn small" href={base+"files/shares/it/"}>See the complete IT access chain →</a>
    </div>
  </section>}
  {isManager && <section class="content-section">
    <div class="paper panel">
      <div class="eyebrow">A special management authorization</div>
      <h2 style="margin:13px 0">Broader Finance permissions</h2>
      <p class="muted">Maria's documented Management_Users membership connects through a separate Domain Local Finance FullControl group. That group, rather than Maria's name, is present on the Finance share and NTFS ACLs.</p>
      <a class="evidence-link" href={base+"files/shares/finance/"}>Follow Finance's exception →</a>
    </div>
  </section>}
  {person.category==="service"&&<div class="note warning">I created this service account for a named purpose. That does not show that a running process signs in with it.</div>}
  <section class="content-section"><details><summary>Technical checks</summary><p><strong>Where:</strong> Domain controller or authorized management PC with the Active Directory module.</p><h3>Verify the account and direct memberships</h3><pre><code>{"Get-ADUser -Identity \""+person.logon+"\" -Properties Enabled,MemberOf | Select-Object Name,Enabled,DistinguishedName,MemberOf"}</code></pre><p><strong>Expected:</strong> Account {person.logon} is returned with Enabled = {String(person.enabled)} in the documented location. Compare MemberOf with the recorded direct membership; primary-group and nested rights are separate.</p>{person.directGroups.length>0&&<><h3>Review the account’s groups</h3><pre><code>{"Get-ADPrincipalGroupMembership -Identity \""+person.logon+"\""}</code></pre><p><strong>Expected:</strong> {person.directGroups.join(", ")} appears in the membership inventory. A separate resource/session check is required to establish actual folder access.</p></>}</details></section>
  <section class="content-section" style="margin-top:28px">
    <h2>Engineering journals</h2><div class="paper panel"><p class="muted">These 20 accounts come from the published directory snapshot. No mailbox addresses were exported, and a sign-in name is not an email address.</p><p><a href={base+"reference/explore/people/"+sourcePath+"/"}>Original account record →</a></p><p><a href={base+"reference/Documentation/Change-Requests/Journal-CR-005/"}>Directory setup journal →</a></p><p><a href={base+"reference/Documentation/Change-Requests/CR-011_PowerShell_Administration_Toolkit/"}>Account automation journal →</a></p><a class="evidence-link" href={"https://github.com/EtiDavid/Nova-Corp/blob/main/docs/explore/people/"+sourcePath+".md"}>Open source documentation ↗</a></div>
  </section>
</div>
<aside>
  <div class="sidebox"><h3>Explore connections</h3>{ou?<a href={base+"directory/ous/"+ou.slug+"/"}>Parent Organizational Unit →</a>:<a href={base+"directory/"}>Directory tree →</a>}<p style="margin-top:15px"><a href={base+"groups/"}>Company security groups →</a></p><p style="margin-top:15px"><a href={base+"files/"}>Department file access →</a></p></div>
  
</aside></div></section>
</BaseLayout>

<style>.account-page>*{min-width:0}.account-page .content-section{margin-bottom:44px}.account-page h2{font-size:clamp(1.55rem,2.4vw,2.15rem);margin:0 0 17px;line-height:1.2}.account-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 28px}.account-details dd{overflow-wrap:anywhere}.account-details dd p{margin:0 0 5px}.account-page p{line-height:1.65}@media(max-width:640px){.account-details{grid-template-columns:1fr}}</style>