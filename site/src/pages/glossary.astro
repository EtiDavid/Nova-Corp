---
import NovaLayout from "../layouts/NovaLayout.astro";
import { loadNova } from "../lib/nova";
const nova = await loadNova();
const base = import.meta.env.BASE_URL;
const terms = [...nova.glossary].sort((a: any, b: any) => a.term.localeCompare(b.term));
---
<NovaLayout title="Glossary" description="Terms used on this site, explained through the Nova Corp lab." current="">
  <section class="hero2" style="padding-bottom:16px"><div class="wrap"><div class="eyebrow">Glossary</div><h1>What the terms mean here.</h1>
    <p class="lead">Each term says what it is and where it shows up in Nova Corp.</p></div></section>
  <section class="wrap" style="padding-bottom:48px">
    <dl class="gloss">
      {terms.map((g: any) => (
        <div id={g.id}><dt>{g.term}</dt><dd>{g.short}</dd><dd><b>In Nova Corp:</b> {g.inNova}</dd>
          <dd class="tiny"><a href={base + "learn/" + g.id + "/"}>Full explanation with sources →</a></dd>
          {g.seeAlso.length > 0 && <dd class="tiny">See also: {g.seeAlso.map((x: string, n: number) => { const sys = nova.stationById(x), svc = nova.services.find((v: any) => v.id === x), t = nova.glossary.find((y: any) => y.id === x);
            const href = sys ? base + "systems/" + x + "/" : svc ? base + "services/" + x + "/" : "#" + x; const label = sys?.name ?? svc?.name ?? t?.term ?? x; return <>{n ? ", " : ""}<a href={href}>{label}</a></>; })}</dd>}
        </div>))}
    </dl>
  </section>
</NovaLayout>
