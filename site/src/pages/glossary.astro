---
import BaseLayout from "../layouts/BaseLayout.astro";
import { techTerms } from "../data/techLexicon";
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Plain-English glossary" description="Short explanations of real technical terms, with examples drawn from the Nova Corp home lab." breadcrumbs={[{label:"Glossary"}]}>
<section class="page-head"><div class="container"><div class="eyebrow">No jargon required</div><h1>Understand the technology.</h1><p class="lead" style="margin-top:15px">Every term has a short explanation, a practical home-lab example and links back to the systems that use it.</p></div></section>
<section class="section compact"><div class="container">
<div class="term-index">{techTerms.map(term=><a href={base+"learn/"+term.slug+"/"}><span>TERM / {term.word.toUpperCase()}</span><h2>{term.word}</h2><p>{term.brief}</p><strong>Explain this ↗</strong></a>)}</div>
</div></section>
</BaseLayout>
