---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchitectureSvg from "../../components/ArchitectureSvg.astro";
import WorkflowLab from "../../components/WorkflowLab.astro";
import { systems, edges, getSystem } from "../../data/model";
const base = import.meta.env.BASE_URL;
const incidentFor: Record<string, [string, string]> = {
  "nova-dc01": ["dc01-outage", "Replay: what happened when DC01 went offline"],
  "nova-dc02": ["dc01-outage", "Replay: what happened when DC01 went offline"],
  "nova-client": ["dns-client-outage", "Investigation: the IT folder won't open"],
  "nova-fw01": ["firewall-management-exposure", "Investigation: an employee PC could reach firewall admin"],
  "nova-files01": ["backup-target-unavailable", "Investigation: the backup disk disappeared"],
  "nova-prox01": ["proxmox-storage-pressure", "Investigation: storage pressure on the Proxmox host"]
};
const verbs: Record<string, [string, string]> = {
  hosts: ["hosts", "is hosted by"], "routes-through": ["traffic passes through", "carries traffic from"],
  "uses-service": ["uses", "is used by"], accesses: ["opens files on", "is opened by"],
  "replicates-with": ["replicates Active Directory with", "replicates Active Directory with"],
  "depends-on": ["uses identity and DNS from", "provides identity and DNS to"], "routes-to": ["allows approved services to", "receives approved services from"]
};
const connections = (id: string) => edges.filter(e => e.from === id || e.to === id).map(e => {
  const out = e.from === id; const other = getSystem(out ? e.to : e.from);
  return other ? `${out ? "" : ""}${verbs[e.type]?.[out ? 0 : 1] ?? e.label} ${other.name.toUpperCase()}`.replace(/^./, c => c.toUpperCase()) : "";
}).filter(Boolean);
const views = {
  overview: { label: "Overview", nodes: [], edges: [], note: "Six core systems. Select one to see what it does, what it connects to, and the evidence." },
  identity: { label: "Identity", nodes: ["nova-client", "nova-fw01", "nova-dc01", "nova-dc02", "nova-files01"], edges: ["fw-dc01", "fw-dc02", "dc-repl", "files-dc", "client-fw"], note: "Company computers ask the Domain Controllers for DNS and sign-in. DC02 keeps the directory available when DC01 is down — checked in a controlled outage." },
  network: { label: "Network", nodes: ["nova-client", "nova-fw01", "nova-dc01", "nova-files01"], edges: ["client-fw", "fw-dc01", "fw-files"], note: "The firewall sits between the workstation network and the servers. Five VLANs are configured; WireGuard is a tunnel, not a VLAN. Broad pass rules remain on some segments." },
  files: { label: "Files", nodes: ["nova-client", "nova-fw01", "nova-files01", "nova-dc01"], edges: ["client-fw", "fw-files", "files-dc"], note: "Opening a shared folder uses DNS and identity from the Domain Controllers plus a separate connection to the file server. Share permissions and folder permissions are both checked." },
  recovery: { label: "Recovery", nodes: ["nova-files01", "nova-dc01", "nova-prox01"], edges: [], note: "A deleted file was restored with a matching hash, and an earlier file version was recovered from Shadow Copy. Whole-VM and complete Domain Controller restores are not claimed." }
};
const payload = { views, ids: systems.map(s => s.id) };
---
<BaseLayout title="Explore the infrastructure" description="An interactive map of the Nova Corp lab: select a system to see what it does, how it connects and the evidence behind it." breadcrumbs={[{ label: "Explore" }]}>
  <section class="page-head tight"><div class="container">
    <div class="byline">Explore</div>
    <h1>How do the parts of this lab work together?</h1>
    <p class="lead" style="margin-top:14px">Choose a system to inspect its relationships and evidence, or trace a documented request through multiple components.</p>
    <div class="button-row" style="margin-top:18px"><a class="btn ghost small" href="#workflow-lab">Trace a request or outage ↓</a><a class="btn ghost small" href={base+"incidents/dns-client-outage/"}>Investigate the DNS failure ↗</a></div>
  </div></section>
  <section id="company-map" data-base={base} class="section compact" style="padding-top:0;scroll-margin-top:95px"><div class="container">
    <div class="tabs" role="group" aria-label="Choose a focus" id="tabs">
      {Object.entries(views).map(([k, v]) => <button type="button" data-view={k} aria-pressed={k === "overview" ? "true" : "false"}>{v.label}</button>)}
    </div>
    <div class="sim-bar" role="group" aria-label="Show a documented historical fault on the company diagram">
      <span class="sim-title">REPLAY A RECORDED FAULT</span>
      <button type="button" data-scenario="reference" aria-pressed="true">Architecture</button>
      <button type="button" data-scenario="dc01-outage" aria-pressed="false">DC01 offline</button>
      <button type="button" data-scenario="client-dns-fault" aria-pressed="false">Wrong client DNS</button>
    </div>
    <div class="sim-summary" id="sim-summary" role="status" aria-live="polite">
      <span class="sim-status">DOCUMENTED SNAPSHOT</span>
      <p id="sim-text">Select a recorded incident above. This is a diagram, not live system status.</p>
      <a id="sim-evidence" href={base+"sources/"}>Verify the original evidence ↗</a>
    </div>
    <div class="explorer">
      <div class="view-note-wrap">
        <p class="view-note" id="view-note" aria-live="polite">{views.overview.note}</p>
        <div class="canvas">
          <ArchitectureSvg interactive />
          <div class="legend" aria-label="Legend">
            <span><i style="border-color:#6E83A3"></i>Recorded configuration</span>
            <span><i style="border-color:#6557A8"></i>DNS and sign-in</span>
            <span><i style="border-color:#087F75"></i>Shared files (SMB)</span>
            <span><i style="border-color:#6E83A3;border-top-style:dashed"></i>Conditional / supporting</span>
          </div>
        </div>
        <ul class="sys-list" id="sys-list" aria-label="All systems">
          {systems.map(s => <li><button type="button" data-id={s.id} aria-pressed="false">{s.name.toUpperCase()}<small>{s.category}</small></button></li>)}
        </ul>
      </div>
      <aside class="inspector" aria-label="Selected system" id="inspector">
        <button type="button" class="btn ghost small back-btn" id="back-btn">← Back to overview</button>
        <p class="inspector-empty" id="inspector-empty">Select a system on the map or in the list to see what it does, what it connects to, and the evidence.</p>
        {systems.map(s => (
          <article class="sys-card" id={"sys-" + s.id} data-id={s.id} tabindex="-1">
            <h3>{s.name.toUpperCase()}</h3>
            <p><span class="chip configured">{s.category}</span></p>
            <h4>What it does</h4><p>{s.summary}</p>
            <h4>What it connects to</h4>
            <ul>{connections(s.id).map(c => <li>{c}</li>)}</ul>
            <h4>Technical summary</h4>
            <ul>{s.details.map(d => <li><b>{d.label}:</b> {d.value}</li>)}</ul>
            <h4>Not yet proven</h4>
            <ul>{s.limitations.map(l => <li>{l}</li>)}</ul>
            <h4>Evidence</h4>
            <ul>
              {incidentFor[s.id] && <li><a href={base + "incidents/" + incidentFor[s.id][0] + "/"}>{incidentFor[s.id][1]}</a></li>}
              <li><a href={base + "systems/" + s.slug + "/"}>Open the full system record</a></li>
              <li><a href={s.sourceUrl}>Original source on GitHub ↗</a></li>
            </ul>
          </article>
        ))}
      </aside>
    </div>
  </div></section>
  <div class="container">
    <WorkflowLab />
  </div>
  <section class="exp-block" aria-labelledby="company-proof" style="padding-top:68px">
    <div class="container">
      <div class="exp-section-heading">
        <div class="exp-eyebrow">Real engineering screenshots / original public evidence</div>
        <h2 id="company-proof">See the actual work behind the diagrams.</h2>
        <p>The interactive diagrams explain relationships. These three unchanged screenshots document specific Group Policy configuration and processing. They do not represent live monitoring or new test results.</p>
      </div>
      <div class="exp-evidence-gallery">
        <figure class="exp-evidence-item">
          <a href={base+"evidence/02-usb-deny-all-removable-storage-enabled.png"} target="_blank" rel="noopener noreferrer" aria-label="Open full original screenshot of configured removable storage policy">
            <img src={base+"evidence/02-usb-deny-all-removable-storage-enabled.png"} alt="Original Group Policy Management screenshot showing the configured Deny all removable storage setting" loading="lazy" decoding="async" />
          </a>
          <figcaption><span>01 / CONFIGURATION</span><strong>Contractor removable-storage policy</strong><p>The saved deny-removable-storage GPO setting, not proof that every client received it.</p><a href={base+"policies/contractor-usb/"}>Review the GPO scope and results ↗</a></figcaption>
        </figure>
        <figure class="exp-evidence-item">
          <a href={base+"evidence/03-contractor-user-gpresult.png"} target="_blank" rel="noopener noreferrer" aria-label="Open full original screenshot of historical Group Policy processing">
            <img src={base+"evidence/03-contractor-user-gpresult.png"} alt="Original historical Windows gpresult screenshot showing processed policy information from a test session" loading="lazy" decoding="async" />
          </a>
          <figcaption><span>02 / CLIENT PROCESSING</span><strong>Historical gpresult evidence</strong><p>A real client-side processing result. It does not establish effective policy for every company account.</p><a href={base+"policies/corporate-wallpaper/"}>Examine the verified observation ↗</a></figcaption>
        </figure>
        <figure class="exp-evidence-item">
          <a href={base+"evidence/05-firewall-gpo-configuration.png"} target="_blank" rel="noopener noreferrer" aria-label="Open full original screenshot of configured Windows Defender Firewall policy">
            <img src={base+"evidence/05-firewall-gpo-configuration.png"} alt="Original Windows Group Policy screenshot showing configured Windows Defender Firewall policy settings" loading="lazy" decoding="async" />
          </a>
          <figcaption><span>03 / CONFIGURATION</span><strong>Workstation firewall baseline</strong><p>Recorded Windows Defender Firewall settings inside a GPO, separate from pfSense management filtering.</p><a href={base+"policies/workstation-baseline/"}>Review the saved policy ↗</a></figcaption>
        </figure>
      </div>
      <p class="exp-gallery-note">Screenshots are byte-identical copies of images already in the public engineering repository. <a href={base+"evidence/manifest.json"}>Review the SHA-256 provenance manifest ↗</a> · <a href={base+"sources/"}>All original source records ↗</a>.</p>
    </div>
  </section>
  <script is:inline type="application/json" id="company-data" set:html={JSON.stringify(payload)}></script>
  <script is:inline>
  (function () {
    var data = JSON.parse(document.getElementById("company-data").textContent);
    var svg = document.getElementById("arch");
    var nodes = [].slice.call(svg.querySelectorAll(".node"));
    var edgeEls = [].slice.call(svg.querySelectorAll(".edge-group"));
    var cards = [].slice.call(document.querySelectorAll(".sys-card"));
    var listBtns = [].slice.call(document.querySelectorAll("#sys-list button"));
    var tabs = [].slice.call(document.querySelectorAll("#tabs button"));
    var note = document.getElementById("view-note");
    var scenarioButtons = [].slice.call(document.querySelectorAll("[data-scenario]"));
    var scenarioText = document.getElementById("sim-text");
    var scenarioEvidence = document.getElementById("sim-evidence");
    var scenarios = {
      reference: { label:"Select a recorded incident above. This is a diagram, not live system status.", url:"sources/" },
      "dc01-outage": { label:"Historical DC01 outage: DC01 was deliberately unavailable; the client selected DC02 and work continued in the tested scope. Replication was checked after DC01 returned. No whole-DC restore is implied.", url:"incidents/dc01-outage/" },
      "client-dns-fault": { label:"Historical DNS incident: the client used the wrong resolver, 192.0.2.53. A direct connection to NOVA-FILES01 on TCP 445 still succeeded by IP. The dotted outline illustrates misconfiguration, not an actual server outage.", url:"incidents/dns-client-outage/" }
    };
    var empty = document.getElementById("inspector-empty");
    var root = document.documentElement;
    var state = { view: "overview", focus: null, scenario: "reference" }, lastOpener = null;
    function url() {
      var q = new URLSearchParams();
      if (state.view !== "overview") q.set("view", state.view);
      if (state.focus) q.set("focus", state.focus);
      if (state.scenario !== "reference") q.set("scenario", state.scenario);
      var s = q.toString(); return location.pathname + (s ? "?" + s : "");
    }
    function render() {
      var v = data.views[state.view];
      note.textContent = v.note;
      var scenario = scenarios[state.scenario] || scenarios.reference;
      scenarioText.textContent = scenario.label;
      var rootBase = document.querySelector("#company-map").getAttribute("data-base") || "/";
      scenarioEvidence.href = rootBase + scenario.url;
      scenarioEvidence.textContent = state.scenario === "reference" ? "Verify the original evidence ↗" : "Read the recorded investigation ↗";
      scenarioButtons.forEach(function(b){ b.setAttribute("aria-pressed",String(b.dataset.scenario===state.scenario)); });
      tabs.forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.view === state.view ? "true" : "false"); });
      nodes.forEach(function (n) {
        var dim = v.nodes.length && v.nodes.indexOf(n.dataset.id) < 0;
        n.classList.toggle("dim", !!dim);
        var sel = n.dataset.id === state.focus;
        n.classList.toggle("selected", sel);
        n.classList.toggle("scenario-outage",state.scenario==="dc01-outage"&&n.dataset.id==="nova-dc01");
        n.classList.toggle("scenario-alternate",state.scenario==="dc01-outage"&&n.dataset.id==="nova-dc02");
        n.classList.toggle("scenario-misconfigured",state.scenario==="client-dns-fault"&&n.dataset.id==="nova-client");
        n.setAttribute("aria-pressed", sel ? "true" : "false");
      });
      edgeEls.forEach(function (e) {
        var on = v.edges.indexOf(e.dataset.edge) >= 0;
        e.classList.toggle("dim", (v.nodes.length > 0 || v.edges.length > 0) && !on);
        e.querySelector(".edge").classList.toggle("on", on);
        e.classList.toggle("scenario-interrupted",state.scenario==="dc01-outage"&&["fw-dc01","dc-repl","files-dc"].indexOf(e.dataset.edge)>=0);
        e.classList.toggle("scenario-surviving",state.scenario==="dc01-outage"&&e.dataset.edge==="fw-dc02");
        e.classList.toggle("scenario-reachable",state.scenario==="client-dns-fault"&&e.dataset.edge==="fw-files");
      });
      listBtns.forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.id === state.focus ? "true" : "false"); });
      cards.forEach(function (c) { c.classList.toggle("is-selected", c.dataset.id === state.focus); });
      empty.classList.toggle("hidden", !!state.focus);
      root.classList.toggle("has-focus", !!state.focus);
    }
    function set(next, push) {
      var changed = next.view !== state.view || next.focus !== state.focus || next.scenario !== state.scenario;
      state = next; render();
      if (push && changed) history.pushState(state, "", url());
    }
    function readUrl() {
      var q = new URLSearchParams(location.search);
      var view = q.get("view"); var focus = q.get("focus"); var scenario = q.get("scenario");
      return { view: data.views[view] ? view : "overview", focus: data.ids.indexOf(focus) >= 0 ? focus : null, scenario: scenarios[scenario] ? scenario : "reference" };
    }
    function select(id, opener) { lastOpener = opener || null; set({ view: state.view, focus: id, scenario: state.scenario }, true);
      var card = document.getElementById("sys-" + id); if (card && window.matchMedia("(max-width:1100px)").matches) card.focus({ preventScroll: false }); }
    function clear() { var o = lastOpener; set({ view: state.view, focus: null, scenario: state.scenario }, true); if (o) o.focus(); }
    nodes.forEach(function (n) {
      n.addEventListener("click", function () { select(n.dataset.id, n); });
      n.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); select(n.dataset.id, n); } });
    });
    listBtns.forEach(function (b) { b.addEventListener("click", function () { select(b.dataset.id, b); }); });
    tabs.forEach(function (b) { b.addEventListener("click", function () { set({ view: b.dataset.view, focus: state.focus, scenario:"reference" }, true); }); });
    scenarioButtons.forEach(function(b){
      b.addEventListener("click",function(){
        var scenario=b.dataset.scenario;
        var view=scenario==="dc01-outage"?"identity":scenario==="client-dns-fault"?"files":state.view;
        set({view:view,focus:null,scenario:scenario},true);
      });
    });
    document.getElementById("back-btn").addEventListener("click", function () { clear(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && state.focus) clear(); });
    window.addEventListener("novacorp:trace",function(e){
      var detail=e.detail||{};
      var v=data.views[detail.view]?detail.view:"overview";
      var f=data.ids.indexOf(detail.focus)>=0?detail.focus:null;
      lastOpener=null;set({view:v,focus:f,scenario:"reference"},true);
    });
    window.addEventListener("popstate", function () { state = readUrl(); render(); });
    state = readUrl(); render();
  })();
  </script>
</BaseLayout>
