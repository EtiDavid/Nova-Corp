---
import ProxmoxLayers from "../../../components/nova/xf/ProxmoxLayers.astro";
import VlanTags from "../../../components/nova/xf/VlanTags.astro";
import NameLookup from "../../../components/nova/xf/NameLookup.astro";
import DcSignIn from "../../../components/nova/xf/DcSignIn.astro";
import AccountGroups from "../../../components/nova/xf/AccountGroups.astro";
import PolicyDelivery from "../../../components/nova/xf/PolicyDelivery.astro";
import TwoStageFirewall from "../../../components/nova/xf/TwoStageFirewall.astro";
import FileService from "../../../components/nova/xf/FileService.astro";
import FolderAccess from "../../../components/nova/xf/FolderAccess.astro";
import DfsReferral from "../../../components/nova/xf/DfsReferral.astro";
import FileRecovery from "../../../components/nova/xf/FileRecovery.astro";
import FirewallRules from "../../../components/nova/xf/FirewallRules.astro";
import FilesDoors from "../../../components/nova/xf/FilesDoors.astro";
import NovaLayout from "../../../layouts/NovaLayout.astro";
import { loadNova, typeLabel, journalHref } from "../../../lib/nova";
export async function getStaticPaths() {
  const nova = await loadNova();
  return [...nova.done, ...nova.supplemental].map((c: any) => ({ params: { id: c.id }, props: { id: c.id } }));
}
const { id } = Astro.props;
const base = import.meta.env.BASE_URL;
const nova = await loadNova();
const c = nova.changes.find((x: any) => x.id === id);
const b = nova.builtIn(id);
const sup = !!c.supplemental;
const i = nova.done.findIndex((x: any) => x.id === id);
const journal = await journalHref(c.journal, base);
const prev = sup ? undefined : nova.done[i - 1], nextC = sup ? undefined : nova.done[i + 1];
---
<NovaLayout title={`${c.id}: ${c.title}`} description={`${c.title}. ${c.goal} Part of the Nova Corp lab by David Eti.`} current="changes">
  <section class="incident-head"><div class="wrap prose-narrow">
    <p class="tiny"><a href={base + "changes/"}>← All changes</a></p>
    <h1 style="margin-top:10px">{c.title}</h1>
    <p class="lead" style="margin-top:12px"><span class="mono">{c.id}</span>{sup && " · supplemental, outside the numbered roadmap"} · {c.goal}</p>
  </div></section>
  <div class="wrap prose-narrow">
    {id === "CR-001" && <ProxmoxLayers start="stack" />}
    {id === "CR-002" && <VlanTags />}
    {id === "CR-003" && <NameLookup />}
    {id === "CR-004" && <DcSignIn />}
    {id === "CR-005" && <AccountGroups />}
    {id === "CR-006" && <PolicyDelivery />}
    {id === "CR-007" && <TwoStageFirewall />}
    {id === "CR-008" && <FileService />}
    {id === "CR-009" && <FolderAccess />}
    {id === "CR-010" && <DfsReferral />}
    {id === "CR-012" && <FileRecovery start="backup" />}
    {id === "CR-013" && <DcSignIn start="outage" />}
    {id === "CR-014" && <FilesDoors />}
    {id === "CR-015" && <FirewallRules />}
  </div>
  <div class="wrap prose-narrow" style="padding-bottom:40px">
    <h2 style="margin-top:20px">What I built</h2>
    <ul>{(c.built ?? []).map((x: string) => <li>{x}</li>)}</ul>
    {b.adds.length > 0 && <p class="tiny" style="margin-top:10px">Added to the map: {b.adds.map((s: any, n: number) => <>{n ? ", " : ""}<a href={base + "systems/" + s.id + "/"}>{s.name}</a></>)}.</p>}
    {b.changes.length > 0 && <p class="tiny" style="margin-top:6px">Changed on the map: {b.changes.map((s: any, n: number) => <>{n ? ", " : ""}<a href={base + "systems/" + s.id + "/"}>{s.name}</a></>)}.</p>}
    {b.services.length > 0 && <p class="tiny" style="margin-top:6px">Services: {b.services.map((v: any, n: number) => <>{n ? ", " : ""}<a href={base + "services/" + v.id + "/"}>{v.name}</a></>)}.</p>}
    {b.incidents.length > 0 && <>
      <h2 style="margin-top:28px">What broke</h2>
      <ul class="plainlist">{b.incidents.map((n: any) => <li><span class={"type " + n.type} style="margin-right:8px">{typeLabel[n.type]}</span><a href={base + "incidents/" + n.slug + "/"}>{n.shortTitle ?? n.title}</a></li>)}</ul></>}
    {c.validated && <><h2 style="margin-top:28px">How it was validated</h2><p style="margin-top:6px">{c.validated}</p></>}
    {c.limits && c.limits.length > 0 && <><h2 style="margin-top:28px">What this does not prove</h2><ul>{c.limits.map((x: string) => <li>{x}</li>)}</ul></>}
    <h2 style="margin-top:28px">{sup ? "Sanitized public summary" : "Original journal"}</h2>
    <p style="margin-top:6px"><a class="nv-link" href={journal.href}>Full journal ({c.id}){journal.external ? " ↗" : " →"}</a></p>
    <p class="tiny" style="margin-top:28px">{prev && <a href={base + "changes/" + prev.id + "/"}>← {prev.id}</a>}{prev && nextC && "  ·  "}{nextC && <a href={base + "changes/" + nextC.id + "/"}>{nextC.id} →</a>}</p>
  </div>
</NovaLayout>
