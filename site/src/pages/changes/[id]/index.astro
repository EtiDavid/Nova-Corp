---
import NovaLayout from "../../../layouts/NovaLayout.astro";
import { loadNova, typeLabel, journalHref } from "../../../lib/nova";
export async function getStaticPaths() {
  const nova = await loadNova();
  return nova.done.map((c: any) => ({ params: { id: c.id }, props: { id: c.id } }));
}
const { id } = Astro.props;
const base = import.meta.env.BASE_URL;
const nova = await loadNova();
const c = nova.changes.find((x: any) => x.id === id);
const b = nova.builtIn(id);
const i = nova.done.findIndex((x: any) => x.id === id);
const journal = await journalHref(c.journal, base);
const prev = nova.done[i - 1], nextC = nova.done[i + 1];
---
<NovaLayout title={`${c.id}: ${c.title}`} description={c.goal} current="changes">
  <section class="incident-head"><div class="wrap prose-narrow">
    <p class="tiny"><a href={base + "changes/"}>← All changes</a></p>
    <h1 style="margin-top:10px">{c.title}</h1>
    <p class="lead" style="margin-top:12px"><span class="mono">{c.id}</span> · {c.goal}</p>
  </div></section>
  <div class="wrap prose-narrow" style="padding-bottom:40px">
    {(b.systems.length > 0 || b.services.length > 0) && <>
      <h2 style="margin-top:20px">What I built</h2>
      <ul class="plainlist">
        {b.systems.map((s: any) => <li><a href={base + "systems/" + s.id + "/"}>{s.name}</a>: {s.role}</li>)}
        {b.services.map((v: any) => <li><a href={base + "services/" + v.id + "/"}>{v.name}</a>: {v.summary}</li>)}
      </ul></>}
    {b.incidents.length > 0 && <>
      <h2 style="margin-top:28px">What broke</h2>
      <ul class="plainlist">{b.incidents.map((n: any) => <li><span class={"type " + n.type} style="margin-right:8px">{typeLabel[n.type]}</span><a href={base + "incidents/" + n.slug + "/"}>{n.shortTitle ?? n.title}</a></li>)}</ul></>}
    <h2 style="margin-top:28px">Original journal</h2>
    <p style="margin-top:6px"><a class="nv-link" href={journal.href}>Full journal ({c.id}){journal.external ? " ↗" : " →"}</a></p>
    <p class="tiny" style="margin-top:28px">{prev && <a href={base + "changes/" + prev.id + "/"}>← {prev.id}</a>}{prev && nextC && "  ·  "}{nextC && <a href={base + "changes/" + nextC.id + "/"}>{nextC.id} →</a>}</p>
  </div>
</NovaLayout>
