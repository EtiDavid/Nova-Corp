---
import NovaLayout from "../../layouts/NovaLayout.astro";
import { loadNova } from "../../lib/nova";
const base = import.meta.env.BASE_URL;
const nova = await loadNova();
const next = nova.upcoming.find((c: any) => c.status === "next");
---
<NovaLayout title="Changes" description="The change requests that built the Nova Corp lab, in order, with what each one added and what broke." current="changes">
  <section class="hero2" style="padding-bottom:16px"><div class="wrap">
    <div class="eyebrow">Changes</div>
    <h1>What I built, in order.</h1>
    <p class="lead">Each change request added something to the map. The Windows foundation (CR-001 to CR-{nova.done.at(-1).id.slice(3)}) was signed off as a {nova.facts.signOff.result}.</p>
  </div></section>
  <section class="wrap" style="padding-bottom:48px">
    <ol class="timeline">
      {nova.done.map((c: any) => { const b = nova.builtIn(c.id); return (
        <li>
          <div class="tl-id mono">{c.id}</div>
          <div>
            <h2 class="tl-title"><a href={base + "changes/" + c.id + "/"}>{c.title}</a></h2>
            <p>{c.goal}</p>
            <p class="tiny">
              {b.systems.length > 0 && <>Added to the map: {b.systems.map((s: any) => s.name).join(", ")}. </>}
              {b.incidents.length > 0 && <>{b.incidents.length} incident{b.incidents.length > 1 ? "s" : ""}.</>}
            </p>
          </div>
        </li>); })}
    </ol>
    {next && <div class="boxnote" style="margin-top:28px"><b>Next:</b> {next.id}, {next.title}. {nova.facts.nextChangeStatus === "not started" ? "Planned; not started." : ""} <a href={base + "roadmap/"}>See the roadmap →</a></div>}
  </section>
</NovaLayout>
