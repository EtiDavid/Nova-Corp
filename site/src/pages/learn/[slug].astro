---
import GlossaryPilot from "../../components/GlossaryPilot.astro";
import Files01DocumentImages from "../../components/Files01DocumentImages.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { techTerms, type Term } from "../../data/techLexicon";
import { systems } from "../../data/model";
import EngineeringSourceEmbed from "../../components/EngineeringSourceEmbed.astro";
import OriginalPdfEvidenceGallery from "../../components/OriginalPdfEvidenceGallery.astro";
import {termEvidence,internalArticle,publicDocsRoot} from "../../data/termEvidence";
export function getStaticPaths(){return techTerms.map(term=>({params:{slug:term.slug},props:{term}}));}
interface Props{term:Term}
const {term}=Astro.props;
const base=import.meta.env.BASE_URL;
const isGlossaryPilot=true;
const related=term.related.map(id=>systems.find(s=>s.id===id)).filter(Boolean);
const evidence=termEvidence[term.slug];
if(!evidence)throw Error("No repository-backed technical documentation mapped for "+term.slug);

const pilot:Record<string,{problem:string;solution:string;cmd:string;expected:string;actual:string;incidents:string[];subject:string;heading:string;pdf:string}> = {
 smb:{problem:"An IT employee needs a document on a different computer, but copying it by email creates multiple versions.",solution:"SMB lets her workstation open the department share over the network. The server checks her identity and permissions; a reachable connection is not unrestricted access.",cmd:"Test-NetConnection nova-files01 -Port 445\nGet-SmbSession | Format-Table ClientComputerName,ClientUserName,NumOpens,Dialect",expected:"TCP/445 reachable and an authenticated SMB session visible after a persistent connection is opened.",actual:"The deployment tests recorded a successful TCP connection and an administrative SMB 3.1.1 session; ordinary users were denied C$ and D$.",incidents:["fileserver-subnet","dns-client-outage","file-permission-denial"],subject:"systems/nova-files01",heading:"Original SMB and server deployment evidence",pdf:"NovaCorp_CR-008_File_Server_Deployment_Journal"},
 acl:{problem:"IT employees need to edit their own department documents, but other departments should not automatically gain access.",solution:"Windows uses an access control list containing individual access control entries (ACEs). Each entry identifies a user or group and the actions allowed or denied. Nova Corp assigns ordinary IT access to a resource group instead of granting rights individually.",cmd:"Get-SmbShareAccess -Name IT\nicacls \"D:\\NovaData\\IT\"",expected:"The IT resource group has Change at the share and Modify at the folder.",actual:"The incident investigation found a healthy share ACL but an explicit deny on a child folder. Removing only the deny restored access.",incidents:["file-permission-denial","group-acl-name-mismatch"],subject:"incidents/file-permission-denial",heading:"Actual access control evidence",pdf:"Nova_Corp_CR-014_Engineering_Journal_and_Evidence"},
 ntfs:{problem:"An IT employee must not read confidential Finance documents, even when the server is reachable.",solution:"Folder ACLs specify who may read, modify or administer documents. Windows combines them with share permissions. Nova Corp uses departmental resource groups rather than assigning each employee a separate normal ACL.",cmd:'Get-SmbShareAccess -Name IT\nicacls "D:\\NovaData\\IT\\CR014-IncidentLab"',expected:"IT group has Change at the SMB layer; normal inherited Modify at the folder layer. A fault-injected explicit DENY should be identifiable.",actual:"The controlled permission investigation found the healthy share ACL and explicit child-folder denial; removing only that denial restored the employee’s read/write access.",incidents:["file-permission-denial","two-faults-one-symptom"],subject:"incidents/file-permission-denial",heading:"Original permission diagnosis evidence",pdf:"Nova_Corp_CR-014_Engineering_Journal_and_Evidence"},
 dfs:{problem:"Employees should not need to learn new server names whenever storage is moved.",solution:"DFS gives everyone a stable company address. Each department link currently points to one actual SMB share on NOVA-FILES01, so this is not a redundant file-server cluster.",cmd:"Test-Path Z:\\",expected:"The department drive mapped through the namespace is accessible to the authorized user.",actual:"The workstation test records a mapped drive using DFS and Test-Path Z: returning True.",incidents:["dns-client-outage","file-permission-denial"],subject:"files/dfs",heading:"Original namespace and referral evidence",pdf:"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"},
 "shadow-copy":{problem:"An employee overwrites or deletes a file and wants yesterday’s version back.",solution:"Shadow Copies preserve selected earlier versions on the data volume, scheduled at 07:00 and 12:00 in Nova Corp. They supplement, but do not replace, daily Windows backup at 22:00.",cmd:"vssadmin list shadows /for=D:",expected:"Existing recovery points for the data volume are listed. This is a suggested read-only check; a listing alone does not prove recovery.",actual:"The recovery tests verified the earlier IT file’s contents and recorded an earlier Finance document version.",incidents:["backup-target-unavailable"],subject:"learn/shadow-copy",heading:"Original previous-version evidence",pdf:"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"}
};
const filePilot=pilot[term.slug];
const identityData:Record<string,{problem:string;solution:string;sections:string[][];links:string[][];cmd:string;expected:string;actual:string;images:string[];incidents:string[];pdf:string}>={"active-directory":{"problem":"When Moyo joins IT, the team needs to create her account, give her the right permissions and make sure she can sign in on company computers. Doing this separately on each PC would make administration difficult.","solution":"Nova Corp uses Active Directory to keep company accounts, computers and groups in one directory called nova.corp. IT creates Moyo's account once, places it in the IT organizational unit and adds it to IT_Users. The department group connects to the file resource group. Both domain controllers maintain copies of the directory.","sections":[["What is a domain?","A domain is a centrally managed collection of accounts and computers. nova.corp is the name of the domain, not an employee email service."],["Organizational units (OUs)","OUs organize accounts and computers and provide places to link policies. Nova Corp has 16 documented OUs. An OU alone does not grant file access."],["Users, computers and security groups","The directory inventory records 20 accounts, 4 computer objects and 62 security groups, including 11 custom groups. Global department groups collect employees; Domain Local groups receive permissions on resources."],["Authentication and authorization","Kerberos helps verify identity. The file server separately checks SMB and NTFS permissions. DNS helps the computer find a controller; LDAP lets tools query the directory."],["Two domain controllers","DC01 and DC02 replicate directory changes. During the controlled DC01 outage, clients located DC02. The directory also supports deleted-object recovery using AD Recycle Bin."]],"links":[["Company directory","directory/"],["Security groups","groups/"],["Computer accounts","computers/"],["Group Policy","learn/group-policy/"],["Kerberos","learn/kerberos/"],["LDAP","learn/ldap/"],["DNS","learn/dns/"]],"cmd":"dcdiag /test:Advertising /test:SysVolCheck /test:NetLogons\nrepadmin /replsummary\nResolve-DnsName -Type SRV \"_ldap._tcp.dc._msdcs.nova.corp\"","expected":"Both controllers advertise their services and replication is healthy.","actual":"Directory discovery, SYSVOL and NETLOGON availability, replication, deleted-object recovery and continuity through DC02 were recorded in the resilience exercise.","images":["dc02-sysvol-available","dc01-recovery-gpupdate"],"incidents":["dc01-outage","replication-divergence"],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"},"dns":{"problem":"Moyo wants to open the company file server by name, but computers communicate using IP addresses. Windows also needs to know which servers offer domain authentication.","solution":"Nova Corp installed internal DNS on DC01 and DC02. The workstation asks DNS for the address of NOVA-FILES01 or for a domain service. It can then contact the returned server.","sections":[["Host records (A records)","nova-files01.nova.corp maps to 10.10.20.20. A records map names to IPv4 addresses."],["Service records (SRV)","Windows looks up records such as _ldap._tcp.dc._msdcs.nova.corp to find domain controllers. Kerberos records help locate ticket services."],["Internal DNS configuration","The domain uses AD-integrated DNS. Domain workstations use internal Nova DNS. The pfSense resolver has a nova.corp override to DC01 (10.10.20.10); this does not demonstrate DC02 failover through that override."],["Network ports","DNS normally uses UDP and TCP port 53. A DNS answer is separate from a successful connection to the requested application, such as SMB on TCP 445."]],"links":[["Active Directory","learn/active-directory/"],["SMB","learn/smb/"],["Firewall","systems/nova-fw01/"]],"cmd":"Resolve-DnsName nova-files01.nova.corp\nResolve-DnsName -Type SRV _ldap._tcp.dc._msdcs.nova.corp\nTest-NetConnection 10.10.20.20 -Port 445","expected":"The file server name resolves to 10.10.20.20 and the SMB port is reachable from an authorized client.","actual":"In the controlled DNS fault, name-based access failed while direct IP access and direct queries to internal DNS worked. Correcting the client resolver restored access.","images":["dns-timeout"],"incidents":["dns-client-outage","two-faults-one-symptom"],"pdf":"Nova_Corp_CR-014_Engineering_Journal_and_Evidence"},"ldap":{"problem":"IT needs to look up an employee's directory information and group membership without manually checking every computer.","solution":"LDAP is a protocol that lets an administrative tool query a domain controller for directory objects and attributes. For example, an administrator can look up Moyo's account and discover its group memberships.","sections":[["Directory objects and attributes","An LDAP search can return users, computers, groups and attributes. The directory tree contains distinguished names that identify objects."],["LDAP versus Active Directory","AD is the directory service; LDAP is one protocol used to access it. Kerberos provides ticket-based authentication rather than replacing directory queries."],["Network ports and security","Ordinary LDAP uses TCP 389; LDAPS uses TCP 636 when configured. The Global Catalog commonly uses TCP 3268 or 3269 over TLS. These are standard ports, not a claim all were tested here. The documented DC policy has LDAP signing set to None; effective state requires separate verification."]],"links":[["Directory","directory/"],["Kerberos","learn/kerberos/"],["Domain Controller policy","policies/domain-controllers/"]],"cmd":"Resolve-DnsName -Type SRV _ldap._tcp.dc._msdcs.nova.corp\nTest-NetConnection NOVA-DC02 -Port 389","expected":"A controller can be discovered and LDAP TCP 389 is reachable.","actual":"During the controlled DC01 outage, the TCP 389 check to DC01 failed while DC02 answered the recorded directory connection check. This is not proof of every possible LDAP bind or query.","images":[],"incidents":["dc01-outage"],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"},"kerberos":{"problem":"An employee signs in and then needs to access a file server without typing their password again for every service.","solution":"Windows uses Kerberos tickets issued by the Key Distribution Center on a domain controller. The workstation uses its ticket-granting ticket to request a service ticket for the file server. The server verifies the ticket and separately checks file permissions.","sections":[["Ticket-granting ticket (TGT)","The KDC issues a TGT after authentication. It can be used to request tickets for specific services."],["Service tickets","A service ticket identifies access to a particular service. It does not grant unrestricted access to every folder."],["Ports and time","Kerberos uses TCP or UDP 88. Accurate time and DNS service discovery are important. Nova Corp's saved domain policy specifies a 10-hour user ticket lifetime and five-minute maximum clock skew."]],"links":[["Active Directory","learn/active-directory/"],["DNS","learn/dns/"],["Domain password policy","policies/domain-password/"]],"cmd":"klist\nw32tm /query /status\nnltest /dsgetdc:nova.corp /force","expected":"A valid domain service is found and tickets are available after authentication.","actual":"During DC01 failover, fresh tickets identified DC02 as the serving domain controller.","images":["dc02-sysvol-available"],"incidents":["dc01-outage"],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"},"sysvol":{"problem":"Company workstations need to retrieve the same policy files even if they contact different domain controllers.","solution":"SYSVOL is a shared folder on both controllers. It contains Group Policy file data and other domain material. The controllers synchronize this content so clients can retrieve it from the appropriate server.","sections":[["Where it is located","The domain SYSVOL share is available through the domain controllers; clients use SMB to read it."],["Group Policy","A GPO has information in Active Directory and files in SYSVOL. Both must be accessible for successful processing."],["Replication","Directory replication and SYSVOL file replication are separate mechanisms; both matter for a healthy domain."]],"links":[["NETLOGON","learn/netlogon/"],["Group Policy","learn/group-policy/"],["Replication","learn/replication/"]],"cmd":"Test-Path \"\\\\NOVA-DC01\\SYSVOL\"\nTest-Path \"\\\\NOVA-DC02\\SYSVOL\"\ndcdiag /test:SysVolCheck","expected":"SYSVOL is accessible on the available controller.","actual":"The controlled DC01 outage recorded SYSVOL availability through DC02.","images":["dc02-sysvol-available"],"incidents":["dc01-outage"],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"},"netlogon":{"problem":"Moyo needs her department drive to appear when she signs in. Manually configuring a drive on every workstation would be inconvenient.","solution":"IT configured a logon script stored in the domain NETLOGON share. The drive-mapping Group Policy points to that script. The script helps connect the employee to the relevant department folder.","sections":[["The company script","The configured path is \\\\nova.corp\\NETLOGON\\Map-DepartmentDrive.ps1. NETLOGON is a share exposed by domain controllers for logon-related files; it is also associated with a Windows service of the same name."],["How the drive appears","At sign-in, the linked policy can run the script. It maps the appropriate department address, using the DFS namespace. The file server still checks the employee's permissions."],["What to verify","Check the share and script separately, then verify the user session and the mapped drive. A policy link alone is not proof of a successful mapping. SMB uses TCP 445."]],"links":[["Drive-mapping policy","policies/drive-mapping/"],["DFS","files/dfs/"],["SYSVOL","learn/sysvol/"]],"cmd":"Test-Path \"\\\\NOVA-DC01\\NETLOGON\"\nTest-Path \"\\\\nova.corp\\NETLOGON\\Map-DepartmentDrive.ps1\"\nTest-Path Z:\\","expected":"The NETLOGON share and script are available; the authorized user's mapped drive opens.","actual":"The directory resilience journal records NETLOGON availability on both controllers. The DFS journal documents the mapping script and successful mapped-drive access.","images":["dfs-netlogon-mapping-hash","dfs-client-mapped-drive"],"incidents":["dc01-outage"],"pdf":"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"},"group-policy":{"problem":"If IT configures every employee's workstation by hand, security settings and desktop configuration can become inconsistent.","solution":"IT creates Group Policy Objects (GPOs) and links them to the appropriate domain or organizational unit. Windows retrieves and applies eligible user and computer settings centrally.","sections":[["User versus computer settings","User policies follow the targeted user account; computer policies target computers. Scope, inheritance, filtering and processing determine the result."],["Nova Corp's seven policies","The documented inventory contains seven GPOs, six linked and one empty/unlinked. They cover passwords, DC protection, wallpaper, department drive mapping, contractor USB restrictions and workstation security, plus an unused keyboard object."],["How a policy reaches a workstation","Windows finds a controller through DNS, reads directory policy information and retrieves policy files from SYSVOL. A configured link is not proof the client actually processed it."],["How IT verifies policy","gpresult reports applied policies. For example, the contractor policy appeared in John Shaw's result; actual physical USB blocking was not fully validated in the nested lab."]],"links":[["All seven policies","policies/"],["John Shaw","people/john-shaw/"],["SYSVOL","learn/sysvol/"],["Directory","directory/"]],"cmd":"gpupdate /force\ngpresult /r","expected":"The intended GPO appears in the applicable user's or computer's result.","actual":"The wallpaper-link controlled incident reproduced a missing policy and restored it. The contractor policy was recorded in gpresult.","images":["gpo-disabled-link"],"incidents":["gpo-link-disabled"],"pdf":"CR-006_Group_Policy_Management_Beautified"},"replication":{"problem":"An account created on DC01 needs to exist on DC02 as well, otherwise users may receive inconsistent directory information.","solution":"Both writable domain controllers replicate directory changes. IT checks that changes arrive at the partner and repairs replication when it fails.","sections":[["What gets synchronized","Directory objects and attributes are replicated between controllers. SYSVOL content is synchronized separately."],["How to prove convergence","Check replication results and compare the same object on both controllers, not merely their network reachability."],["Controlled divergence","The test prevented inbound replication on DC02. A newly created group remained absent until replication was restored and object GUID/SID matched."]],"links":[["DC01","systems/nova-dc01/"],["DC02","systems/nova-dc02/"],["SYSVOL","learn/sysvol/"]],"cmd":"repadmin /replsummary\nrepadmin /showrepl NOVA-DC02","expected":"Replication succeeds and both controllers contain the same tested object.","actual":"The deliberately interrupted replication was repaired and object identity verified.","images":["replication-rejected-8457","replication-restored"],"incidents":["replication-divergence"],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"},"system-state":{"problem":"If a domain controller loses critical Windows directory configuration, the company needs a recovery option beyond keeping another running controller.","solution":"Nova Corp configured a scheduled System State backup on DC01 at 23:00. It protects critical Windows and directory components; it is different from a backup of employee files.","sections":[["What it protects","System State includes important Windows configuration and Active Directory components on a domain controller."],["Recovery points versus recovery tests","Three System State-capable recovery points were recorded. A complete System State restoration has not been demonstrated."],["Shared failure domain","The backup destination is within the nested lab. It does not prove independent off-host disaster recovery."]],"links":[["DC01","systems/nova-dc01/"],["Recovery","recovery/"]],"cmd":"wbadmin get versions","expected":"Available backup versions are listed. This is a read-only check, not a restore.","actual":"The recorded inventory contains three System State-capable recovery points.","images":[],"incidents":[],"pdf":"CR-012_Windows_Server_Backup_and_Recovery_Journal"}};
const identityPilot=identityData[term.slug];

const realImage=term.slug==="group-policy"?"05-firewall-gpo-configuration.png":term.slug==="ntfs"?null:null;
---
<BaseLayout title={term.word+" explained"} description={term.brief} breadcrumbs={[{label:"Glossary",href:"glossary/"},{label:term.word}]}>
  <section class="page-head term-head"><div class="container">
    <div class="eyebrow">Plain English / the Nova Corp lab</div>
    <h1>{term.word}</h1>
    <p class="lead">{term.brief}</p>
  </div></section>
  {isGlossaryPilot?<GlossaryPilot slug={term.slug}/>:<section class="section compact"><div class="container term-layout">
    <article class="term-story">
      <div class="term-block"><span class="term-num">01 / UNDERSTAND IT</span><h2>What does it actually mean?</h2><p>{term.everyday}</p></div>
      <div class="term-block"><span class="term-num">02 / SEE IT IN THIS LAB</span><h2>An example from Nova Corp</h2><p>{term.example}</p></div>
      {filePilot&&<div class="term-block"><h2>Why does the company need it?</h2><h3 class="file-problem">Problem</h3><p>{filePilot.problem}</p><h3 class="file-solution">Solution</h3><p>{filePilot.solution}</p>{term.slug==="smb"&&<section><h2>Which network port does SMB use?</h2><p>Modern Windows SMB uses TCP port 445. A workstation connects to NOVA-FILES01 on this port to open a network share. The firewall must permit the connection from authorized networks; an open port alone does not grant file access.</p><p><a href={base+"learn/tcp/"}>What is a TCP port?</a> · <a href={base+"learn/acl/"}>How access lists work</a></p></section>}<h2>How was it verified?</h2><pre><code>{filePilot.cmd}</code></pre><p><strong>Expected:</strong> {filePilot.expected}</p><p><strong>Recorded outcome:</strong> {filePilot.actual}</p>{term.slug!=="shadow-copy"&&<Files01DocumentImages ids={term.slug==="smb"?["fileserver-smb-session","fileserver-department-inventory"]:["ntfs","acl"].includes(term.slug)?["permission-explicit-deny","permission-denial-observed","permission-repair-pass"]:["dfs-namespace-gui","dfs-targets-online-audit","dfs-client-mapped-drive"]}/>}{term.slug==="shadow-copy"&&<p><a href={base+"files/shadow-copies/"}>Explore the recorded shadow-copy inventory →</a></p>}<h2>Related tests and incidents</h2><div class="card-list">{filePilot.incidents.map(s=><a class="system-card" href={base+"incidents/"+s+"/"}><h3>{["fileserver-subnet","group-acl-name-mismatch"].includes(s)?"Unexpected":"Controlled"} · {s.replaceAll("-"," ")}</h3><span class="readmore">Read investigation →</span></a>)}</div></div>}{identityPilot&&<div class="term-block identity-lesson"><h2>Why does the company need it?</h2><h3 class="file-problem">Problem</h3><p>{identityPilot.problem}</p><h3 class="file-solution">Solution</h3><p>{identityPilot.solution}</p>{identityPilot.sections.map(([heading,body])=><section class="identity-subsection"><h2>{heading}</h2><p>{body}</p></section>)}<h2>Explore how it connects</h2><div class="card-list">{identityPilot.links.map(([name,route])=><a class="system-card" href={base+route}><h3>{name}</h3><span class="readmore">Explore →</span></a>)}</div><h2>How was it verified?</h2><p>Read-only diagnostic examples:</p><pre><code>{identityPilot.cmd}</code></pre><p><strong>Expected:</strong> {identityPilot.expected}</p><p><strong>Recorded outcome:</strong> {identityPilot.actual}</p>{identityPilot.images.length>0&&<Files01DocumentImages ids={identityPilot.images}/>}<h2>Related tests and incidents</h2>{identityPilot.incidents.length?<div class="card-list">{identityPilot.incidents.map(slug=><a class="system-card" href={base+"incidents/"+slug+"/"}><h3>Controlled · {slug.replaceAll("-"," ")}</h3><span class="readmore">Read investigation →</span></a>)}</div>:<p>No dedicated full System State restoration incident is documented.</p>}</div>}<div class="term-block term-caution"><span class="term-num">03 / ENGINEERING LIMIT</span><h2>What not to assume</h2><p>{term.watch}</p></div>
      {realImage&&<figure class="term-proof">
        <img src={base+"evidence/"+realImage} alt="Original historical configuration screenshot showing Windows Defender Firewall policy settings in Group Policy" loading="lazy" />
        <figcaption>Windows Defender Firewall configuration in Group Policy. This shows settings; it does not establish effective application on every workstation. </figcaption>
      </figure>}
      {term.slug==="shadow-copy"?<Files01DocumentImages ids={["vss-previous-versions","shadow-copy-previous-it","shadow-copy-two-triggers","shadow-copy-created"]}/>:<OriginalPdfEvidenceGallery subject={"learn/"+term.slug} heading={"Original "+term.word+" screenshots from the journals"} />}
      
      
      {!filePilot&&!identityPilot&&<EngineeringSourceEmbed sourcePath={"docs/"+evidence.primary} title={"Full original "+term.word+" documentation"} />}
      <section class="term-source-index" aria-label="Related original engineering records">
       <span class="eyebrow">Continue into the real source</span>
       <h2>{filePilot||identityPilot?"Engineering journals":"More configuration and recorded tests"}</h2>
       <p>These links go to the <strong>real, published technical documents</strong>. </p>
       {(filePilot||identityPilot)&&<p><a href={base+"pdf-journals/"+(filePilot||identityPilot).pdf+".pdf"}>Open the complete original engineering PDF →</a></p>}<div class="term-source-links">
        {evidence.supporting.map(path=><a href={internalArticle(path,base)}><small>ORIGINAL SOURCE / {path.split("/").at(-1)}</small><strong>{path.replace(/^explore\//,"").replace(/^Documentation\//,"").replace(/\.md$/,"").replaceAll("_"," ")}</strong><span>Read entire document ↗</span></a>)}
        {evidence.journal&&<a class="term-journal" href={internalArticle(evidence.journal,base)}><small>COMPLETE CHANGE REQUEST / ORIGINAL JOURNAL</small><strong>{evidence.journal.split("/").at(-1)?.replace(/\.md$/,"").replaceAll("_"," ")}</strong><span>Read the full original journal on this website ↗</span></a>}
       </div>
      </section>
    </article>
    <aside class="term-aside">
      <div class="sidebox"><h3>Where you can find it</h3>
        <div class="term-related">{related.map(s=><a href={base+"systems/"+s!.slug+"/"}><span>{s!.name.toUpperCase()}</span><span aria-hidden="true">↗</span></a>)}</div>
      </div>
      <div class="sidebox"><h3>Original engineering source</h3>
        <p>Every configuration detail below comes from existing published Nova Corp records.</p>
        <p><a href={internalArticle(evidence.primary,base)}>Read the complete {term.word} reference →</a></p>
        {evidence.journal&&<p><a href={internalArticle(evidence.journal,base)}>Open the actual change-request journal →</a></p>}
        <p><a href={publicDocsRoot+evidence.primary} target="_blank" rel="noopener noreferrer">Compare original GitHub Markdown ↗</a></p>
      </div>
      <div class="sidebox"><h3>Keep exploring</h3><p><a href={base+"glossary/"}>← All technical terms</a></p><p><a href={base+"map/"}>Open the infrastructure explorer ↗</a></p></div>
    </aside>
  </div></section>}
</BaseLayout>

<style>.term-block h2:not(:first-child){margin-top:38px}.term-block p{line-height:1.7;margin-bottom:16px}.term-story .term-block{margin-bottom:40px}.file-problem{color:var(--c-red)}.file-solution{color:var(--c-green)}.term-block h3{margin-top:20px}</style>