---
import Files01DocumentImages from "../../components/Files01DocumentImages.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { techTerms, type Term } from "../../data/techLexicon";
import { systems } from "../../data/model";
import EngineeringSourceEmbed from "../../components/EngineeringSourceEmbed.astro";
import OriginalPdfEvidenceGallery from "../../components/OriginalPdfEvidenceGallery.astro";
import {termEvidence,internalArticle,publicDocsRoot} from "../../data/termEvidence";
export function getStaticPaths(){return techTerms.map(term=>({params:{slug:term.slug},props:{term}}));}
interface Props{term:Term}
const {term}=Astro.props;
const base=import.meta.env.BASE_URL;
const related=term.related.map(id=>systems.find(s=>s.id===id)).filter(Boolean);
const evidence=termEvidence[term.slug];
if(!evidence)throw Error("No repository-backed technical documentation mapped for "+term.slug);

const pilot:Record<string,{problem:string;solution:string;cmd:string;expected:string;actual:string;incidents:string[];subject:string;heading:string;pdf:string}> = {
 smb:{problem:"An IT employee needs a document on a different computer, but copying it by email creates multiple versions.",solution:"SMB lets her workstation open the department share over the network. The server checks her identity and permissions; a reachable connection is not unrestricted access.",cmd:"Test-NetConnection nova-files01 -Port 445\nGet-SmbSession | Format-Table ClientComputerName,ClientUserName,NumOpens,Dialect",expected:"TCP/445 reachable and an authenticated SMB session visible after a persistent connection is opened.",actual:"The deployment tests recorded a successful TCP connection and an administrative SMB 3.1.1 session; ordinary users were denied C$ and D$.",incidents:["fileserver-subnet","dns-client-outage","file-permission-denial"],subject:"systems/nova-files01",heading:"Original SMB and server deployment evidence",pdf:"NovaCorp_CR-008_File_Server_Deployment_Journal"},
 acl:{problem:"IT employees need to edit their own department documents, but other departments should not automatically gain access.",solution:"Windows uses an access control list containing individual access control entries (ACEs). Each entry identifies a user or group and the actions allowed or denied. Nova Corp assigns ordinary IT access to a resource group instead of granting rights individually.",cmd:"Get-SmbShareAccess -Name IT\nicacls \"D:\\NovaData\\IT\"",expected:"The IT resource group has Change at the share and Modify at the folder.",actual:"The incident investigation found a healthy share ACL but an explicit deny on a child folder. Removing only the deny restored access.",incidents:["file-permission-denial","group-acl-name-mismatch"],subject:"incidents/file-permission-denial",heading:"Actual access control evidence",pdf:"Nova_Corp_CR-014_Engineering_Journal_and_Evidence"},
 ntfs:{problem:"An IT employee must not read confidential Finance documents, even when the server is reachable.",solution:"Folder ACLs specify who may read, modify or administer documents. Windows combines them with share permissions. Nova Corp uses departmental resource groups rather than assigning each employee a separate normal ACL.",cmd:'Get-SmbShareAccess -Name IT\nicacls "D:\\NovaData\\IT\\CR014-IncidentLab"',expected:"IT group has Change at the SMB layer; normal inherited Modify at the folder layer. A fault-injected explicit DENY should be identifiable.",actual:"The controlled permission investigation found the healthy share ACL and explicit child-folder denial; removing only that denial restored the employee’s read/write access.",incidents:["file-permission-denial","two-faults-one-symptom"],subject:"incidents/file-permission-denial",heading:"Original permission diagnosis evidence",pdf:"Nova_Corp_CR-014_Engineering_Journal_and_Evidence"},
 dfs:{problem:"Employees should not need to learn new server names whenever storage is moved.",solution:"DFS gives everyone a stable company address. Each department link currently points to one actual SMB share on NOVA-FILES01, so this is not a redundant file-server cluster.",cmd:"Test-Path Z:\\",expected:"The department drive mapped through the namespace is accessible to the authorized user.",actual:"The workstation test records a mapped drive using DFS and Test-Path Z: returning True.",incidents:["dns-client-outage","file-permission-denial"],subject:"files/dfs",heading:"Original namespace and referral evidence",pdf:"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"},
 "shadow-copy":{problem:"An employee overwrites or deletes a file and wants yesterday’s version back.",solution:"Shadow Copies preserve selected earlier versions on the data volume, scheduled at 07:00 and 12:00 in Nova Corp. They supplement, but do not replace, daily Windows backup at 22:00.",cmd:"vssadmin list shadows /for=D:",expected:"Existing recovery points for the data volume are listed. This is a suggested read-only check; a listing alone does not prove recovery.",actual:"The recovery tests verified the earlier IT file’s contents and recorded an earlier Finance document version.",incidents:["backup-target-unavailable"],subject:"learn/shadow-copy",heading:"Original previous-version evidence",pdf:"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"}
};
const filePilot=pilot[term.slug];

const realImage=term.slug==="group-policy"?"05-firewall-gpo-configuration.png":term.slug==="ntfs"?null:null;
---
<BaseLayout title={term.word+" explained"} description={term.brief} breadcrumbs={[{label:"Glossary",href:"glossary/"},{label:term.word}]}>
  <section class="page-head term-head"><div class="container">
    <div class="eyebrow">Plain English / the Nova Corp lab</div>
    <h1>{term.word}</h1>
    <p class="lead">{term.brief}</p>
  </div></section>
  <section class="section compact"><div class="container term-layout">
    <article class="term-story">
      <div class="term-block"><span class="term-num">01 / UNDERSTAND IT</span><h2>What does it actually mean?</h2><p>{term.everyday}</p></div>
      <div class="term-block"><span class="term-num">02 / SEE IT IN THIS LAB</span><h2>An example from Nova Corp</h2><p>{term.example}</p></div>
      {filePilot&&<div class="term-block"><h2>Why does the company need it?</h2><h3 class="file-problem">Problem</h3><p>{filePilot.problem}</p><h3 class="file-solution">Solution</h3><p>{filePilot.solution}</p>{term.slug==="smb"&&<section><h2>Which network port does SMB use?</h2><p>Modern Windows SMB uses TCP port 445. A workstation connects to NOVA-FILES01 on this port to open a network share. The firewall must permit the connection from authorized networks; an open port alone does not grant file access.</p><p><a href={base+"learn/tcp/"}>What is a TCP port?</a> · <a href={base+"learn/acl/"}>How access lists work</a></p></section>}<h2>How was it verified?</h2><pre><code>{filePilot.cmd}</code></pre><p><strong>Expected:</strong> {filePilot.expected}</p><p><strong>Recorded outcome:</strong> {filePilot.actual}</p>{term.slug!=="shadow-copy"&&<Files01DocumentImages ids={term.slug==="smb"?["fileserver-smb-session","fileserver-department-inventory"]:["ntfs","acl"].includes(term.slug)?["permission-explicit-deny","permission-denial-observed","permission-repair-pass"]:["dfs-namespace-gui","dfs-targets-online-audit","dfs-client-mapped-drive"]}/>}{term.slug==="shadow-copy"&&<p><a href={base+"files/shadow-copies/"}>Explore the recorded shadow-copy inventory →</a></p>}<h2>Related tests and incidents</h2><div class="card-list">{filePilot.incidents.map(s=><a class="system-card" href={base+"incidents/"+s+"/"}><h3>{["fileserver-subnet","group-acl-name-mismatch"].includes(s)?"Unexpected":"Controlled"} · {s.replaceAll("-"," ")}</h3><span class="readmore">Read investigation →</span></a>)}</div></div>}<div class="term-block term-caution"><span class="term-num">03 / ENGINEERING LIMIT</span><h2>What not to assume</h2><p>{term.watch}</p></div>
      {realImage&&<figure class="term-proof">
        <img src={base+"evidence/"+realImage} alt="Original historical configuration screenshot showing Windows Defender Firewall policy settings in Group Policy" loading="lazy" />
        <figcaption>Actual saved Windows Defender Firewall GPO configuration. This shows settings; it does not establish effective application on every workstation. <a href={base+"evidence/manifest.json"}>SHA-256 evidence provenance ↗</a></figcaption>
      </figure>}
      {term.slug==="shadow-copy"?<Files01DocumentImages ids={["vss-previous-versions","shadow-copy-previous-it","shadow-copy-two-triggers","shadow-copy-created"]}/>:<OriginalPdfEvidenceGallery subject={"learn/"+term.slug} heading={"Original "+term.word+" screenshots from the journals"} />}
      {term.slug==="active-directory"&&<OriginalPdfEvidenceGallery subject="incidents/dc01-outage" heading="Recorded directory continuity and recovery evidence" limit={2} />}
      {term.slug==="replication"&&<OriginalPdfEvidenceGallery subject="incidents/replication-divergence" heading="Original replication failure and repair screenshots" />}
      {!filePilot&&<EngineeringSourceEmbed sourcePath={"docs/"+evidence.primary} title={"Full original "+term.word+" documentation"} />}
      <section class="term-source-index" aria-label="Related original engineering records">
       <span class="eyebrow">Continue into the real source</span>
       <h2>{filePilot?"Engineering journals":"More configuration and recorded tests"}</h2>
       <p>These links go to the <strong>real, published technical documents</strong>. Any outcome here is a historical observation, not live telemetry.</p>
       {filePilot&&<p><a href={base+"pdf-journals/"+filePilot.pdf+".pdf"}>Open the complete original engineering PDF →</a></p>}<div class="term-source-links">
        {evidence.supporting.map(path=><a href={internalArticle(path,base)}><small>ORIGINAL SOURCE / {path.split("/").at(-1)}</small><strong>{path.replace(/^explore\//,"").replace(/^Documentation\//,"").replace(/\.md$/,"").replaceAll("_"," ")}</strong><span>Read entire document ↗</span></a>)}
        {evidence.journal&&<a class="term-journal" href={internalArticle(evidence.journal,base)}><small>COMPLETE CHANGE REQUEST / ORIGINAL JOURNAL</small><strong>{evidence.journal.split("/").at(-1)?.replace(/\.md$/,"").replaceAll("_"," ")}</strong><span>Read the full original journal on this website ↗</span></a>}
       </div>
      </section>
    </article>
    <aside class="term-aside">
      <div class="sidebox"><h3>Where you can find it</h3>
        <div class="term-related">{related.map(s=><a href={base+"systems/"+s!.slug+"/"}><span>{s!.name.toUpperCase()}</span><span aria-hidden="true">↗</span></a>)}</div>
      </div>
      <div class="sidebox"><h3>Original engineering source</h3>
        <p>Every configuration detail below comes from existing published Nova Corp records.</p>
        <p><a href={internalArticle(evidence.primary,base)}>Read the complete {term.word} reference →</a></p>
        {evidence.journal&&<p><a href={internalArticle(evidence.journal,base)}>Open the actual change-request journal →</a></p>}
        <p><a href={publicDocsRoot+evidence.primary} target="_blank" rel="noopener noreferrer">Compare original GitHub Markdown ↗</a></p>
      </div>
      <div class="sidebox"><h3>Keep exploring</h3><p><a href={base+"glossary/"}>← All technical terms</a></p><p><a href={base+"company/"}>Open the infrastructure explorer ↗</a></p></div>
    </aside>
  </div></section>
</BaseLayout>

<style>.term-block h2:not(:first-child){margin-top:38px}.term-block p{line-height:1.7;margin-bottom:16px}.term-story .term-block{margin-bottom:40px}.file-problem{color:#edb4a2}.file-solution{color:#c6dcb4}.term-block h3{margin-top:20px}</style>