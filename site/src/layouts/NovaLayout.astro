---
import f400 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import f600 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import f700 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/nova2.css";
import NovaHeader from "../components/nova/NovaHeader.astro";
import NovaFooter from "../components/nova/NovaFooter.astro";
import A11yFixes from "../components/nova/A11yFixes.astro";
interface Props { title: string; description: string; current?: string }
const { title, description, current = "" } = Astro.props;
const base = import.meta.env.BASE_URL;
const full = title === "Home" ? "Nova Corp: infrastructure I built, broke and fixed" : title + " · Nova Corp";
---
<!doctype html>
<html lang="en">
<head>
  <link rel="preload" as="font" type="font/woff2" href={f400} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={f600} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={f700} crossorigin />

  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><title>{full}</title>
  <meta property="og:title" content={full} /><meta property="og:description" content={description} /><meta property="og:type" content="website" />
  <meta property="og:image" content="https://novacorp.davideti.dev/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="A line map of the Nova Corp lab: workstation, firewall, domain controllers, file server and Proxmox." />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
  <script is:inline>
    document.documentElement.classList.add("js");
    try { var t = localStorage.getItem("nova-theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <slot name="head" />
</head>
<body class="nv">
  <a class="skip" href="#main">Skip to main content</a>
  <NovaHeader current={current} />
  <main id="main"><slot /></main>
  <NovaFooter />
  <A11yFixes />
  <div id="term-pop" role="tooltip" hidden></div>
  <script is:inline define:vars={{ dataUrl: base + "glossary.json", glossUrl: base + "glossary/" }}>
    // Glossary marks: dotted underline on the first mention per page. Never in headings, links or buttons.
    (function () {
      var marks = [].slice.call(document.querySelectorAll(".term[data-term]"));
      if (!marks.length) return;
      var seen = {}, kept = [];
      marks.forEach(function (m) {
        var id = m.dataset.term;
        if (seen[id] || m.closest("h1,h2,h3,h4,h5,h6,a,button,summary,pre,code")) { m.removeAttribute("tabindex"); m.removeAttribute("role"); m.classList.remove("term"); return; }
        seen[id] = true; kept.push(m);
      });
      if (!kept.length) return;
      var pop = document.getElementById("term-pop"), data = null, current = null;
      function load() { return data ? Promise.resolve(data) : fetch(dataUrl).then(function (r) { return r.json(); }).then(function (d) { data = d; return d; }); }
      function close() { pop.hidden = true; if (current) { current.setAttribute("aria-expanded", "false"); var c = current; current = null; return c; } }
      function open(m) {
        load().then(function (d) {
          var g = d[m.dataset.term]; if (!g) return;
          pop.innerHTML = "<b></b><p></p><p></p><a></a>";
          pop.children[0].textContent = g.term; pop.children[1].textContent = g.short; pop.children[2].textContent = "In Nova Corp: " + g.inNova;
          pop.children[3].textContent = "More in the glossary"; pop.children[3].href = glossUrl + "#" + m.dataset.term;
          pop.hidden = false; current = m; m.setAttribute("aria-expanded", "true");
          var r = m.getBoundingClientRect(), w = Math.min(340, innerWidth - 24);
          pop.style.width = w + "px"; pop.style.left = Math.max(12, Math.min(innerWidth - w - 12, r.left)) + "px"; pop.style.top = (window.scrollY + r.bottom + 8) + "px";
        });
      }
      kept.forEach(function (m) {
        m.setAttribute("aria-expanded", "false");
        m.addEventListener("click", function (e) { e.preventDefault(); if (current === m) close(); else open(m); });
        m.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); if (current === m) close(); else open(m); } });
      });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && current) { var c = close(); if (c) c.focus(); } });
      document.addEventListener("click", function (e) { if (current && !pop.contains(e.target) && !e.target.closest(".term")) close(); });
    })();
  </script>
</body>
</html>
