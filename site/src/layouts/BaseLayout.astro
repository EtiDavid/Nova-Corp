---
import "../styles/global.css";
import "../styles/v4.css";
import "../styles/experience.css";
import "../styles/atelier.css";
import "../styles/sandbox.css";
import "../styles/home-refresh.css";
import "../styles/learning.css";
import "../styles/reference-library.css";
import TechnicalTermAutolinks from "../components/TechnicalTermAutolinks.astro";
import ContextualDocsEmbed from "../components/ContextualDocsEmbed.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
type Crumb = { label: string; href?: string };
interface Props { title: string; description: string; breadcrumbs?: Crumb[]; }
const { title, description, breadcrumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === "Home" ? "Nova Corp — an enterprise infrastructure lab you can explore" : title + " · Nova Corp";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111210" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline>document.documentElement.classList.add("js")</script>
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader />
    <main id="main">
      {breadcrumbs.length > 0 && <div class="container" style="padding-top:25px">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={base}>Home</a>
          {breadcrumbs.map((item) => <><span aria-hidden="true">/</span>{item.href ? <a href={base+item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}
        </nav>
      </div>}
      <slot />
      <ContextualDocsEmbed />
    </main>
    <SiteFooter />
    <TechnicalTermAutolinks />
    <div class="atlas-scroll-progress" aria-hidden="true"></div>
    <script is:inline>
      (function(){
        if (typeof window==="undefined") return;
        var reduced=window.matchMedia("(prefers-reduced-motion: reduce)");
        var targets=[].slice.call(document.querySelectorAll("[data-reveal]"));
        if(targets.length && !reduced.matches && "IntersectionObserver" in window){
          var observer=new IntersectionObserver(function(entries){
            entries.forEach(function(entry){
              if(entry.isIntersecting){
                entry.target.classList.add("is-in-view");
                observer.unobserve(entry.target);
              }
            });
          },{threshold:0.08,rootMargin:"0px 0px -25px 0px"});
          targets.forEach(function(el){
            var rect=el.getBoundingClientRect();
            if(rect.top<innerHeight*0.86)el.classList.add("is-in-view");
            observer.observe(el);
          });
          document.documentElement.classList.add("motion-ready");
        }
        if(reduced.matches)return;
        var scheduled=false;
        function update(){
          scheduled=false;
          var max=document.documentElement.scrollHeight-innerHeight;
          var n=max>0?Math.max(0,Math.min(1,scrollY/max)):0;
          document.documentElement.style.setProperty("--page-progress",n.toFixed(4));
        }
        addEventListener("scroll",function(){if(!scheduled){scheduled=true;requestAnimationFrame(update);}}, {passive:true});
        update();
      })();
    </script>
  </body>
</html>
