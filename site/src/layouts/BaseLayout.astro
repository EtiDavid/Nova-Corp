---
import "../styles/global.css";
import "../styles/v4.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
type Crumb = { label: string; href?: string };
interface Props { title: string; description: string; breadcrumbs?: Crumb[]; }
const { title, description, breadcrumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === "Home" ? "Nova Corp — an enterprise infrastructure lab you can explore" : title + " · Nova Corp";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F8FAFC" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline>document.documentElement.classList.add("js")</script>
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader />
    <main id="main">
      {breadcrumbs.length > 0 && <div class="container" style="padding-top:25px">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href={base}>Home</a>
          {breadcrumbs.map((item) => <><span aria-hidden="true">/</span>{item.href ? <a href={base+item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</>)}
        </nav>
      </div>}
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
