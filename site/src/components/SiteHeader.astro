---
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.replace(base, "/");
const nav = [
  {label:"Explore",href:"explore/"},
  {label:"Directory",href:"directory/"},
  {label:"Policies",href:"policies/"},
  {label:"File Centre",href:"files/"},
  {label:"Network",href:"network/"},
  {label:"Incidents",href:"incidents/"},
  {label:"Recovery",href:"recovery/"},
  {label:"Evidence",href:"sources/"}
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={base} aria-label="Nova Corp home">
      <span class="brand-mark" aria-hidden="true">N/</span>
      <span>Nova Corp<small>Enterprise infrastructure atlas</small></span>
    </a>
    <nav class="topnav" aria-label="Primary navigation">
      {nav.map(item => <a href={base+item.href} aria-current={current.startsWith("/"+item.href)?"page":undefined}>{item.label}</a>)}
    </nav>
    <a href={base+"search/"} class="header-search" aria-label="Search Nova Corp">Search <span aria-hidden="true">⌕</span></a>
    <details class="mobile-nav">
      <summary aria-label="Open navigation menu"><span aria-hidden="true">☰</span> Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href={base}>Home</a>
        {nav.map(item => <a href={base+item.href} aria-current={current.startsWith("/"+item.href)?"page":undefined}>{item.label}</a>)}
        <a href={base+"tour/"}>Guided tour</a>
        <a href={base+"glossary/"}>Glossary</a>
        <a href={base+"search/"}>Search the atlas</a>
      </nav>
    </details>
  </div>
</header>
