---
import Files01DocumentImages from "./Files01DocumentImages.astro";
import EvidencePanel from "./EvidencePanel.astro";
import {linksForSystem} from "../data/policies";
const base=import.meta.env.BASE_URL;
const specs=[["Windows hostname","NOVA-CLIENT.nova.corp"],["Proxmox guest label","nova-client01"],["VM ID","103"],["Hypervisor","NOVA-PROX01"],["CPU","2 vCPU"],["RAM","4 GiB"],["Operating system","Windows 11 Pro"],["IP address","10.10.40.100/24"],["Network","CLIENT / VLAN 40"],["Gateway","10.10.40.1"],["DNS","10.10.20.10, 10.10.20.11"],["Domain","nova.corp"],["Disk","64G Windows system disk"],["Firmware / machine","OVMF / q35"],["NIC / bridge","net0 / vmbr1"]];
const stories: [string,string,string,string[]][]=[["Signing in with a company account","Imagine Moyo needs to sign in to her work computer. Separate local accounts would make access difficult to manage centrally.","NOVA-CLIENT joins nova.corp. Windows discovers a controller through DNS and authenticates the employee through domain services.",["dc02-sysvol-available"]],["Receiving consistent company settings","A newly prepared employee computer needs the company security settings and appropriate desktop configuration.","The workstation belongs to the Workstations OU. Group Policy configures firewall profiles, AutoPlay and the SMBv1 server component; user policies depend on the account signed in.",["gpo-disabled-link"]],["Working with departmental documents","Moyo needs the IT support guide but should not have unrestricted access to confidential company records.","The workstation uses DFS and SMB to open the department folder. The file server checks group-based share and NTFS permissions. The recorded user test confirmed IT allowed and Finance denied.",["dfs-client-mapped-drive","fileserver-client-baseline"]],["Keeping employee traffic separate from management","Staff need company services without unrestricted access to administration interfaces.","The workstation uses CLIENT VLAN 40 and pfSense routes permitted traffic to INFRA VLAN 20. The management-hardening tests checked blocked management paths and working business services.",["subnet-vlan40-positive"]]];
const inside=[["Computer account","AD identity and OU","computers/nova-client/"],["Active Directory","Central sign-in","learn/active-directory/"],["DNS","Service discovery","learn/dns/"],["Kerberos","Authentication tickets","learn/kerberos/"],["Group Policy","Company settings","learn/group-policy/"],["SMB and DFS","Departmental documents","files/"],["CLIENT network","Network placement","network/"]];
const incidents=[["Controlled · Domain controller outage","Moyo signed in and used the IT share while DC01 was offline.","dc01-outage"],["Controlled · DNS client outage","Incorrect DNS prevented access by name.","dns-client-outage"],["Controlled · Folder access denied","An explicit child-folder deny blocked authorized access.","file-permission-denial"],["Controlled · Wallpaper policy link disabled","Missing policy application was traced to its disabled link.","gpo-link-disabled"],["Unexpected · Management access exposure","Client access to management was too broad and rule order was corrected.","firewall-management-exposure"],["Controlled · Two independent faults","DNS failure concealed an authorization fault.","two-faults-one-symptom"]];
const checks=[["IP and DNS configuration","ipconfig /all","CLIENT address 10.10.40.100/24, gateway 10.10.40.1 and both internal DNS servers."],["Domain discovery","nltest /dsgetdc:nova.corp /force","An available Nova Corp domain controller is returned."],["Domain authentication","klist","Valid tickets in an authenticated domain session."],["Applied policies","gpresult /r","The intended eligible user and computer policies appear; run with appropriate privileges."],["File server connectivity","Test-NetConnection nova-files01.nova.corp -Port 445","TcpTestSucceeded: True."],["Authorized IT share",'Test-Path "\\\\nova.corp\\shares\\IT"',"True in Moyo’s authorized session."],["Unauthorized Finance share",'Test-Path "\\\\nova-files01\\Finance"',"Access denied / False in Moyo’s session."]];
const records=[["Group Policy","CR-006_Group_Policy_Management_Beautified"],["Departmental shares","NovaCorp_CR-009_Departmental_Shares_and_Drive_Mapping"],["DFS and Shadow Copies","NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"],["AD resilience","CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"],["Incident exercises","Nova_Corp_CR-014_Engineering_Journal_and_Evidence"]];
---
<section class="section compact"><div class="container grid-main deep-system-profile client-profile"><article>
<section class="content-section"><h2>What is NOVA-CLIENT?</h2><p>NOVA-CLIENT is Nova Corp's Windows 11 employee test workstation. It lets IT verify the company's infrastructure from an employee's perspective: signing in, receiving company settings and opening only authorized documents.</p><p>Its Proxmox guest is named nova-client01; its actual Windows and AD identity is NOVA-CLIENT. They refer to the same machine at different layers.</p><Files01DocumentImages ids={["dfs-client-mapped-drive"]}/><EvidencePanel subject="NOVA-CLIENT workstation overview" requested="A reviewed Windows desktop or System Settings overview of the workstation is still needed."/></section>
<section class="content-section"><h2>Why does Nova Corp need it and what problems does it solve?</h2>{stories.map(([title,problem,solution,images],i)=><div class="pilot-story"><h3>{i+1}. {title}</h3><h4 class="story-label problem-label">Problem</h4><p>{String(problem).split("Moyo").map((part,j)=><Fragment>{j>0&&<a href={base+"people/moyo/"}>Moyo</a>}{part}</Fragment>)}</p><h4 class="story-label solution-label">Solution</h4><p>{solution}</p><Files01DocumentImages ids={images}/></div>)}</section>
<section class="content-section"><h2>Inside this workstation</h2><div class="card-list">{inside.map(([title,desc,route])=><a class="system-card" href={base+route}><h3>{title}</h3><p>{desc}</p><span class="readmore">Explore →</span></a>)}</div></section>
<section class="content-section"><h2>How NOVA-CLIENT connects to Nova Corp</h2></section>
<section class="content-section"><h2>Related tests and incidents</h2><div class="card-list">{incidents.map(([title,desc,slug])=><a class="system-card" href={base+"incidents/"+slug+"/"}><h3>{title}</h3><p>{desc}</p><span class="readmore">Read investigation →</span></a>)}</div></section>
<section class="content-section"><details><summary>Technical checks</summary><p>Run these on NOVA-CLIENT in a domain session. Expected results are what a healthy workstation returns.</p>{checks.map(([title,cmd,expected])=><div class="health-check"><h3>{title}</h3><pre><code>{cmd}</code></pre><p><strong>Expected:</strong> {expected}</p></div>)}</details></section>
<section class="content-section"><details><summary>Related to this workstation</summary>{linksForSystem("nova-client").map(p=><p><a href={base+"policies/"+p.slug+"/"}>{p.name}</a></p>)}<p><a href={base+"directory/ous/workstations/"}>Workstations OU</a></p></details></section>
<section class="content-section"><h2>Engineering journals</h2><div class="card-list">{records.map(([title,slug])=><a class="system-card" href={base+"journals/"+slug+"/"}><h3>{title}</h3><span class="readmore">Read original PDF and text →</span></a>)}</div><p><a href={base+"reference/explore/systems/NOVA-CLIENT/"}>Original workstation record →</a></p><p><a href={base+"reference/explore/virtualization/vms/103/"}>Exact VM configuration →</a></p></section>
</article><aside><div class="sidebox"><h3>Technical Profile</h3><dl class="fact-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></aside></div></section>
<style>.client-profile>*{min-width:0}.client-profile .content-section{margin-bottom:45px;min-width:0}.client-profile p{line-height:1.65;margin:12px 0}.pilot-story{border-top:1px solid var(--line,rgba(150,150,150,.25));padding:24px 0}.story-label{font-size:1rem;letter-spacing:.02em;margin:25px 0 6px}.problem-label{color:var(--c-red)}.solution-label{color:var(--c-green)}.client-flow{padding:20px;background:var(--surface);border:1px solid var(--rule);border-radius:12px;text-align:center}.flow-node{display:grid;gap:5px;padding:15px;border:1px solid var(--rule);border-radius:10px;background:var(--surface);min-width:0;overflow-wrap:anywhere}.flow-node small{font-size:.75rem;color:var(--ink)}.flow-line{padding:12px;font-size:.8rem;color:var(--c-amber)}.flow-line:after{content:"";display:block;height:2px;width:60%;margin:8px auto;background:repeating-linear-gradient(90deg,#bba987 0 8px,transparent 8px 16px);background-size:32px 2px;animation:flow 2s linear infinite}.flow-pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.client-flow figcaption{margin-top:18px;font-size:.82rem;color:var(--ink)}.health-check pre{overflow:auto;max-width:100%}.client-profile summary{cursor:pointer;font-weight:650;padding:12px 0}@keyframes flow{to{background-position:32px 0}}@media(prefers-reduced-motion:reduce){.flow-line:after{animation:none}}@media(max-width:480px){.flow-pair{grid-template-columns:1fr}}</style>
