---
/** Public originals only: exact raw image bytes from previously published
 * source CR-012/013/014 PDFs. These cards do not claim live state.
 */
import Files01DocumentImages from "./Files01DocumentImages.astro";
import approved from "../data/approvedPdfEvidence.json";
interface Props {subject?:string; ids?:string[]; heading?:string; limit?:number}
const {subject,ids,heading="Original screenshots from the engineering journal",limit=30}=Astro.props;
const selected=(ids ? ids.map(id=>{const found=approved.entries.find(image=>image.id===id);if(!found)throw Error("Unknown reviewed PDF image "+id);return found;}) : approved.entries.filter(image=>image.subject===subject)).slice(0,limit);
---
{selected.length>0&&<section class="pdf-evidence-gallery" aria-label={heading}><div class="pdf-evidence-grid"><Files01DocumentImages ids={selected.map(item=>item.id)}/></div></section>}
<style>.pdf-evidence-grid{display:block!important;grid-template-columns:1fr!important}.pdf-evidence-gallery{min-width:0}</style>
