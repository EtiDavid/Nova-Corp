---
/** Public originals only: exact raw image bytes from previously published
 * source CR-012/013/014 PDFs. These cards do not claim live state.
 */
import approved from "../data/approvedPdfEvidence.json";
interface Props {subject:string; heading?:string; limit?:number}
const {subject,heading="Original screenshots from the engineering journal",limit=6}=Astro.props;
const selected=approved.entries.filter(image=>image.subject===subject).slice(0,limit);
const root="https://github.com/EtiDavid/Nova-Corp/blob/main/docs/Documentation/Change-Requests/";
---
{selected.length>0&&<section class="pdf-evidence-gallery" aria-label={heading}>
 <div class="pdf-evidence-heading"><span class="eyebrow">Source-verified / historical lab screenshots</span><h2>{heading}</h2>
 <p>These are original images extracted directly from the published engineering PDF—not generated mockups. Each is tied to the source journal, its exact page, and the recorded test. They document a historical result, not the current live state of the home lab.</p></div>
 <div class="pdf-evidence-grid">
  {selected.map((item)=>{const source=root+item.pdf+"#page="+item.page;const filename=item.id+"."+(item.ext==="jpeg"?"jpg":"png");return <figure class="pdf-evidence-card">
    <a class="pdf-evidence-image" href={"/pdf-evidence/"+filename} target="_blank" rel="noopener noreferrer" aria-label={"Enlarge original screenshot: "+item.title}>
      <img loading="lazy" decoding="async" src={"/pdf-evidence/"+filename} alt={item.alt}/>
      <span aria-hidden="true">Open full-size ↗</span>
    </a>
    <figcaption><strong>{item.title}</strong><p>{item.caption}</p>
    <small>Original PDF page {item.page} · Historical screenshot · <a href={source} target="_blank" rel="noopener noreferrer">See original journal ↗</a></small></figcaption>
  </figure>})}
 </div>
 <p class="pdf-evidence-provenance"><a href="/pdf-evidence/manifest.json">Image SHA-256, source page and original PDF provenance ↗</a></p>
</section>}
