---
interface Props{problem:string;solution:string;nodes?:{icon:string;name:string;detail:string;href?:string}[];caption?:string}
const {problem,solution,nodes=[],caption}=Astro.props;
---
<section class="file-story"><h2>Why does the company need it?</h2><h3 class="problem">Problem</h3><p>{problem}</p><h3 class="solution">Solution</h3><p>{solution}</p>{nodes.length>0&&<figure><div class="steps">{nodes.map((node,i)=><Fragment>{i>0&&<span class="arrow" aria-hidden="true">→</span>}{node.href?<a class="node" href={node.href}><span aria-hidden="true">{node.icon}</span><strong>{node.name}</strong><small>{node.detail}</small></a>:<div class="node"><span aria-hidden="true">{node.icon}</span><strong>{node.name}</strong><small>{node.detail}</small></div>}</Fragment>)}</div>{caption&&<figcaption>{caption}</figcaption>}</figure>}</section>
<style>
.file-story{min-width:0;margin:28px 0}.file-story h3{margin:24px 0 8px;font-size:1.05rem}.problem{color:#edb4a2}.solution{color:#c6dcb4}.file-story p{line-height:1.7}.file-story figure{margin:20px 0 30px;background:#1b201c;border:1px solid #586454;border-radius:10px;padding:18px}.steps{display:flex;align-items:center;gap:10px}.node{min-width:0;flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;padding:12px 7px;background:#282f28;border:1px solid #586454;border-radius:8px;color:#eee9dc!important;text-decoration:none!important;overflow-wrap:anywhere}.node span{font-size:1.8rem}.node strong{font-size:.88rem}.node small{color:#c5cebe;font-size:.75rem;line-height:1.4}.arrow{color:#e5d0ab;animation:step 3s ease-in-out 2}.file-story figcaption{text-align:center;color:#c5cebe;font-size:.8rem;margin-top:14px}@keyframes step{50%{transform:translateX(4px)}}@media(prefers-reduced-motion:reduce){.arrow{animation:none}}@media(max-width:560px){.steps{flex-direction:column}.node{width:100%;box-sizing:border-box}.arrow{transform:rotate(90deg);animation:none}}
</style>
