const incidents=[
["Controlled · Primary domain controller unavailable","DC02 continued providing authentication and shared resources during the deliberate outage.","dc01-outage"],
["Controlled · Directory replication interrupted","A deliberately blocked replication path prevented a new object appearing on the partner; recovery was verified.","replication-divergence"],
