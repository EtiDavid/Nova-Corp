["Company directory","Explore the actual users, groups and OUs","directory/"],
["DNS","Find the address of a computer or domain service","learn/dns/"],
["Kerberos","Authenticate users through tickets","learn/kerberos/"],
["LDAP","Query directory information","learn/ldap/"],
["SYSVOL and NETLOGON","Publish policies and sign-in scripts","learn/sysvol/"],
["Group Policy","Manage company computer and user settings","policies/"],
