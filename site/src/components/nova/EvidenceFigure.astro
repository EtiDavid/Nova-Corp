---
// One captioned screenshot with click-to-enlarge, from the sanitized CR-A figures. Same markup as the inline {{evidence:id}} figures.
import cra from "../../data/craEvidence.json";
interface Props { id: string }
const { id } = Astro.props;
const e: any = cra.entries.find((x: any) => x.id === id);
if (!e) throw new Error("Unknown CR-A evidence id " + id);
const src = import.meta.env.BASE_URL + e.file;
---
<figure class="evfig" id={"ev-" + id}>
  <a href={src} target="_blank" rel="noopener" aria-label={"Open the full-size screenshot: " + e.title}><img src={src} alt={e.alt} width={e.w} height={e.h} loading="lazy" decoding="async" /></a>
  <figcaption><strong>{e.title}</strong> {e.caption} <span class="evsrc">Source: {e.source}. <a href={src} target="_blank" rel="noopener">Open full size</a></span></figcaption>
</figure>
