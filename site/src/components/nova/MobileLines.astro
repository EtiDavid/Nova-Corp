---
import { loadNova, type LineId } from "../../lib/nova";
// Mobile replacement for the map: one vertical list per line, generated from the same data.
const { lines, lineStops, stationById } = await loadNova();
const base = import.meta.env.BASE_URL;
---
<div class="mobile-lines">
  {lines.map((l: any) => (
    <section class={"mline" + (l.id === "recovery" ? " rec" : "")} style={`--c:var(${l.token})`} aria-labelledby={"ml-" + l.id}>
      <h3 id={"ml-" + l.id}><i style={`border-color:var(${l.token})`}></i>{l.name} line</h3>
      <p class="tiny" style="margin:0 0 8px">{l.blurb}</p>
      <ol>{lineStops[l.id].map((id: string) => { const s = stationById(id); return <li><a href={base + "systems/" + s.id + "/"}>{s.name}</a><small>{s.role}</small></li>; })}</ol>
    </section>
  ))}
</div>
