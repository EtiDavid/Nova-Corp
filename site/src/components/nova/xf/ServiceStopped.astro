---
import Explainer from "./Explainer.astro";
import Icons from "./Icons.astro";
const scenarios: any[] = [{ id: "svc", label: "Web interface stops", steps: [
  { say: "Proxmox runs the lab's machines. Its web interface is how I manage it.", do: [{t:"show",ids:["host","l-host","web","l-web","ssh","l-ssh","vms","l-vms"]}] },
  { say: "The web interface stops answering.", why: "I stopped the pveproxy service on purpose.", term:["pveproxy","the service that serves the Proxmox web interface."], do: [{t:"state",id:"web",value:"bad"},{t:"show",ids:["x"]}] },
  { say: "But SSH, the host network and the machines keep working.", why: "Only one service was stopped, not the host.", do: [{t:"state",id:"ssh",value:"good"},{t:"state",id:"vms",value:"good"}] },
  { say: "Starting pveproxy again brings the web interface back.", why: "The service showed active (running) and the browser worked.", do: [{t:"hide",ids:["x"]},{t:"state",id:"web",value:"good"},{t:"show",ids:["ok"]}] },
]}];
---
<Explainer id="xf-service-stop" title="One stopped service, everything else running" intro="The Proxmox web interface outage."
  scenarios={scenarios} alt="Animated diagram: the Proxmox web interface stops while SSH and the virtual machines keep running; restarting the service restores it."
  note="One service stopped on purpose. It does not show how a whole-host failure would be handled." evidence={[{label:"All incidents", href:"/incidents/"}]}>
  <Icons />
  <rect class="band" x="10" y="20" width="780" height="400" rx="12"/>
  <g data-id="host" data-hide><rect class="bubble" x="60" y="90" width="680" height="260" rx="14"/></g><text data-id="l-host" data-hide class="small" x="400" y="76">NOVA-PROX01</text>
  <g data-id="web" data-hide><use href="#ic-globe" x="110" y="160" width="64" height="64"/><circle class="halo" cx="142" cy="192" r="50"/></g><text data-id="l-web" data-hide class="small" x="142" y="252">Web interface</text>
  <g data-id="ssh" data-hide><use href="#ic-lock" x="330" y="160" width="46" height="56"/></g><text data-id="l-ssh" data-hide class="small" x="353" y="252">SSH</text>
  <g data-id="vms" data-hide><use href="#ic-server" x="520" y="150" width="46" height="58"/><use href="#ic-server" x="580" y="150" width="46" height="58"/><use href="#ic-server" x="640" y="150" width="46" height="58"/></g><text data-id="l-vms" data-hide class="small" x="603" y="252">Virtual machines</text>
  <g data-id="x" data-hide><use href="#ic-x" x="170" y="150" width="32" height="32"/></g><g data-id="ok" data-hide><use href="#ic-check" x="170" y="150" width="32" height="32"/></g>
</Explainer>
