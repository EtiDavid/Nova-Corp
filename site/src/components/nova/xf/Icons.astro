---
// Shared drawing kit for the explainer illustrations: flat, rounded, one outline weight.
---
<defs>
  <symbol id="ic-person" viewBox="0 0 40 44"><circle cx="20" cy="13" r="9" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/><path d="M4 42c0-10 7-16 16-16s16 6 16 16z" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/></symbol>
  <symbol id="ic-laptop" viewBox="0 0 100 72"><rect x="14" y="4" width="72" height="46" rx="6" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/><rect x="21" y="11" width="58" height="32" rx="3" style="fill:var(--soft);stroke:var(--ink);stroke-width:2"/><path d="M4 58h92l-8 10H12z" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/></symbol>
  <symbol id="ic-server" viewBox="0 0 90 110"><rect x="4" y="4" width="82" height="102" rx="10" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/><rect x="14" y="16" width="62" height="20" rx="4" style="fill:var(--soft);stroke:var(--ink);stroke-width:2"/><rect x="14" y="44" width="62" height="20" rx="4" style="fill:var(--soft);stroke:var(--ink);stroke-width:2"/><rect x="14" y="72" width="62" height="20" rx="4" style="fill:var(--soft);stroke:var(--ink);stroke-width:2"/><circle cx="66" cy="26" r="4" style="fill:var(--led,var(--ok));stroke:none"/><circle cx="66" cy="54" r="4" style="fill:var(--led,var(--ok));stroke:none"/><circle cx="66" cy="82" r="4" style="fill:var(--led,var(--ok));stroke:none"/></symbol>
  <symbol id="ic-shield" viewBox="0 0 60 70"><path d="M30 4 54 13v22c0 17-11 28-24 32C17 63 6 52 6 35V13z" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/></symbol>
  <symbol id="ic-ticket" viewBox="0 0 70 40"><path d="M4 6h62v10a5 5 0 0 0 0 8v10H4V24a5 5 0 0 0 0-8z" style="fill:#F0B964;stroke:#17202A;stroke-width:2.4"/><path d="M22 10v20" stroke-dasharray="3 3" style="stroke:var(--ink);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round"/></symbol>
  <symbol id="ic-folder" viewBox="0 0 70 56"><path d="M4 12a6 6 0 0 1 6-6h16l8 8h26a6 6 0 0 1 6 6v28a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6z" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/></symbol>
  <symbol id="ic-lock" viewBox="0 0 40 48"><path d="M10 22v-7a10 10 0 0 1 20 0v7" style="stroke:var(--ink);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round" fill="none"/><rect x="4" y="22" width="32" height="22" rx="6" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/><circle cx="20" cy="33" r="3.5" style="fill:var(--led,var(--ok));stroke:none"/></symbol>
  <symbol id="ic-globe" viewBox="0 0 60 60"><circle cx="30" cy="30" r="24" style="fill:var(--surface);stroke:var(--st,var(--ink));stroke-width:2.6;stroke-linejoin:round"/><ellipse cx="30" cy="30" rx="10" ry="24" style="stroke:var(--ink);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round" fill="none"/><path d="M6 30h48M10 18h40M10 42h40" style="stroke:var(--ink);stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round" fill="none"/></symbol>
  <symbol id="ic-check" viewBox="0 0 40 40"><circle cx="20" cy="20" r="18" style="fill:var(--ok);stroke:var(--surface);stroke-width:2"/><path d="m11 21 6 6 12-14" style="stroke:var(--mark,#fff);stroke-width:4;stroke-linecap:round;stroke-linejoin:round" fill="none"/></symbol>
  <symbol id="ic-x" viewBox="0 0 40 40"><circle cx="20" cy="20" r="18" style="fill:var(--broken-fill);stroke:var(--surface);stroke-width:2"/><path d="m12 12 16 16M28 12 12 28" style="stroke:var(--mark,#fff);stroke-width:4;stroke-linecap:round;stroke-linejoin:round" fill="none"/></symbol>
