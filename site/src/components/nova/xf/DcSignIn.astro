---
import Explainer from "./Explainer.astro";
import Icons from "./Icons.astro";
const { start } = Astro.props;
const scenarios: any[] = [
  { id: "signin", label: "Moyo signs in", steps: [
    { say: "Moyo opens her laptop on the CLIENT network and types her password.", why: "Nothing has left the laptop yet.", do: [{t:"show",ids:["moyo","laptop","l-laptop"]},{t:"show",ids:["b1"]}] },
    { say: "The laptop asks DNS: where is a domain controller?", term:["DNS","the lab's phone book. It turns names into addresses."], why: "DNS answers with the controllers it knows about, DC01 and DC02.", do: [{t:"hide",ids:["b1"]},{t:"show",ids:["dc1","dc2","l-dc1","l-dc2","fw"]},{t:"glide",path:"p-dns",dot:"d1",ms:1100,keep:false},{t:"show",ids:["b2"]}] },
    { say: "The laptop proves who Moyo is to DC01 and receives a Kerberos ticket.", term:["Domain controller","a server that knows every account and checks passwords for the whole company."], why: "A ticket is a signed pass. Her password is not sent again after this.", do: [{t:"hide",ids:["b2"]},{t:"glide",path:"p-dc1",dot:"d1",ms:1100,keep:false},{t:"state",id:"dc1",value:"pulse"},{t:"glide",path:"p-dc1",dot:"d2",ms:1100,rev:true,keep:true},{t:"show",ids:["tk1"]}] },
    { say: "She opens a file share. The laptop shows its ticket and asks for one more, for the file server.", term:["Kerberos ticket","a short-lived signed pass. Servers trust it, so the password is not sent again."], why: "A klist on the laptop lists a ticket for cifs/NOVA-FILES01. That is the recorded proof.", do: [{t:"hide",ids:["d2"]},{t:"glide",path:"p-dc1",dot:"d1",ms:900,keep:false},{t:"show",ids:["tk2"]},{t:"show",ids:["files","l-files"]}] },
    { say: "The two controllers keep copies of the directory in step.", term:["Replication","two servers copying changes to each other so both always know the same things."], why: "If one is lost, the other already knows every account.", do: [{t:"glide",path:"p-rep",dot:"d1",ms:1200,keep:false},{t:"glide",path:"p-rep",dot:"d2",ms:1200,rev:true,keep:false},{t:"show",ids:["rep","l-rep"]}] },
  ]},
  { id: "outage", label: "DC01 goes offline", steps: [
    { say: "Everything is working. DC01 is the controller Moyo's laptop has been using.", do: [{t:"show",ids:["moyo","laptop","l-laptop","dc1","dc2","l-dc1","l-dc2","fw","rep","l-rep","files","l-files"]}] },
    { say: "DC01 is turned off for the test (CR-013).", term:["Failover","when one server stops, another takes over its job."], why: "The test is deliberate. It proves the lab survives losing a controller.", do: [{t:"state",id:"dc1",value:"off"},{t:"show",ids:["b3"]}] },
    { say: "The laptop is told to find a controller again.", why: "It forgets DC01 and asks DNS once more.", do: [{t:"hide",ids:["b3"]},{t:"glide",path:"p-dns",dot:"d1",ms:1100,keep:false},{t:"show",ids:["b4"]}] },
    { say: "It chooses DC02 and signs in there.", why: "The recorded check shows the laptop talking to nova-dc02.", do: [{t:"hide",ids:["b4"]},{t:"glide",path:"p-dc2",dot:"d1",ms:1100,keep:false},{t:"state",id:"dc2",value:"good"},{t:"show",ids:["tk1","b5"]}] },
    { say: "DC01 comes back and the two are checked against each other.", why: "Replication was checked afterwards, so nothing was lost while it was away.", do: [{t:"hide",ids:["b5"]},{t:"state",id:"dc1",value:""},{t:"glide",path:"p-rep",dot:"d2",ms:1200,keep:false},{t:"state",id:"dc1",value:"good"}] },
  ]},
];
---
<Explainer id="xf-dc" start={start} title="How a sign-in works, and what happens when DC01 disappears"
  intro="Plays on its own. Pick a story, or click a dot to stop on a step. Based on recorded checks."
  scenarios={scenarios} alt="Animated diagram: a laptop signs in through the firewall to domain controller DC01, gets a Kerberos ticket, and switches to DC02 when DC01 is offline."
  note="This replays what the change records show. The lab has two controllers on a single physical host, so a host failure would take both."
  evidence={[{label:"Change CR-013", href:"/changes/CR-013/"}]}>
  <Icons />
  <rect class="band" x="10" y="10" width="780" height="120" rx="12"/><text class="sub" x="62" y="30" style="text-anchor:start">CLIENT network</text>
  <rect class="band" x="10" y="150" width="780" height="280" rx="12"/><text class="sub" x="62" y="170" style="text-anchor:start">INFRA network</text>
  <path class="guide" data-id="p-dns" d="M150 112 C150 190 330 190 585 290"/>
  <path class="guide" data-id="p-dc1" d="M150 112 L175 290"/>
  <path class="guide" data-id="p-dc2" d="M200 90 C400 90 560 190 585 290"/>
  <path class="guide" data-id="p-rep" d="M230 345 L540 345"/>
  <g data-id="fw" data-hide><use href="#ic-shield" x="300" y="48" width="44" height="52"/><text class="small" x="322" y="116">Firewall</text></g>
  <g data-id="moyo" data-hide><use href="#ic-person" x="40" y="46" width="40" height="44"/><text class="small" x="60" y="108">Moyo</text></g>
  <g data-id="laptop" data-hide><use href="#ic-laptop" x="100" y="40" width="100" height="72"/></g>
  <text data-id="l-laptop" data-hide class="sub" x="150" y="126">Laptop</text>
  <g data-id="dc1" data-hide><use href="#ic-server" x="130" y="290" width="90" height="110"/><circle class="halo" cx="175" cy="345" r="64"/></g>
  <text data-id="l-dc1" data-hide class="lbl" x="175" y="418">DC01</text>
  <g data-id="dc2" data-hide><use href="#ic-server" x="540" y="290" width="90" height="110"/><circle class="halo" cx="585" cy="345" r="64"/></g>
  <text data-id="l-dc2" data-hide class="lbl" x="585" y="418">DC02</text>
  <text data-id="l-rep" data-hide class="small" x="385" y="334">keeps copies in step</text>
  <path data-id="rep" data-hide d="M230 345 L540 345" class="xf-line" stroke-dasharray="2 10"/>
  <g data-id="files" data-hide><use href="#ic-folder" x="356" y="380" width="56" height="46"/></g>
  <text data-id="l-files" data-hide class="sub" x="470" y="408" style="text-anchor:start">File server</text>
  <g data-id="tk1" data-hide><use href="#ic-ticket" x="214" y="40" width="52" height="30"/><text class="sub" x="240" y="86">sign-in ticket</text></g>
  <g data-id="tk2" data-hide><use href="#ic-ticket" x="400" y="40" width="52" height="30"/><text class="sub" x="426" y="86">file-server ticket</text></g>
  <circle data-id="d1" data-dot class="dot" r="9" cx="0" cy="0" fill="var(--accent)"/>
  <circle data-id="d2" data-dot class="dot" r="9" cx="0" cy="0" fill="var(--line-identity)"/>
  <g data-id="b1" data-hide><rect class="bubble" x="214" y="28" width="150" height="34" rx="12"/><text class="bubble-t" x="289" y="50">Typing a password</text></g>
  <g data-id="b2" data-hide><rect class="bubble" x="380" y="196" width="190" height="34" rx="12"/><text class="bubble-t" x="475" y="218">Where is a controller?</text></g>
  <g data-id="b3" data-hide><rect class="bubble" x="20" y="196" width="150" height="34" rx="12"/><text class="bubble-t" x="95" y="218">DC01 is off</text></g>
  <g data-id="b4" data-hide><rect class="bubble" x="380" y="196" width="190" height="34" rx="12"/><text class="bubble-t" x="475" y="218">Find another one</text></g>
  <g data-id="b5" data-hide><rect class="bubble" x="600" y="228" width="170" height="34" rx="12"/><text class="bubble-t" x="685" y="250">Signed in via DC02</text></g>
</Explainer>
