---
// Shared header for every page. `current` highlights the nav item; pages that do not pass it get it from the URL.
interface Props { current?: string; themeToggle?: boolean }
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(base, "/");
const nav = [
  { label: "Incidents", href: "incidents/", key: "incidents" },
  { label: "Map", href: "map/", key: "map" },
  { label: "Changes", href: "changes/", key: "changes" },
  { label: "About", href: "about/", key: "about" }
];
const guess = path.startsWith("/incidents") ? "incidents" : path.startsWith("/changes") || path.startsWith("/journals") ? "changes" : path.startsWith("/about") ? "about" : path === "/" ? "" : "map";
const current = Astro.props.current ?? guess;
const themeToggle = Astro.props.themeToggle ?? true;
const cv = base + "David_Eti_Systems_Infrastructure_CV.pdf";
---
  <header class="nv-head"><div class="wrap bar">
    <a class="nv-logo" href={base} aria-label="Nova Corp, home">
      <svg viewBox="0 0 34 34" aria-hidden="true"><rect x="1" y="1" width="32" height="32" rx="8" fill="var(--ink)"/><path d="M7 24 L13 24 L17 14 L21 14 L27 10" fill="none" stroke="var(--line-network)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="13" cy="24" r="3" fill="var(--paper)"/><circle cx="27" cy="10" r="3" fill="var(--paper)"/></svg>
      <span>Nova Corp</span>
    </a>
    <nav class="nv-nav" aria-label="Primary">
      {nav.map(i => <a href={base + i.href} aria-current={current === i.key ? "page" : undefined}>{i.label}</a>)}
      <a class="nv-btn primary small" href={cv}>Download CV</a>
    </nav>
    {themeToggle && <button class="nv-theme" id="theme-toggle" type="button" aria-label="Switch between light and dark theme"><span aria-hidden="true">◐</span></button>}
    <details class="nv-menu">
      <summary>Menu</summary>
      <nav aria-label="Mobile">
        {nav.map(i => <a href={base + i.href} aria-current={current === i.key ? "page" : undefined}>{i.label}</a>)}
        <a href={cv}>Download CV</a>
      </nav>
    </details>
  </div></header>
