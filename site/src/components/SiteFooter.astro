---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={base}><span class="brand-mark" aria-hidden="true">N/</span><span>Nova Corp<small>Enterprise Lab Atlas</small></span></a>
        <p>A fictional company modeled through a real enterprise-style home lab built and documented by David Eti. Not a production employer or a live management system.</p>
      </div>
      <div class="footer-links">
        <a href={base+"explore/"}>Company map</a>
        <a href={base+"directory/"}>Directory</a>
        <a href={base+"files/"}>File Centre</a>
        <a href={base+"network/"}>Network</a>
        <a href={base+"policies/"}>Company policies</a>
        <a href={base+"incidents/"}>Incident Lab</a>
        <a href={base+"sources/"}>Engineering evidence</a>
        <a href="https://github.com/EtiDavid/Nova-Corp">Engineering source ↗</a>
        <a href="https://davideti.dev/">About David ↗</a>
      </div>
    </div>
    <p class="site-note">Documented configuration snapshot · November 2026 · No live connection to company lab services</p>
  </div>
</footer>
