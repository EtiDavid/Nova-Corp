---
import Files01DocumentImages from "./Files01DocumentImages.astro";
import EvidencePanel from "./EvidencePanel.astro";
import {linksForSystem} from "../data/policies";
const base=import.meta.env.BASE_URL;
const pdf=(name:string)=>base+"pdf-journals/"+name+".pdf";
const records=[
 ["CR-008","File server deployment","NovaCorp_CR-008_File_Server_Deployment_Journal"],
 ["CR-009","Departmental shares and drive mapping","NovaCorp_CR-009_Departmental_Shares_and_Drive_Mapping"],
 ["CR-010","DFS and Shadow Copies","NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"],
 ["CR-012","Windows Server Backup and Recovery","CR-012_Windows_Server_Backup_and_Recovery_Journal"],
 ["CR-014","Incident exercises","Nova_Corp_CR-014_Engineering_Journal_and_Evidence"]];
const inside=[
 ["Company File Centre","Five departments · IT, Finance, HR, Management and Sales","files/"],
 ["Departmental access matrix","Who can access which resources, and how","files/permissions/"],
 ["DFS link targets","Five friendly addresses and actual destinations","files/dfs/"],
 ["Shadow Copy inventory","30 recorded snapshot objects across two volume identifiers","files/shadow-copies/"],
 ["Windows volumes and NovaData","C: Windows · D: company documents · B: backup target","files/volumes/"],
 ["Backup and recovery","Scheduled backup and tested restoration","files/backup/"]];
const incidents=[
 ["Unexpected · Same-VLAN subnet mismatch","Both domain controllers used /32 while the file server used /24. The return path was wrong.","fileserver-subnet"],
 ["Controlled · A folder denies Moyo access","An explicit folder rule blocked an authorized employee.","file-permission-denial"],
 ["Controlled · Backup target unavailable","A missing backup disk interrupted backup; file recovery was verified.","backup-target-unavailable"],
 ["Controlled · DNS client outage","Name-based file access failed despite network reachability.","dns-client-outage"],
 ["Controlled · Domain controller outage","File access was checked through the surviving controller.","dc01-outage"],
 ["Controlled · Two independent faults","Bad name resolution concealed a second authorization fault.","two-faults-one-symptom"]];
const specs=[
 ["Hostname","NOVA-FILES01.nova.corp"],["VM ID","104"],["Hypervisor","NOVA-PROX01"],["CPU","2 vCPU"],["RAM","4 GiB (4096 MiB)"],
 ["Operating system","Windows Server 2025 Standard"],["IP address","10.10.20.20/24"],["Network","INFRA / VLAN 20"],["Gateway","10.10.20.1"],["DNS","10.10.20.10, 10.10.20.11"],
 ["Domain","nova.corp"],["Virtual disks","64 GiB OS · 60 GiB data · 100 GiB backup"],["Windows volumes","C: 63.15 GiB · D: 59.98 GiB · B: 99.98 GiB"],["NIC / bridge","VirtIO / vmbr1"],["Storage controller","VirtIO SCSI single"],
 ["Roles","File Server, DFS Namespace, Windows Server Backup"],["Services","LanmanServer, DFS"],["SMB baseline","SMB1 disabled; SMB2/3 enabled"]];
const policies=linksForSystem("nova-files01");
---
<section class="section compact"><div class="container grid-main deep-system-profile files01-pilot">
<div>
<section class="content-section">
<h2>What is NOVA-FILES01?</h2>
<p>NOVA-FILES01 is the virtual computer that stores Nova Corp's shared company documents. Employees open their team folders from their own workstations instead of collecting copies from each other. It also helps control who can open those files and recover documents when something goes wrong.</p>
<Files01DocumentImages ids={["fileserver-proxmox-hardware","fileserver-department-inventory"]}/><details><summary>Show more images · Server installation</summary><Files01DocumentImages ids={["fileserver-installer-missing-virtio","fileserver-virtio-loaded-disks","fileserver-qemu-guest"]}/></details>
</section>
<section class="content-section">
<h2>Why does the company need it and what problems does it solve?</h2>
<div class="pilot-story">
<h3>1. Sharing documents without passing copies around</h3>
<h4 class="story-label problem-label">Problem</h4><p>Imagine <a href={base+"people/moyo/"}>Moyo</a> in IT needs a colleague's support document. Without a shared folder, the team might email copies or transfer them on flash drives. One person's copy can quickly become outdated.</p><div class={"story-diagram problem"} role="img" aria-label="Illustration: three independent document copies become inconsistent"><div class="diagram-track"><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">▤</span><strong>Email attachment</strong><small>Version 1</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">▤</span><strong>USB copy</strong><small>Version 2</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">▤</span><strong>Local file</strong><small>Which is latest?</small></div></div></div>
<h4 class="story-label solution-label">Solution</h4><p>The IT team stores documents centrally on NOVA-FILES01. <a href={base+"people/moyo/"}>Moyo</a> opens the company file address from a workstation and works on the shared file.</p>
<div class="pilot-flow story-diagram solution" aria-label="Illustrative file access path"><a href={base+"people/moyo/"}><span aria-hidden="true">♙</span>Moyo</a><span aria-hidden="true">→</span><a href={base+"files/dfs/"}><span aria-hidden="true">▣</span>Company address</a><span aria-hidden="true">→</span><a href={base+"files/shares/it/"}><span aria-hidden="true">▤</span>One shared IT file</a></div>
<p><a href={base+"files/"}>Explore the Company File Centre →</a> · <a href={base+"learn/dfs/"}>What is DFS?</a></p>
<Files01DocumentImages ids={["dfs-client-mapped-drive","dfs-targets-online-audit"]}/><details><summary>Show more images · SMB connection</summary><Files01DocumentImages ids={["fileserver-smb-session"]}/></details>
<EvidencePanel subject="Five department folders in File Explorer" requested="A reviewed Explorer view of all five departmental links is still needed. The original target audit above lists all five."/>
</div>
<div class="pilot-story">
<h3>2. Keeping confidential files in the right hands</h3>
<h4 class="story-label problem-label">Problem</h4><p><a href={base+"people/moyo/"}>Moyo</a> needs IT documents, but that does not mean confidential Finance records should be accessible.</p><div class={"story-diagram problem"} role="img" aria-label="Illustration: without access controls an IT employee could see both IT and confidential Finance files"><div class="diagram-track"><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">♙</span><strong>Employee</strong><small>IT</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">▤</span><strong>IT files</strong><small>Needed</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">!</span><strong>Finance files</strong><small>Confidential</small></div></div></div>
<h4 class="story-label solution-label">Solution</h4><p>Nova Corp assigns access through <a href={base+"groups/it-users/"}>department groups</a> and <a href={base+"groups/dl-fs-it-modify/"}>resource groups</a>. Windows checks both <a href={base+"learn/smb/"}>SMB share permissions</a> and <a href={base+"learn/ntfs/"}>NTFS folder permissions</a>. CR-009 and CR-014 recorded the intended access: IT allowed, Finance denied.</p>
<div class="pilot-flow story-diagram solution" aria-label="Recorded IT authorization chain"><a href={base+"people/moyo/"}>Moyo</a><span aria-hidden="true">→</span><a href={base+"groups/it-users/"}>IT_Users</a><span aria-hidden="true">→</span><a href={base+"groups/dl-fs-it-modify/"}>DL_FS_IT_Modify</a><span aria-hidden="true">→</span><a href={base+"files/shares/it/"}>IT folder ✓</a></div><div class="access-outcome"><span>✓ IT allowed</span><span>× Finance denied</span></div>
<div class="paper panel pilot-test"><h4>Two real user-session checks</h4><pre><code>{'Test-Path "\\\\nova-files01\\IT"\nTest-Path "\\\\nova-files01\\Finance"'}</code></pre><p><strong>IT:</strong> True — authorized access. <strong>Finance:</strong> access denied, then False — expected protection. These were recorded in the CR-014 baseline; the image below does not show the final Finance error.</p></div>
<Files01DocumentImages ids={["fileserver-client-baseline","permission-denial-observed"]}/>
<EvidencePanel subject="Finance access denied" requested="The full Finance-denied screenshot from Moyo's baseline session is not in the reviewed public PDF set. The CR-009 access matrix and CR-014 journal record the result."/>
<p><a href={base+"files/permissions/"}>Compare departmental access →</a> · <a href={base+"incidents/file-permission-denial/"}>Investigate the separate controlled folder denial →</a></p>
</div>
<div class="pilot-story">
<h3>3. Recovering a missing or overwritten document</h3>
<h4 class="story-label problem-label">Problem</h4><p>An employee accidentally deletes a spreadsheet or saves the wrong changes just before a meeting.</p><div class={"story-diagram problem"} role="img" aria-label="Illustration: a document is overwritten or deleted before a meeting"><div class="diagram-track"><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">▤</span><strong>Spreadsheet</strong><small>Original</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">!</span><strong>Mistaken edit</strong><small>Deleted / overwritten</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">?</span><strong>Meeting</strong><small>File needed</small></div></div></div>
<h4 class="story-label solution-label">Solution</h4><p><a href={base+"files/shadow-copies/"}>Shadow Copies</a> preserve selected earlier file versions at 07:00 and 12:00. Separately, <a href={base+"files/backup/"}>Windows Server Backup</a> protects the D: data volume to B: every day at 22:00. These are recorded schedules, not live job status.</p><div class={"story-diagram solution"} role="img" aria-label="Illustration: a document is recovered from a previous version or backup"><div class="diagram-track"><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">▤</span><strong>Missing file</strong><small>Request recovery</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">◷</span><strong>Earlier version</strong><small>Or daily backup</small></div><span class="diagram-arrow" aria-hidden="true">→</span><div class="diagram-node"><span class="diagram-icon" aria-hidden="true">✓</span><strong>Recovered file</strong><small>Verify contents</small></div></div></div>
<Files01DocumentImages ids={["vss-previous-versions","fileserver-backup-gui","backup-original-recovered-hash"]}/><details><summary>Show more images · Backup schedule and recovery tests</summary><Files01DocumentImages ids={["fileserver-backup-schedule","fileserver-scheduled-backup-pass","backup-disk-offline","backup-sha256-match"]}/></details>
<p>CR-012 verified a naturally scheduled backup and a deleted-file restoration with matching SHA-256 fingerprints. These recovery mechanisms are inside the nested lab's shared failure domain; neither proves independent off-host disaster recovery.</p>
<p><a href={base+"files/backup/"}>Explore the backup and recovery workflow →</a></p>
</div>
</section>
<section class="content-section"><h2>Inside this server</h2><div class="card-list">{inside.map(([title,description,href])=><a class="system-card" href={base+href}><h3>{title}</h3><p>{description}</p><span class="readmore">Explore →</span></a>)}</div></section>
<section class="content-section"><h2>How the file server connects to Nova Corp</h2><p>Employees open company files from their workstations. The file server uses the domain controllers to identify them, the firewall routes permitted traffic between networks, and Proxmox hosts the virtual server.</p>
<div class="company-connection" aria-label="Simplified Nova Corp file service relationships">
<div class="connection-row"><a class="connection-node" href={base+"systems/nova-client/"}><span aria-hidden="true">▣</span><strong>Employee workstation</strong><small>Opens team files</small></a></div>
<div class="connection-arrow">↓ <a href={base+"systems/nova-fw01/"}>Permitted network traffic</a></div>
<div class="connection-row"><a class="connection-node identity-node" href={base+"systems/nova-dc01/"}><span aria-hidden="true">♙</span><strong>Domain controllers</strong><small>Identity and DNS</small></a><span class="horizontal-arrow" aria-hidden="true">↔</span><a class="connection-node server-node" href={base+"systems/nova-files01/"}><span aria-hidden="true">▤</span><strong>NOVA-FILES01</strong><small>Shared company files</small></a></div>
<div class="connection-arrow">↓ <span>Provides</span></div><div class="connection-row department-row">{["IT","Finance","HR","Management","Sales"].map(name=><a href={base+"files/shares/"+name.toLowerCase()+"/"}>{name}</a>)}</div>
<div class="connection-host"><a href={base+"systems/nova-prox01/"}>NOVA-PROX01</a> · Hosts the virtual file server</div></div>
<p><a href={base+"systems/nova-dc02/"}>Second domain controller</a> · <a href={base+"computers/nova-files01/"}>File server AD computer object</a></p>
</section>
<section class="content-section"><h2>Related tests and incidents</h2><p>These are actual historical lab investigations. Choose one to read the diagnosis, original commands, evidence and repair.</p><div class="card-list">{incidents.map(([title,description,slug])=><a class="system-card" href={base+"incidents/"+slug+"/"}><h3>{title}</h3><p>{description}</p><span class="readmore">Read investigation →</span></a>)}</div></section>
<section class="content-section"><details><summary>Related to the file server</summary><ul class="related-topics">{[["Group Policy","learn/group-policy/"],["SMB","learn/smb/"],["NTFS","learn/ntfs/"],["DFS","learn/dfs/"],["Shadow Copies","learn/shadow-copy/"],["Active Directory","learn/active-directory/"]].map(([label,route])=><li><a href={base+route}>{label}</a></li>)}{policies.map(p=><li><a href={base+"policies/"+p.slug+"/"}>{p.name}</a></li>)}</ul></details></section>
<section class="content-section"><h2>Engineering journals</h2><p>Open the complete original implementation, commands, tests and screenshots, not a generated substitute.</p><div class="card-list">{records.map(([id,title,name])=><a class="system-card" href={base+"journals/"+name+"/"}><small>{id}</small><h3>{title}</h3><span class="readmore">Read original PDF and text →</span></a>)}</div><p class="journal-downloads">{records.map(([id,title,name])=><a href={pdf(name)}>{id} PDF</a>)}</p><p><a href={base+"journals/"}>All original journals →</a></p></section>
</div>
<aside><div class="sidebox"><h3>Technical Profile</h3><dl class="fact-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="muted">Hardware allocation: <a href={base+"reference/explore/virtualization/vms/104/"}>VM 104 recorded configuration</a>. Deployment history: <a href={pdf("NovaCorp_CR-008_File_Server_Deployment_Journal")}>CR-008 PDF</a>.</p></div></aside>
</div></section>
<style>
.files01-pilot{min-width:0}.files01-pilot>div,.files01-pilot aside{min-width:0}.pilot-story{border-top:1px solid var(--line,rgba(150,150,150,.25));padding:24px 0}.pilot-flow{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:18px 0}.pilot-flow a{border:1px solid currentColor;padding:8px 12px;border-radius:8px;overflow-wrap:anywhere}.content-section h3{margin-top:18px}.content-section p{margin:12px 0;line-height:1.65}.pilot-test pre{overflow:auto;max-width:100%}.pilot-test h4{margin:0}.content-section details{margin:14px 0;min-width:0}.content-section summary{cursor:pointer;padding:10px 0;font-weight:600}.fact-list dd{overflow-wrap:anywhere}

.story-label{font-size:1rem;letter-spacing:.02em;margin:25px 0 6px;color:#e7decb}.problem-label{color:#edb4a2}.solution-label{color:#c6dcb4}.story-diagram{background:#20241e;border:1px solid #52594c;border-radius:10px;padding:18px;margin:18px 0 26px}.story-diagram.problem{border-left:3px solid #be846e}.story-diagram.solution{border-left:3px solid #95b78c}.diagram-track{display:flex;align-items:stretch;gap:10px;justify-content:center}.diagram-node{min-width:0;flex:1;text-align:center;display:flex;flex-direction:column;gap:4px;justify-content:center}.diagram-node strong{font-size:.83rem}.diagram-node small{font-size:.74rem;color:#babeb1;overflow-wrap:anywhere}.diagram-icon{font-size:1.7rem;line-height:1.2;color:#e8d3a9}.diagram-arrow{align-self:center;color:#aaa991}.pilot-flow a{display:flex;align-items:center;gap:7px}.pilot-flow a span{font-size:1.4rem}.access-outcome{display:flex;flex-wrap:wrap;gap:14px;margin-top:-12px;font-size:.86rem}.access-outcome span:first-child{color:#b5d9a4}.access-outcome span:last-child{color:#edb4a2}.company-connection{border:1px solid #52594c;border-radius:12px;padding:24px 15px;background:#1e241f;margin:24px 0}.connection-row{display:flex;justify-content:center;gap:10px;align-items:center;min-width:0}.connection-node{flex:0 1 185px;min-width:0;display:flex;flex-direction:column;gap:5px;text-align:center;padding:13px 8px;border:1px solid #686f5e;border-radius:9px;text-decoration:none!important;background:#282d25;overflow-wrap:anywhere}.connection-node span{font-size:1.8rem;line-height:1.1;color:#e5d0a0}.connection-node small{font-size:.73rem;color:#c5c7bb}.server-node{border-color:#c4af79;background:#37372b}.connection-arrow{text-align:center;color:#c2c5b7;font-size:.77rem;padding:12px 0}.horizontal-arrow{color:#b7b8a4}.department-row{flex-wrap:wrap;gap:6px}.department-row a{font-size:.75rem;padding:7px 9px;border:1px solid #626959;border-radius:5px}.connection-host{text-align:center;border-top:1px dashed #6b705f;padding-top:12px;margin-top:19px;font-size:.79rem}.related-topics{columns:2;line-height:1.8;padding-left:20px}.journal-downloads{display:flex;flex-wrap:wrap;gap:12px}.journal-downloads a{font-size:.83rem}.content-section{min-width:0}.files01-pilot .pilot-test pre{box-sizing:border-box;white-space:pre;max-width:100%;overflow-x:auto}@media(max-width:480px){.story-diagram{padding:12px}.diagram-track{gap:5px}.diagram-node strong{font-size:.73rem}.diagram-node small{font-size:.65rem}.diagram-arrow{font-size:.75rem}.connection-node strong{font-size:.82rem}.related-topics{columns:1}}
</style>
