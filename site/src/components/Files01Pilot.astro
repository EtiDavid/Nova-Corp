---
import Files01DocumentImages from "./Files01DocumentImages.astro";
import FileShare from "./nova/xf/FileShare.astro";
import FolderAccess from "./nova/xf/FolderAccess.astro";
import FileService from "./nova/xf/FileService.astro";
import FileRecovery from "./nova/xf/FileRecovery.astro";
import EvidencePanel from "./EvidencePanel.astro";
import {linksForSystem} from "../data/policies";
const base=import.meta.env.BASE_URL;
const pdf=(name:string)=>base+"pdf-journals/"+name+".pdf";
const records=[
 ["CR-008","File server deployment","NovaCorp_CR-008_File_Server_Deployment_Journal"],
 ["CR-009","Departmental shares and drive mapping","NovaCorp_CR-009_Departmental_Shares_and_Drive_Mapping"],
 ["CR-010","DFS and Shadow Copies","NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED"],
 ["CR-012","Windows Server Backup and Recovery","CR-012_Windows_Server_Backup_and_Recovery_Journal"],
 ["CR-014","Incident exercises","Nova_Corp_CR-014_Engineering_Journal_and_Evidence"]];
const inside=[
 ["Company File Center","Five departments · IT, Finance, HR, Management and Sales","files/"],
 ["Departmental access matrix","Who can access which resources, and how","files/permissions/"],
 ["DFS link targets","Five friendly addresses and actual destinations","files/dfs/"],
 ["Shadow Copy inventory","30 recorded snapshot objects across two volume identifiers","files/shadow-copies/"],
 ["Windows volumes and NovaData","C: Windows · D: company documents · B: backup target","files/volumes/"],
 ["Backup and recovery","Scheduled backup and tested restoration","files/backup/"]];
const incidents=[
 ["Unexpected · Same-VLAN subnet mismatch","Both domain controllers were set to /32 and the file server to /24, so replies took the wrong road.","fileserver-subnet"],
 ["Blind test · A folder denies Moyo access","One explicit Deny rule blocked a user who otherwise had access.","file-permission-denial"],
 ["Controlled test · Backup target unavailable","A backup disk went missing. Backup stopped, and I still restored the file.","backup-target-unavailable"],
 ["Blind test · DNS client outage","The share would not open by name, though the server answered on port 445.","dns-client-outage"],
 ["Controlled test · Domain controller outage","DC01 went offline. File access kept working through DC02.","dc01-outage"],
 ["Blind test · Two independent faults","A wrong DNS record hid a second, separate fault.","two-faults-one-symptom"]];
const specs=[
 ["Hostname","NOVA-FILES01.nova.corp"],["VM ID","104"],["Hypervisor","NOVA-PROX01"],["CPU","2 vCPU"],["RAM","4 GiB (4096 MiB)"],
 ["Operating system","Windows Server 2025 Standard"],["IP address","10.10.20.20/24"],["Network","INFRA / VLAN 20"],["Gateway","10.10.20.1"],["DNS","10.10.20.10, 10.10.20.11"],
 ["Domain","nova.corp"],["Virtual disks","64 GiB OS · 60 GiB data · 100 GiB backup"],["Windows volumes","C: 63.15 GiB · D: 59.98 GiB · B: 99.98 GiB"],["NIC / bridge","VirtIO / vmbr1"],["Storage controller","VirtIO SCSI single"],
 ["Roles","File Server, DFS Namespace, Windows Server Backup"],["Services","LanmanServer, DFS"],["SMB baseline","SMB1 disabled; SMB2/3 enabled"]];
const policies=linksForSystem("nova-files01");
---
<section class="section compact"><div class="container grid-main deep-system-profile files01-pilot">
<div>
<section class="content-section">
<h2>What is NOVA-FILES01?</h2>
<p>NOVA-FILES01 stores Nova Corp's shared documents. Employees open their team folder from their own workstation instead of passing copies around. It also decides who may open each folder and lets me bring a lost file back.</p>
<Files01DocumentImages ids={["fileserver-proxmox-hardware","fileserver-department-inventory"]}/><details><summary>Show more images · Server installation</summary><Files01DocumentImages ids={["fileserver-installer-missing-virtio","fileserver-virtio-loaded-disks","fileserver-qemu-guest"]}/></details>
</section>
<section class="content-section">
<h2>Why does Nova Corp need it and what problems does it solve?</h2>
<div class="pilot-story">
<h3>1. Sharing documents without passing copies around</h3>
<h4 class="story-label problem-label">Problem</h4><p>Imagine <a href={base+"people/moyo/"}>Moyo</a> in IT needs a colleague's support guide. Without a shared folder the team emails copies or passes a USB drive, and one copy soon goes out of date.</p><h4 class="story-label solution-label">Solution</h4><p>I built one central file server that stores, shares and backs up company files. Instead of asking for a copy, <a href={base+"people/moyo/"}>Moyo</a> opens the shared IT folder on her workstation and works on the same document as her colleagues, as long as she has permission.</p>
<FileShare />
<p><a href={base+"files/"}>Explore the Company File Center →</a> · <a href={base+"learn/dfs/"}>What is DFS?</a></p>
<Files01DocumentImages ids={["dfs-client-mapped-drive","dfs-targets-online-audit"]}/><details><summary>Show more images · SMB connection</summary><Files01DocumentImages ids={["fileserver-smb-session"]}/></details>
<EvidencePanel subject="Five department folders in File Explorer" requested="A reviewed Explorer view of all five departmental links is still needed. The original target audit above lists all five."/>
</div>
<div class="pilot-story">
<h3>2. Keeping confidential files in the right hands</h3>
<h4 class="story-label problem-label">Problem</h4><p>Finance keeps payslips and financial records. Only authorized Finance staff and management should open them.</p>
<h4 class="story-label solution-label">Solution</h4><p>Nova Corp assigns access through <a href={base+"groups/it-users/"}>department groups</a> and <a href={base+"groups/dl-fs-it-modify/"}>resource groups</a>. When <a href={base+"people/moyo/"}>Moyo</a>, who works in IT, tries to open a Finance or Management folder, Windows checks both the <a href={base+"learn/smb/"}>SMB share permissions</a> and the <a href={base+"learn/ntfs/"}>NTFS folder permissions</a>. She is not on the Finance or Management lists, so Windows refuses. She can still open the IT folder.</p>
<FolderAccess />
<Files01DocumentImages ids={["fileserver-client-baseline"]}/><details><summary>Show more images · Separate permission test</summary><Files01DocumentImages ids={["permission-denial-observed"]}/></details>
<EvidencePanel subject="Moyo's allowed and denied folder access" requested="A clearer workstation screenshot is needed: Moyo opening IT successfully and receiving Access denied when opening Finance or Management."/>
<p><a href={base+"files/permissions/"}>Compare departmental access →</a> · <a href={base+"incidents/file-permission-denial/"}>Investigate the separate controlled folder denial →</a></p>
</div>
<div class="pilot-story">
<h3>3. Recovering a missing or overwritten document</h3>
<FileRecovery />
<h4 class="story-label problem-label">Problem</h4><p>Say I delete a file by mistake, or save over a document and want the old version back.</p>
<h4 class="story-label solution-label">Solution</h4><p>I set the file server to back up company documents, so a deleted file can be restored. It also keeps <a href={base+"files/shadow-copies/"}>Shadow Copies</a>, which save earlier versions of files. With Previous Versions I can go back to a copy from before the change, or restore a deleted file from backup.</p><p>Shadow Copies are scheduled at 07:00 and 12:00, while <a href={base+"files/backup/"}>Windows Server Backup</a> protects the data drive every evening at 22:00.</p>
<Files01DocumentImages ids={["vss-previous-versions","fileserver-backup-gui","backup-original-recovered-hash"]}/><details><summary>Show more images · Backup schedule and recovery tests</summary><Files01DocumentImages ids={["fileserver-backup-schedule","fileserver-scheduled-backup-pass","backup-disk-offline","backup-sha256-match"]}/></details>
<p>I tested a scheduled backup and restored a deleted file. The recovered file matched the original. I have not tested restoring a whole server from backup.</p>
<p><a href={base+"files/backup/"}>Explore the backup and recovery workflow →</a></p>
</div>
</section>
<section class="content-section"><h2>Inside this server</h2><div class="card-list">{inside.map(([title,description,href])=><a class="system-card" href={base+href}><h3>{title}</h3><p>{description}</p><span class="readmore">Explore →</span></a>)}</div></section>
<section class="content-section"><h2>How the file server connects to Nova Corp</h2><p>An employee opens a file from their workstation. The firewall passes the request, the domain controllers confirm who they are, and NOVA-FILES01 checks the permissions. Proxmox runs the server.</p>
<FileService />
<p><a href={base+"systems/nova-dc02/"}>Second domain controller</a> · <a href={base+"computers/nova-files01/"}>File server AD computer object</a></p>
</section>
<section class="content-section"><h2>Related tests and incidents</h2><p>Each of these was tested or broke in the lab. Open one to read what I saw, what I ran and how I fixed it.</p><div class="card-list">{incidents.map(([title,description,slug])=><a class="system-card" href={base+"incidents/"+slug+"/"}><h3>{title}</h3><p>{description}</p><span class="readmore">Read investigation →</span></a>)}</div></section>
<section class="content-section"><details><summary>Technical checks</summary><p>Read-only checks you can run on the file server or an authorized workstation.</p>{[["SMB service","Get-Service LanmanServer","Running"],["Share permissions","Get-SmbShareAccess -Name IT","IT resource group has Change"],["Folder permissions",'icacls "D:\\\\NovaData\\\\IT"',"IT resource group has Modify"],["Network access","Test-NetConnection nova-files01 -Port 445","TcpTestSucceeded: True from an authorized client"],["Backup versions","wbadmin get versions","Expected recovery points are listed"]].map(([title,cmd,result])=><div><h3>{title}</h3><pre style="overflow:auto;max-width:100%"><code>{cmd}</code></pre><p><strong>Expected:</strong> {result}</p></div>)}</details></section><section class="content-section"><details><summary>Related to the file server</summary><ul class="related-topics">{[["Group Policy","learn/group-policy/"],["SMB","learn/smb/"],["NTFS","learn/ntfs/"],["DFS","learn/dfs/"],["Shadow Copies","learn/shadow-copy/"],["Active Directory","learn/active-directory/"]].map(([label,route])=><li><a href={base+route}>{label}</a></li>)}{policies.map(p=><li><a href={base+"policies/"+p.slug+"/"}>{p.name}</a></li>)}</ul></details></section>
<section class="content-section"><h2>Engineering journals</h2><p>The full original journals, with every command, test and screenshot.</p><div class="card-list">{records.map(([id,title,name])=><a class="system-card" href={base+"journals/"+name+"/"}><small>{id}</small><h3>{title}</h3><span class="readmore">Read original PDF and text →</span></a>)}</div><p class="journal-downloads">{records.map(([id,title,name])=><a href={pdf(name)}>{id} PDF</a>)}</p><p><a href={base+"journals/"}>All original journals →</a></p></section>
</div>
<aside><div class="sidebox"><h3>Technical Profile</h3><dl class="fact-list">{specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="muted">Hardware allocation: <a href={base+"reference/explore/virtualization/vms/104/"}>VM 104 recorded configuration</a>. </p></div></aside>
</div></section>
<style>
.files01-pilot{min-width:0}.files01-pilot>div,.files01-pilot aside{min-width:0}.pilot-story{border-top:1px solid var(--line,rgba(150,150,150,.25));padding:24px 0}.pilot-flow{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:18px 0}.pilot-flow a{border:1px solid currentColor;padding:8px 12px;border-radius:8px;overflow-wrap:anywhere}.content-section h3{margin-top:18px}.content-section p{margin:12px 0;line-height:1.65}.pilot-test pre{overflow:auto;max-width:100%}.pilot-test h4{margin:0}.content-section details{margin:14px 0;min-width:0}.content-section summary{cursor:pointer;padding:10px 0;font-weight:600}.fact-list dd{overflow-wrap:anywhere}

.story-label{font-size:1rem;letter-spacing:.02em;margin:25px 0 6px;color:var(--ink)}.problem-label{color:var(--c-red)}.solution-label{color:var(--c-green)}.story-diagram{background:var(--surface);border:1px solid var(--rule);border-radius:10px;padding:18px;margin:18px 0 26px}.story-diagram.problem{border-left:3px solid #be846e}.story-diagram.solution{border-left:3px solid #95b78c}.diagram-track{display:flex;align-items:stretch;gap:10px;justify-content:center}.diagram-node{min-width:0;flex:1;text-align:center;display:flex;flex-direction:column;gap:4px;justify-content:center}.diagram-node strong{font-size:.83rem}.diagram-node small{font-size:.74rem;color:var(--ink);overflow-wrap:anywhere}.diagram-icon{font-size:1.7rem;line-height:1.2;color:var(--c-amber)}.diagram-arrow{align-self:center;color:var(--muted)}.pilot-flow a{display:flex;align-items:center;gap:7px}.pilot-flow a span{font-size:1.4rem}.access-outcome{display:flex;flex-wrap:wrap;gap:14px;margin-top:-12px;font-size:.86rem}.access-outcome span:first-child{color:var(--c-green)}.access-outcome span:last-child{color:var(--c-red)}.company-connection{border:1px solid var(--rule);border-radius:12px;padding:24px 15px;background:var(--surface);margin:24px 0}.connection-row{display:flex;justify-content:center;gap:10px;align-items:center;min-width:0}.connection-node{flex:0 1 185px;min-width:0;display:flex;flex-direction:column;gap:5px;text-align:center;padding:13px 8px;border:1px solid var(--rule);border-radius:9px;text-decoration:none!important;background:var(--surface);overflow-wrap:anywhere}.connection-node span{font-size:1.8rem;line-height:1.1;color:var(--c-amber)}.connection-node small{font-size:.73rem;color:var(--ink)}.server-node{border-color:#c4af79;background:var(--tint-amber)}.connection-arrow{text-align:center;color:var(--ink);font-size:.77rem;padding:12px 0}.horizontal-arrow{color:var(--ink)}.department-row{flex-wrap:wrap;gap:6px}.department-row a{font-size:.75rem;padding:7px 9px;border:1px solid var(--rule);border-radius:5px}.connection-host{text-align:center;border-top:1px dashed var(--rule);padding-top:12px;margin-top:19px;font-size:.79rem}.related-topics{columns:2;line-height:1.8;padding-left:20px}.journal-downloads{display:flex;flex-wrap:wrap;gap:12px}.journal-downloads a{font-size:.83rem}.content-section{min-width:0}.files01-pilot .pilot-test pre{box-sizing:border-box;white-space:pre;max-width:100%;overflow-x:auto}@media(max-width:480px){.story-diagram{padding:12px}.diagram-track{gap:5px}.diagram-node strong{font-size:.73rem}.diagram-node small{font-size:.65rem}.diagram-arrow{font-size:.75rem}.connection-node strong{font-size:.82rem}.related-topics{columns:1}}

.office-scene{margin:24px 0 32px;padding:clamp(12px,2vw,24px);border:1px solid var(--rule);border-radius:12px;background:var(--surface);color:var(--ink);min-width:0}.problem-scene{border-left:3px solid #c18b75}.solution-scene{border-left:3px solid #8eaf85}.office-scene figcaption{text-align:center;color:var(--ink);font-size:.82rem;line-height:1.5;margin-top:18px}.scene-people,.privacy-layout,.permission-flow,.network-middle{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);align-items:center;gap:10px}.scene-person{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px;min-width:0;padding:15px 8px;border:1px solid var(--rule);border-radius:10px;background:var(--surface);color:var(--ink)!important;text-align:center;text-decoration:none!important;overflow-wrap:anywhere}.scene-person strong{font-size:.88rem;color:var(--ink)}.scene-person small,.permission-results small{font-size:.74rem;color:var(--ink);line-height:1.45}.scene-symbol{font-size:2rem;line-height:1.25}.scene-transfer{display:grid;gap:10px;min-width:0;text-align:center}.transfer-line{display:block;color:var(--c-amber);font-size:.75rem;line-height:1.4}.transfer-line b{display:block;font-size:1.35rem;animation:file-flow 2.6s ease-in-out infinite}.transfer-line.reverse b{animation-direction:reverse}.scene-versions{display:flex;gap:10px;justify-content:space-between;margin-top:18px}.scene-versions>div{flex:1;display:flex;flex-direction:column;gap:3px;background:var(--tint-amber);border:1px solid var(--rule);border-radius:7px;padding:10px;text-align:center;font-size:.76rem}.scene-versions strong{color:var(--c-amber)}.scene-file{font-size:.76rem;background:var(--tint-green);padding:6px;border-radius:4px}.server-person{border-color:#a3b88c}.scene-colleague{text-align:center;margin-top:17px;font-size:.8rem}.sensitive-person{border-color:#c18b75}.permission-flow{grid-template-columns:minmax(0,1fr) auto minmax(0,1.25fr) auto minmax(0,1fr)}.flow-arrow{color:var(--c-amber);animation:file-flow 2.6s ease-in-out infinite}.permission-results{display:grid;gap:7px;min-width:0}.permission-results a{display:flex;flex-direction:column;gap:3px;padding:10px 6px;border-radius:6px;border:1px solid;min-width:0;font-size:.75rem;text-decoration:none;overflow-wrap:anywhere}.result-allow{background:var(--tint-green);color:var(--ink)!important;border-color:#789b70!important}.result-deny{background:var(--tint-red);color:var(--c-red)!important;border-color:#a76d62!important}.network-top{display:flex;justify-content:center}.network-top .scene-person{width:min(100%,230px)}.network-middle{grid-template-columns:minmax(0,1.3fr) minmax(0,.65fr) minmax(0,1fr)}.host-frame{border:1px dashed #b5ab83;border-radius:9px;padding:10px;text-align:center;min-width:0;display:grid;gap:7px}.host-name{font-size:.75rem;font-weight:700}.host-frame>small,.identity-link small{font-size:.67rem;color:var(--ink)}.identity-link{text-align:center;display:grid;gap:4px}.identity-link span{font-size:1.6rem;color:var(--c-amber)}.network-link{text-align:center;font-size:.78rem;color:var(--ink);padding:13px 0}.department-row{display:flex;justify-content:center}.network-scene .department-row a{background:var(--tint-green);color:var(--ink)}.network-middle .scene-person>a{font-size:.72rem}.office-scene a:focus-visible{outline:2px solid var(--rule);outline-offset:3px}@keyframes file-flow{0%,100%{opacity:.7;transform:translateX(-2px)}50%{opacity:1;transform:translateX(3px)}}@media(prefers-reduced-motion:reduce){.office-scene *{animation:none!important}}@media(max-width:560px){.scene-people,.privacy-layout,.permission-flow,.network-middle{grid-template-columns:minmax(0,1fr);gap:8px}.scene-person{padding:10px}.scene-transfer{gap:5px}.transfer-line b{display:inline-block;transform:rotate(90deg);animation:none}.flow-arrow{transform:rotate(90deg);animation:none;text-align:center}.identity-link span{transform:rotate(90deg)}.scene-versions{gap:6px}.scene-versions>div{padding:8px}.scene-symbol{font-size:1.7rem}}
</style>
