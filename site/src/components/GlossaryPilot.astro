---
import Files01DocumentImages from "./Files01DocumentImages.astro";
import EvidencePanel from "./EvidencePanel.astro";
import {termEvidence,internalArticle} from "../data/termEvidence";
interface Props {slug:string}
const {slug}=Astro.props;
const base=import.meta.env.BASE_URL;
const data:Record<string,{title:string;intro:string;problem:string;solution:string;sections:string[][];links:string[][];flow:string[][];flowCaption:string;checks:string[][];recorded:string;images:string[];introImages:string[];placeholder:string;incidents:string[][];related:string[][];pdf:string}>={"active-directory":{"title":"Active Directory","intro":"Active Directory (AD) is Nova Corp’s central directory for company accounts, computers and security groups. The directory belongs to the nova.corp domain and is hosted on NOVA-DC01 and NOVA-DC02.","problem":"Imagine Moyo joins the IT department. Without a central directory, IT would have to create separate accounts on each computer she uses, and update each one if she changes department or leaves.","solution":"Nova Corp creates one company account in Active Directory. IT puts Moyo in the IT organizational unit and adds her to IT_Users. Domain-joined computers can authenticate her centrally, and resource groups help define which company files she may access.","sections":[["The company domain","nova.corp is the domain name. DC01 was the first controller; DC02 is an additional writable controller. Both hold directory information and serve company clients."],["Organizational units (OUs)","The 16 documented OUs organize accounts and computers. They also provide places to link Group Policy; OU membership alone does not grant access to a folder."],["Users, computers and security groups","The inventory contains 20 accounts, 62 groups and 4 computer objects. For example, IT_Users collects IT staff, while DL_FS_IT_Modify is the resource group used in the IT folder permissions."],["Authentication and authorization","Kerberos helps verify the employee’s identity. The file server checks the employee’s group memberships against its SMB and NTFS rules. A successful domain sign-in does not grant unrestricted file access."],["Central policies and replication","Group Policy configures eligible users and computers. Directory changes replicate between DC01 and DC02, helping the company continue operating when one controller is unavailable."]],"links":[["Company directory","directory/"],["Security groups","groups/"],["Computer objects","computers/"],["Group Policy","learn/group-policy/"]],"flow":[["💻","NOVA-CLIENT","Finds a controller using DNS","systems/nova-client/"],["🛡️","DC01 / DC02","Hosts AD and authenticates the user","systems/nova-dc01/"],["📁","NOVA-FILES01","Checks group-based access to documents","systems/nova-files01/"]],"flowCaption":"The workstation uses a domain controller to authenticate the employee. The file server then makes its own access decision. DC01 and DC02 replicate directory changes.","checks":[["Find Moyo’s account","Domain controller or management PC with AD tools","Get-ADUser -Identity moyo -Properties Enabled","The account resolves and Enabled is True."],["List IT group members","Domain controller or management PC with AD tools","Get-ADGroupMember -Identity IT_Users","Moyo appears among the recorded IT accounts."],["Discover both controllers","Domain controller or management PC with AD tools","Get-ADDomainController -Filter *","NOVA-DC01 and NOVA-DC02 are listed."],["Check replication","Domain controller","repadmin /replsummary","Zero replication failures."],["Check service discovery","Domain workstation","Resolve-DnsName -Type SRV _ldap._tcp.dc._msdcs.nova.corp","The domain controller LDAP service records resolve."]],"recorded":"The resilience exercise verified service discovery, replication, deleted-object recovery with identity preserved, and client continuity through DC02 during DC01 downtime.","images":["dc02-sysvol-available","dc01-recovery-gpupdate"],"introImages":[],"placeholder":"Active Directory Users and Computers showing the Nova Users OU and employee accounts","incidents":[["Controlled · Domain controller outage","The workstation authenticated through DC02 while DC01 was offline.","dc01-outage"],["Controlled · Replication divergence","A deliberately interrupted replication path was diagnosed and restored.","replication-divergence"],["Controlled · Folder access denied","An explicit child-folder deny blocked an authorized IT user.","file-permission-denial"]],"related":[["DNS","learn/dns/"],["Kerberos","learn/kerberos/"],["LDAP","learn/ldap/"],["SYSVOL","learn/sysvol/"],["NETLOGON","learn/netlogon/"],["Replication","learn/replication/"],["SMB","learn/smb/"]],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"},"dns":{"title":"DNS","intro":"DNS (Domain Name System) helps Nova Corp computers find other computers and services by name. DC01 and DC02 host the internal nova.corp DNS zone. A workstation can find the file server without the employee remembering its IP address.","problem":"Imagine Moyo wants to open the IT shared folder. Without DNS, she would have to remember server IP addresses, and Windows would have difficulty discovering which servers offer domain authentication.","solution":"Nova Corp uses internal DNS on both domain controllers. When Moyo’s workstation asks for nova-files01.nova.corp, DNS returns 10.10.20.20. Windows can then connect to the server and separately check her access.","sections":[["Host records (A records)","An A record maps a name to an IPv4 address. In Nova Corp, nova-files01.nova.corp resolves to 10.10.20.20."],["Service records (SRV records)","Windows uses SRV records to locate services, such as LDAP, Kerberos and Global Catalog. These records help it find a domain controller rather than requiring a fixed server name."],["Internal DNS and pfSense","The domain uses AD-integrated DNS. Domain clients point at internal Nova DNS servers. The pfSense Unbound resolver has a nova.corp override pointing to 10.10.20.10, and an allow ACL for VPN_REMOTE 10.10.60.0/24. That override does not establish a second DC failover target."],["Which network ports does DNS use?","DNS normally uses UDP and TCP port 53. Receiving a valid DNS answer does not establish that the application itself is reachable; SMB, for example, uses TCP 445."]],"links":[["NOVA-DC01","systems/nova-dc01/"],["NOVA-DC02","systems/nova-dc02/"],["Firewall and resolver","systems/nova-fw01/"]],"flow":[["💻","NOVA-CLIENT","Asks for nova-files01.nova.corp","systems/nova-client/"],["🛡️","DC01 / DC02 DNS","Returns 10.10.20.20","systems/nova-dc01/"],["🗄️","NOVA-FILES01","Client connects to returned IP","systems/nova-files01/"]],"flowCaption":"DNS returns the address to the client. The client then connects directly to the file server; the file contents do not travel through DNS.","checks":[["Check client DNS settings","NOVA-CLIENT","ipconfig /all","The configured DNS servers are internal Nova DNS servers."],["Resolve the file server","NOVA-CLIENT","Resolve-DnsName nova-files01.nova.corp","10.10.20.20 is returned."],["Find domain services","NOVA-CLIENT","Resolve-DnsName -Type SRV _ldap._tcp.dc._msdcs.nova.corp","Valid domain controller service records are returned."],["Inspect DNS zones","DC01 or DC02","Get-DnsServerZone","The nova.corp zone is listed."],["Separate DNS from SMB connectivity","NOVA-CLIENT","Test-NetConnection 10.10.20.20 -Port 445","TcpTestSucceeded: True from an authorized client."]],"recorded":"During the controlled DNS failure, name-based file access failed while direct IP connectivity and direct internal DNS queries worked. Correcting the client resolver restored access.","images":["dns-timeout"],"introImages":[],"placeholder":"DNS Manager showing the nova.corp zone and its records","incidents":[["Controlled · DNS client outage","Incorrect client DNS stopped name-based access despite direct IP connectivity.","dns-client-outage"],["Controlled · Two independent faults","Fixing DNS revealed missing IT group membership.","two-faults-one-symptom"]],"related":[["Active Directory","learn/active-directory/"],["LDAP","learn/ldap/"],["Kerberos","learn/kerberos/"],["SMB","learn/smb/"],["TCP ports","learn/tcp/"]],"pdf":"Nova_Corp_CR-014_Engineering_Journal_and_Evidence"},"smb":{"title":"SMB","intro":"SMB (Server Message Block) is the network protocol Nova Corp Windows computers use to open shared files and folders on NOVA-FILES01. Employees can work on company documents without copying them onto every workstation.","problem":"Imagine Moyo needs a colleague’s IT support guide. Sending copies by email or USB makes it difficult to know which version is current.","solution":"Nova Corp shares departmental folders on NOVA-FILES01 using SMB. Moyo opens the IT folder from her workstation and works with the shared document. The server checks her identity and permissions before allowing access.","sections":[["The five company shares","IT, Finance, HR, Management and Sales each have a dedicated share. The company also has a DFS namespace that provides friendly folder addresses."],["Authentication and share permissions","The domain authenticates the employee. NOVA-FILES01 evaluates the SMB share ACL and the NTFS folder ACL for the requested operation. Both layers must permit the operation."],["Moyo’s configured access","IT_Users is nested in DL_FS_IT_Modify. The IT resource group has SMB Change and NTFS Modify. The recorded user-session test confirmed IT allowed and Finance denied."],["Which network port does SMB use?","Modern Windows SMB uses TCP port 445. Nova Corp disabled SMB1 and retained SMB2/3. An administrative session recorded SMB 3.1.1. A reachable port alone does not grant folder access."]],"links":[["Company File Centre","files/"],["IT folder","files/shares/it/"],["Finance folder","files/shares/finance/"],["Permission matrix","files/permissions/"]],"flow":[["💻","NOVA-CLIENT","Requests an IT document","systems/nova-client/"],["🛡️","Domain controller","Authenticates the account","systems/nova-dc01/"],["🗄️","NOVA-FILES01","SMB 445 + NTFS access checks","systems/nova-files01/"]],"flowCaption":"Authentication supports the file request. The client communicates directly with NOVA-FILES01 over SMB; the controller does not relay the document.","checks":[["Check network reachability","NOVA-CLIENT","Test-NetConnection nova-files01.nova.corp -Port 445","TcpTestSucceeded: True."],["List published shares","NOVA-FILES01","Get-SmbShare","The five department shares are listed alongside administrative shares."],["Inspect active connections","NOVA-FILES01","Get-SmbSession | Format-Table ClientComputerName,ClientUserName,NumOpens,Dialect","After an authenticated persistent connection, an appropriate session appears."],["Check share ACL","NOVA-FILES01","Get-SmbShareAccess -Name IT","The IT resource group has Change."],["Check allowed and denied paths","NOVA-CLIENT as Moyo","Test-Path \"\\\\nova.corp\\shares\\IT\"\nTest-Path \"\\\\nova-files01\\Finance\"","IT returns True; Finance is denied (may report Access denied and False)."]],"recorded":"The deployment recorded TCP connectivity and an administrative SMB 3.1.1 session. Moyo’s separate user-session validation confirmed allowed IT access and denied Finance access.","images":["fileserver-smb-session","fileserver-client-baseline"],"introImages":["fileserver-department-inventory"],"placeholder":"","incidents":[["Unexpected · Same-VLAN subnet mismatch","Asymmetric traffic prevented correct connectivity to domain services.","fileserver-subnet"],["Controlled · DNS client outage","Name-based SMB access failed despite direct IP connectivity.","dns-client-outage"],["Controlled · Folder access denied","An explicit NTFS deny prevented access to an IT subfolder.","file-permission-denial"]],"related":[["Active Directory","learn/active-directory/"],["DNS","learn/dns/"],["ACL","learn/acl/"],["NTFS","learn/ntfs/"],["DFS","learn/dfs/"],["TCP ports","learn/tcp/"]],"pdf":"NovaCorp_CR-008_File_Server_Deployment_Journal"}};
const d=data[slug], evidence=termEvidence[slug];
---
<section class="section compact"><div class="container glossary-pilot"><article>
<section class="content-section"><h2>What is {d.title}?</h2><p>{d.intro}</p>{d.introImages.length>0?<Files01DocumentImages ids={d.introImages}/>:<EvidencePanel subject={d.title+" configuration"} requested={d.placeholder}/>}</section>
<section class="content-section"><h2>Why does Nova Corp need it?</h2><div class="pilot-story"><h4 class="story-label problem-label">Problem</h4><p>{d.problem.split("Moyo").map((part,i)=><Fragment>{i>0&&<a href={base+"people/moyo/"}>Moyo</a>}{part}</Fragment>)}</p><h4 class="story-label solution-label">Solution</h4><p>{d.solution.split("Moyo").map((part,i)=><Fragment>{i>0&&<a href={base+"people/moyo/"}>Moyo</a>}{part}</Fragment>)}</p></div></section>
<section class="content-section"><h2>How it works in Nova Corp</h2>{d.sections.map(([title,body])=><div class="pilot-story"><h3>{title}</h3><p>{body.split("Moyo").map((part,i)=><Fragment>{i>0&&<a href={base+"people/moyo/"}>Moyo</a>}{part}</Fragment>)}</p></div>)}<div class="card-list">{d.links.map(([label,route])=><a class="system-card" href={base+route}><h3>{label}</h3><span class="readmore">Explore →</span></a>)}</div></section>
<section class="content-section"><h2>How {d.title} connects to Nova Corp</h2><figure class="glossary-flow"><div class="flow-track">{d.flow.map(([icon,title,detail,route],i)=><Fragment>{i>0&&<div class="flow-arrow" aria-hidden="true">→</div>}<a class="flow-node" href={base+route}><span aria-hidden="true">{icon}</span><strong>{title}</strong><small>{detail}</small></a></Fragment>)}</div>{slug!=="smb"&&<p class="flow-partner"><a href={base+"systems/nova-dc01/"}>NOVA-DC01</a> ↔ <a href={base+"systems/nova-dc02/"}>NOVA-DC02</a> · {slug==="dns"?"Both host internal DNS":"Directory replication"}</p>}<figcaption>{d.flowCaption}</figcaption></figure></section>
<section class="content-section"><details><summary>Technical checks</summary><p>These are diagnostic instructions, not live results. Use the specified system and an authorized account.</p>{d.checks.map(([title,where,command,expected])=><div class="check"><h3>{title}</h3><p><strong>Where:</strong> {where}</p><pre><code>{command}</code></pre><p><strong>Expected:</strong> {expected}</p></div>)}</details><h3>Recorded outcome</h3><p>{d.recorded}</p><Files01DocumentImages ids={d.images}/></section>
<section class="content-section"><h2>Related tests and incidents</h2><div class="card-list">{d.incidents.map(([title,body,route])=><a class="system-card" href={base+"incidents/"+route+"/"}><h3>{title}</h3><p>{body}</p><span class="readmore">Read investigation →</span></a>)}</div></section>
<section class="content-section"><details><summary>Related topics</summary><ul>{d.related.map(([title,route])=><li><a href={base+route}>{title}</a></li>)}</ul></details></section>
<section class="content-section"><h2>Engineering journals</h2><p><a href={base+"pdf-journals/"+d.pdf+".pdf"}>Open the complete original engineering PDF →</a></p>{evidence.journal&&<p><a href={internalArticle(evidence.journal,base)}>Read the original engineering journal →</a></p>}<p><a href={internalArticle(evidence.primary,base)}>Complete original {d.title} reference →</a></p>{evidence.supporting.map(path=><p><a href={internalArticle(path,base)}>{path.split("/").at(-1)?.replace(/\.md$/,"").replaceAll("_"," ")} →</a></p>)}</section>
</article></div></section>
<style>.glossary-pilot{max-width:1040px;margin-inline:auto;min-width:0}.glossary-pilot article{min-width:0}.glossary-pilot .content-section{margin-bottom:48px;min-width:0}.glossary-pilot .content-section p{margin:12px 0;line-height:1.65}.glossary-pilot .content-section h3{margin-top:18px}.pilot-story{border-top:1px solid var(--line,rgba(150,150,150,.25));padding:24px 0}.story-label{font-size:1rem;letter-spacing:.02em;margin:25px 0 6px}.problem-label{color:#edb4a2}.solution-label{color:#c6dcb4}.glossary-flow{margin:24px 0 32px;padding:20px;border:1px solid #4b5448;border-radius:12px;background:#1b201c}.flow-track{display:flex;align-items:center;gap:10px}.flow-node{flex:1;min-width:0;display:grid;text-align:center;gap:6px;padding:15px 8px;border:1px solid #586454;border-radius:10px;background:#282f28;text-decoration:none!important;color:#f2eee3!important;overflow-wrap:anywhere}.flow-node span{font-size:2rem}.flow-node small{font-size:.75rem;color:#c7d0c0}.flow-arrow{color:#e4d0ab;font-size:1.3rem;animation:flow 2s ease-in-out infinite}.flow-partner{text-align:center;font-size:.85rem}.glossary-flow figcaption{text-align:center;color:#c1c8b9;font-size:.82rem;margin-top:18px;line-height:1.5}.check{padding:12px 0;border-bottom:1px solid var(--line,#41443c)}.check pre{max-width:100%;overflow:auto;box-sizing:border-box}.glossary-pilot summary{cursor:pointer;font-weight:650;padding:12px 0}.glossary-pilot details{min-width:0}@keyframes flow{50%{transform:translateX(4px);opacity:.6}}@media(prefers-reduced-motion:reduce){.flow-arrow{animation:none}}@media(max-width:600px){.flow-track{flex-direction:column}.flow-node{width:100%;box-sizing:border-box}.flow-arrow{transform:rotate(90deg);animation:none}}</style>
