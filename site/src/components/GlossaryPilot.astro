---
import Files01DocumentImages from "./Files01DocumentImages.astro";
import EvidencePanel from "./EvidencePanel.astro";
import {techTerms} from "../data/techLexicon";
import {systems} from "../data/model";
import {termEvidence,internalArticle} from "../data/termEvidence";
interface Props {slug:string}
const {slug}=Astro.props;
const base=import.meta.env.BASE_URL;
const data:Record<string,{title:string;intro:string;problem:string;solution:string;sections:string[][];links:string[][];flow:string[][];flowCaption:string;checks:string[][];recorded:string;images:string[];introImages:string[];placeholder:string;incidents:string[][];related:string[][];pdf:string}>={"active-directory":{"title":"Active Directory","intro":"Active Directory (AD) is Nova Corp’s central directory for company accounts, computers and security groups. The directory belongs to the nova.corp domain and is hosted on NOVA-DC01 and NOVA-DC02.","problem":"Imagine Moyo joins the IT department. Without a central directory, IT would have to create separate accounts on each computer she uses, and update each one if she changes department or leaves.","solution":"Nova Corp creates one company account in Active Directory. IT puts Moyo in the IT organizational unit and adds her to IT_Users. Domain-joined computers can authenticate her centrally, and resource groups help define which company files she may access.","sections":[["The company domain","nova.corp is the domain name. DC01 was the first controller; DC02 is an additional writable controller. Both hold directory information and serve company clients."],["Organizational units (OUs)","The 16 documented OUs organize accounts and computers. They also provide places to link Group Policy; OU membership alone does not grant access to a folder."],["Users, computers and security groups","The inventory contains 20 accounts, 62 groups and 4 computer objects. For example, IT_Users collects IT staff, while DL_FS_IT_Modify is the resource group used in the IT folder permissions."],["Authentication and authorization","Kerberos helps verify the employee’s identity. The file server checks the employee’s group memberships against its SMB and NTFS rules. A successful domain sign-in does not grant unrestricted file access."],["Central policies and replication","Group Policy configures eligible users and computers. Directory changes replicate between DC01 and DC02, helping the company continue operating when one controller is unavailable."]],"links":[["Company directory","directory/"],["Security groups","groups/"],["Computer objects","computers/"],["Group Policy","learn/group-policy/"]],"flow":[["💻","NOVA-CLIENT","Finds a controller using DNS","systems/nova-client/"],["🛡️","DC01 / DC02","Hosts AD and authenticates the user","systems/nova-dc01/"],["📁","NOVA-FILES01","Checks group-based access to documents","systems/nova-files01/"]],"flowCaption":"The workstation uses a domain controller to authenticate the employee. The file server then makes its own access decision. DC01 and DC02 replicate directory changes.","checks":[["Find Moyo’s account","Domain controller or management PC with AD tools","Get-ADUser -Identity moyo -Properties Enabled","The account resolves and Enabled is True."],["List IT group members","Domain controller or management PC with AD tools","Get-ADGroupMember -Identity IT_Users","Moyo appears among the recorded IT accounts."],["Discover both controllers","Domain controller or management PC with AD tools","Get-ADDomainController -Filter *","NOVA-DC01 and NOVA-DC02 are listed."],["Check replication","Domain controller","repadmin /replsummary","Zero replication failures."],["Check service discovery","Domain workstation","Resolve-DnsName -Type SRV _ldap._tcp.dc._msdcs.nova.corp","The domain controller LDAP service records resolve."]],"recorded":"The resilience exercise verified service discovery, replication, deleted-object recovery with identity preserved, and client continuity through DC02 during DC01 downtime.","images":["dc02-sysvol-available","dc01-recovery-gpupdate"],"introImages":[],"placeholder":"Active Directory Users and Computers showing the Nova Users OU and employee accounts","incidents":[["Controlled · Domain controller outage","The workstation authenticated through DC02 while DC01 was offline.","dc01-outage"],["Controlled · Replication divergence","A deliberately interrupted replication path was diagnosed and restored.","replication-divergence"],["Controlled · Folder access denied","An explicit child-folder deny blocked an authorized IT user.","file-permission-denial"]],"related":[["DNS","learn/dns/"],["Kerberos","learn/kerberos/"],["LDAP","learn/ldap/"],["SYSVOL","learn/sysvol/"],["NETLOGON","learn/netlogon/"],["Replication","learn/replication/"],["SMB","learn/smb/"]],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal"},"dns":{"title":"DNS","intro":"DNS (Domain Name System) helps Nova Corp computers find other computers and services by name. DC01 and DC02 host the internal nova.corp DNS zone. A workstation can find the file server without the employee remembering its IP address.","problem":"Imagine Moyo wants to open the IT shared folder. Without DNS, she would have to remember server IP addresses, and Windows would have difficulty discovering which servers offer domain authentication.","solution":"Nova Corp uses internal DNS on both domain controllers. When Moyo’s workstation asks for nova-files01.nova.corp, DNS returns 10.10.20.20. Windows can then connect to the server and separately check her access.","sections":[["Host records (A records)","An A record maps a name to an IPv4 address. In Nova Corp, nova-files01.nova.corp resolves to 10.10.20.20."],["Service records (SRV records)","Windows uses SRV records to locate services, such as LDAP, Kerberos and Global Catalog. These records help it find a domain controller rather than requiring a fixed server name."],["Internal DNS and pfSense","The domain uses AD-integrated DNS. Domain clients point at internal Nova DNS servers. The pfSense Unbound resolver has a nova.corp override pointing to 10.10.20.10, and an allow ACL for VPN_REMOTE 10.10.60.0/24. That override does not establish a second DC failover target."],["Which network ports does DNS use?","DNS normally uses UDP and TCP port 53. Receiving a valid DNS answer does not establish that the application itself is reachable; SMB, for example, uses TCP 445."]],"links":[["NOVA-DC01","systems/nova-dc01/"],["NOVA-DC02","systems/nova-dc02/"],["Firewall and resolver","systems/nova-fw01/"]],"flow":[["💻","NOVA-CLIENT","Asks for nova-files01.nova.corp","systems/nova-client/"],["🛡️","DC01 / DC02 DNS","Returns 10.10.20.20","systems/nova-dc01/"],["🗄️","NOVA-FILES01","Client connects to returned IP","systems/nova-files01/"]],"flowCaption":"DNS returns the address to the client. The client then connects directly to the file server; the file contents do not travel through DNS.","checks":[["Check client DNS settings","NOVA-CLIENT","ipconfig /all","The configured DNS servers are internal Nova DNS servers."],["Resolve the file server","NOVA-CLIENT","Resolve-DnsName nova-files01.nova.corp","10.10.20.20 is returned."],["Find domain services","NOVA-CLIENT","Resolve-DnsName -Type SRV _ldap._tcp.dc._msdcs.nova.corp","Valid domain controller service records are returned."],["Inspect DNS zones","DC01 or DC02","Get-DnsServerZone","The nova.corp zone is listed."],["Separate DNS from SMB connectivity","NOVA-CLIENT","Test-NetConnection 10.10.20.20 -Port 445","TcpTestSucceeded: True from an authorized client."]],"recorded":"During the controlled DNS failure, name-based file access failed while direct IP connectivity and direct internal DNS queries worked. Correcting the client resolver restored access.","images":["dns-timeout"],"introImages":[],"placeholder":"DNS Manager showing the nova.corp zone and its records","incidents":[["Controlled · DNS client outage","Incorrect client DNS stopped name-based access despite direct IP connectivity.","dns-client-outage"],["Controlled · Two independent faults","Fixing DNS revealed missing IT group membership.","two-faults-one-symptom"]],"related":[["Active Directory","learn/active-directory/"],["LDAP","learn/ldap/"],["Kerberos","learn/kerberos/"],["SMB","learn/smb/"],["TCP ports","learn/tcp/"]],"pdf":"Nova_Corp_CR-014_Engineering_Journal_and_Evidence"},"smb":{"title":"SMB","intro":"SMB (Server Message Block) is the network protocol Nova Corp Windows computers use to open shared files and folders on NOVA-FILES01. Employees can work on company documents without copying them onto every workstation.","problem":"Imagine Moyo needs a colleague’s IT support guide. Sending copies by email or USB makes it difficult to know which version is current.","solution":"Nova Corp shares departmental folders on NOVA-FILES01 using SMB. Moyo opens the IT folder from her workstation and works with the shared document. The server checks her identity and permissions before allowing access.","sections":[["The five company shares","IT, Finance, HR, Management and Sales each have a dedicated share. The company also has a DFS namespace that provides friendly folder addresses."],["Authentication and share permissions","The domain authenticates the employee. NOVA-FILES01 evaluates the SMB share ACL and the NTFS folder ACL for the requested operation. Both layers must permit the operation."],["Moyo’s configured access","IT_Users is nested in DL_FS_IT_Modify. The IT resource group has SMB Change and NTFS Modify. The recorded user-session test confirmed IT allowed and Finance denied."],["Which network port does SMB use?","Modern Windows SMB uses TCP port 445. Nova Corp disabled SMB1 and retained SMB2/3. An administrative session recorded SMB 3.1.1. A reachable port alone does not grant folder access."]],"links":[["Company File Center","files/"],["IT folder","files/shares/it/"],["Finance folder","files/shares/finance/"],["Permission matrix","files/permissions/"]],"flow":[["💻","NOVA-CLIENT","Requests an IT document","systems/nova-client/"],["🛡️","Domain controller","Authenticates the account","systems/nova-dc01/"],["🗄️","NOVA-FILES01","SMB 445 + NTFS access checks","systems/nova-files01/"]],"flowCaption":"Authentication supports the file request. The client communicates directly with NOVA-FILES01 over SMB; the controller does not relay the document.","checks":[["Check network reachability","NOVA-CLIENT","Test-NetConnection nova-files01.nova.corp -Port 445","TcpTestSucceeded: True."],["List published shares","NOVA-FILES01","Get-SmbShare","The five department shares are listed alongside administrative shares."],["Inspect active connections","NOVA-FILES01","Get-SmbSession | Format-Table ClientComputerName,ClientUserName,NumOpens,Dialect","After an authenticated persistent connection, an appropriate session appears."],["Check share ACL","NOVA-FILES01","Get-SmbShareAccess -Name IT","The IT resource group has Change."],["Check permitted IT path","NOVA-CLIENT as Moyo","Test-Path \"\\\\nova.corp\\shares\\IT\"","True."],["Check unauthorized Finance path","NOVA-CLIENT as Moyo","Test-Path \"\\\\nova-files01\\Finance\"","Access denied or False."]],"recorded":"The deployment recorded TCP connectivity and an administrative SMB 3.1.1 session. Moyo’s separate user-session validation confirmed allowed IT access and denied Finance access.","images":["fileserver-smb-session","fileserver-client-baseline"],"introImages":["fileserver-department-inventory"],"placeholder":"","incidents":[["Unexpected · Same-VLAN subnet mismatch","Asymmetric traffic prevented correct connectivity to domain services.","fileserver-subnet"],["Controlled · DNS client outage","Name-based SMB access failed despite direct IP connectivity.","dns-client-outage"],["Controlled · Folder access denied","An explicit NTFS deny prevented access to an IT subfolder.","file-permission-denial"]],"related":[["Active Directory","learn/active-directory/"],["DNS","learn/dns/"],["ACL","learn/acl/"],["NTFS","learn/ntfs/"],["DFS","learn/dfs/"],["TCP ports","learn/tcp/"]],"pdf":"NovaCorp_CR-008_File_Server_Deployment_Journal"},"ldap":{"title":"LDAP","intro":"LDAP lets authorized tools query objects and attributes in Nova Corp's directory.","problem":"IT needs to look up an employee's directory information and group membership without manually checking every computer.","solution":"LDAP is a protocol that lets an administrative tool query a domain controller for directory objects and attributes. For example, an administrator can look up Moyo's account and discover its group memberships.","sections":[["Directory objects and attributes","An LDAP search can return users, computers, groups and attributes. The directory tree contains distinguished names that identify objects."],["LDAP versus Active Directory","AD is the directory service; LDAP is one protocol used to access it. Kerberos provides ticket-based authentication rather than replacing directory queries."],["Network ports and security","Ordinary LDAP uses TCP 389; LDAPS uses TCP 636 when configured. The Global Catalog commonly uses TCP 3268 or 3269 over TLS. These are standard ports, not a claim all were tested here. The documented DC policy has LDAP signing set to None; effective state requires separate verification."]],"links":[["Directory","directory/"],["Kerberos","learn/kerberos/"],["Domain Controller policy","policies/domain-controllers/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"],["📋","Directory objects","Accounts and groups","directory/"]],"flowCaption":"A client queries the controller; authentication and directory queries are separate operations.","checks":[["Find a controller offering LDAP","NOVA-CLIENT","Resolve-DnsName -Type SRV _ldap._tcp.dc._msdcs.nova.corp","Records for the domain controllers are returned."],["Check LDAP connectivity","NOVA-CLIENT","Test-NetConnection NOVA-DC02 -Port 389","TcpTestSucceeded: True on an authorized path."],["Read a directory object","Authorized management PC with AD module","Get-ADUser -Identity moyo -Server NOVA-DC02","Moyo’s account object is returned; the AD module is not a direct LDAP protocol trace."]],"recorded":"During the controlled DC01 outage, the TCP 389 check to DC01 failed while DC02 answered the recorded directory connection check. This is not proof of every possible LDAP bind or query.","images":[],"incidents":[["Controlled · dc01 outage","Clients discovered DC02 while DC01 was offline.","dc01-outage"]],"related":[["kerberos","learn/kerberos/"]],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal","introImages":[],"placeholder":"LDAP configuration screenshot"},"kerberos":{"title":"Kerberos","intro":"Kerberos lets Nova Corp employees authenticate using tickets issued by the domain controllers.","problem":"An employee signs in and then needs to access a file server without typing their password again for every service.","solution":"Windows uses Kerberos tickets issued by the Key Distribution Center on a domain controller. The workstation uses its ticket-granting ticket to request a service ticket for the file server. The server verifies the ticket and separately checks file permissions.","sections":[["Ticket-granting ticket (TGT)","The KDC issues a TGT after authentication. It can be used to request tickets for specific services."],["Service tickets","A service ticket identifies access to a particular service. It does not grant unrestricted access to every folder."],["Ports and time","Kerberos uses TCP or UDP 88. Accurate time and DNS service discovery are important. Nova Corp's saved domain policy specifies a 10-hour user ticket lifetime and five-minute maximum clock skew."]],"links":[["Active Directory","learn/active-directory/"],["DNS","learn/dns/"],["Domain password policy","policies/domain-password/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"]],"flowCaption":"The client obtains a ticket from a controller and presents the service ticket directly to the file server.","checks":[["Inspect cached tickets","NOVA-CLIENT as a domain user","klist","Valid TGT and any requested service tickets are listed."],["Check clock synchronization","NOVA-CLIENT","w32tm /query /status","A valid domain time source and recent successful synchronization."],["Discover a domain controller","NOVA-CLIENT","nltest /dsgetdc:nova.corp","An available domain controller is returned."]],"recorded":"During DC01 failover, fresh tickets identified DC02 as the serving domain controller.","images":["dc02-sysvol-available"],"incidents":[["Controlled · dc01 outage","Clients discovered DC02 while DC01 was offline.","dc01-outage"]],"related":[["active directory","learn/active-directory/"],["dns","learn/dns/"]],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal","introImages":[],"placeholder":"Kerberos configuration screenshot"},"sysvol":{"title":"SYSVOL","intro":"SYSVOL is a shared folder on both controllers containing domain policy files.","problem":"Company workstations need to retrieve the same policy files even if they contact different domain controllers.","solution":"SYSVOL is a shared folder on both controllers. It contains Group Policy file data and other domain material. The controllers synchronize this content so clients can retrieve it from the appropriate server.","sections":[["Where it is located","The domain SYSVOL share is available through the domain controllers; clients use SMB to read it."],["Group Policy","A GPO has information in Active Directory and files in SYSVOL. Both must be accessible for successful processing."],["Replication","Directory replication and SYSVOL file replication are separate mechanisms; both matter for a healthy domain."]],"links":[["NETLOGON","learn/netlogon/"],["Group Policy","learn/group-policy/"],["Replication","learn/replication/"]],"flow":[["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"],["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"]],"flowCaption":"The workstation retrieves policy files from an available controller.","checks":[["Check DC01 SYSVOL","NOVA-CLIENT","Test-Path \"\\\\NOVA-DC01\\SYSVOL\"","True when DC01 is available and the account can access the share."],["Check DC02 SYSVOL","NOVA-CLIENT","Test-Path \"\\\\NOVA-DC02\\SYSVOL\"","True when DC02 is available."],["Check SYSVOL readiness","Domain controller","dcdiag /test:SysVolCheck","The selected SYSVOL check passes."]],"recorded":"The controlled DC01 outage recorded SYSVOL availability through DC02.","images":[],"incidents":[["Controlled · dc01 outage","Clients discovered DC02 while DC01 was offline.","dc01-outage"]],"related":[["netlogon","learn/netlogon/"],["group policy","learn/group-policy/"],["replication","learn/replication/"]],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal","introImages":["dc02-sysvol-available"],"placeholder":"SYSVOL configuration screenshot"},"netlogon":{"title":"NETLOGON","intro":"NETLOGON is a domain controller share used for logon-related files, including the drive-mapping script.","problem":"Moyo needs her department drive to appear when she signs in. Manually configuring a drive on every workstation would be inconvenient.","solution":"IT configured a logon script stored in the domain NETLOGON share. The drive-mapping Group Policy points to that script. The script helps connect the employee to the relevant department folder.","sections":[["The company script","The configured path is \\\\nova.corp\\NETLOGON\\Map-DepartmentDrive.ps1. NETLOGON is a share exposed by domain controllers for logon-related files; it is also associated with a Windows service of the same name."],["How the drive appears","At sign-in, the linked policy can run the script. It maps the appropriate department address, using the DFS namespace. The file server still checks the employee's permissions."],["What to verify","Check the share and script separately, then verify the user session and the mapped drive. A policy link alone is not proof of a successful mapping. SMB uses TCP 445."]],"links":[["Drive-mapping policy","policies/drive-mapping/"],["DFS","files/dfs/"],["SYSVOL","learn/sysvol/"]],"flow":[["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"],["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"]],"flowCaption":"The workstation retrieves the script and connects directly to the file server.","checks":[["Check NETLOGON availability","NOVA-CLIENT","Test-Path \"\\\\NOVA-DC01\\NETLOGON\"","True when DC01 is reachable."],["Check the configured script path","NOVA-CLIENT","Test-Path \"\\\\nova.corp\\NETLOGON\\Map-DepartmentDrive.ps1\"","True if the file is available."],["Verify a mapped drive","NOVA-CLIENT as Moyo","Test-Path Z:\\","True when the authorized drive is mapped and accessible."]],"recorded":"The directory resilience journal records NETLOGON availability on both controllers. The DFS journal documents the mapping script and successful mapped-drive access.","images":["dfs-client-mapped-drive"],"incidents":[["Controlled · dc01 outage","Clients discovered DC02 while DC01 was offline.","dc01-outage"]],"related":[["sysvol","learn/sysvol/"]],"pdf":"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED","introImages":["dfs-netlogon-mapping-hash"],"placeholder":"NETLOGON configuration screenshot"},"group-policy":{"title":"Group Policy","intro":"Group Policy lets Nova Corp configure employee and workstation settings centrally.","problem":"If IT configures every employee's workstation by hand, security settings and desktop configuration can become inconsistent.","solution":"IT creates Group Policy Objects (GPOs) and links them to the appropriate domain or organizational unit. Windows retrieves and applies eligible user and computer settings centrally.","sections":[["User versus computer settings","User policies follow the targeted user account; computer policies target computers. Scope, inheritance, filtering and processing determine the result."],["Nova Corp's seven policies","The documented inventory contains seven GPOs, six linked and one empty/unlinked. They cover passwords, DC protection, wallpaper, department drive mapping, contractor USB restrictions and workstation security, plus an unused keyboard object."],["How a policy reaches a workstation","Windows finds a controller through DNS, reads directory policy information and retrieves policy files from SYSVOL. A configured link is not proof the client actually processed it."],["How IT verifies policy","gpresult reports applied policies. For example, the contractor policy appeared in John Shaw's result; actual physical USB blocking was not fully validated in the nested lab."],["Refreshing policy is a separate action","gpupdate /force requests a policy refresh and can change effective settings. It is not a read-only diagnostic; use it only in an authorized test or approved change."]],"links":[["All seven policies","policies/"],["John Shaw","people/john-shaw/"],["SYSVOL","learn/sysvol/"],["Directory","directory/"]],"flow":[["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"],["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"]],"flowCaption":"Eligible clients process directory policy information and SYSVOL files.","checks":[["Inspect effective user policy","NOVA-CLIENT as the relevant user","gpresult /scope user /r","The applicable user GPOs appear under Applied Group Policy Objects."],["Inspect effective computer policy","NOVA-CLIENT, elevated","gpresult /scope computer /r","The applicable computer baseline appears in the applied list."]],"recorded":"The wallpaper-link controlled incident reproduced a missing policy and restored it. The contractor policy was recorded in gpresult.","images":["gpo-disabled-link"],"incidents":[["Controlled · gpo link disabled","A disabled wallpaper policy link was diagnosed and restored.","gpo-link-disabled"]],"related":[["sysvol","learn/sysvol/"]],"pdf":"CR-006_Group_Policy_Management_Beautified","introImages":[],"placeholder":"Group Policy configuration screenshot"},"replication":{"title":"Active Directory replication","intro":"Replication keeps Nova Corp's two writable domain controllers synchronized.","problem":"An account created on DC01 needs to exist on DC02 as well, otherwise users may receive inconsistent directory information.","solution":"Both writable domain controllers replicate directory changes. IT checks that changes arrive at the partner and repairs replication when it fails.","sections":[["What gets synchronized","Directory objects and attributes are replicated between controllers. SYSVOL content is synchronized separately."],["How to prove convergence","Check replication results and compare the same object on both controllers, not merely their network reachability."],["Controlled divergence","The test prevented inbound replication on DC02. A newly created group remained absent until replication was restored and object GUID/SID matched."]],"links":[["DC01","systems/nova-dc01/"],["DC02","systems/nova-dc02/"],["SYSVOL","learn/sysvol/"]],"flow":[["🛡️","NOVA-DC01","Directory changes","systems/nova-dc01/"],["🛡️","NOVA-DC02","Receives and sends changes","systems/nova-dc02/"]],"flowCaption":"Both writable controllers exchange directory changes.","checks":[["Review replication summary","Domain controller","repadmin /replsummary","Zero replication failures in the healthy baseline."],["Inspect DC02 inbound replication","Domain controller","repadmin /showrepl NOVA-DC02","Each required naming context shows a successful last attempt."],["Compare the same directory object","Authorized management PC","Get-ADUser -Identity moyo -Server NOVA-DC02 | Select-Object Name,ObjectGUID,SID","Compare identity attributes with the same query against DC01; matching identity is the expected result."]],"recorded":"The deliberately interrupted replication was repaired and object identity verified.","images":["replication-rejected-8457","replication-restored"],"incidents":[["Controlled · replication divergence","Interrupted replication was detected and restored.","replication-divergence"]],"related":[["sysvol","learn/sysvol/"]],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal","introImages":[],"placeholder":"Active Directory replication configuration screenshot"},"system-state":{"title":"System State backup","intro":"System State backup protects critical Windows and Active Directory configuration on DC01.","problem":"If a domain controller loses critical Windows directory configuration, the company needs a recovery option beyond keeping another running controller.","solution":"Nova Corp configured a scheduled System State backup on DC01 at 23:00. It protects critical Windows and directory components; it is different from a backup of employee files.","sections":[["What it protects","System State includes important Windows configuration and Active Directory components on a domain controller."],["Recovery points versus recovery tests","Three System State-capable recovery points were recorded. A complete System State restoration has not been demonstrated."],["Where the backups go","The backups go to a separate hard drive outside the lab. That does not by itself prove a whole server can be rebuilt from them."]],"links":[["DC01","systems/nova-dc01/"],["Recovery","recovery/"]],"flow":[["🛡️","NOVA-DC01","Critical Windows and directory configuration","systems/nova-dc01/"],["💾","Backup destination","Recovery points","recovery/"]],"flowCaption":"The backup protects critical components; a full DC restoration remains unproven.","checks":[["Verify the documented service","NOVA-DC01","wbadmin get versions","Available backup versions are listed. This is a read-only check, not a restore."]],"recorded":"The recorded inventory contains three System State-capable recovery points.","images":[],"incidents":[],"related":[],"pdf":"CR-012_Windows_Server_Backup_and_Recovery_Journal","introImages":[],"placeholder":"System State backup configuration screenshot"},"domain-controller":{"title":"Domain Controller","intro":"DC01 and DC02 host Nova Corp's directory and DNS.","problem":"If the company had only one identity server, maintenance could interrupt fresh sign-ins.","solution":"Two writable controllers help clients discover an available controller.","sections":[["Directory services","Both host AD DS and DNS. Kerberos, LDAP, SYSVOL and NETLOGON support employee sign-in and policy."],["Special roles","DC02 held all five FSMO roles, including PDC Emulator, which anchors the domain time hierarchy."],["Resilience","The controlled DC01 outage verified client authentication through DC02."]],"links":[["DC01","systems/nova-dc01/"],["DC02","systems/nova-dc02/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"]],"flowCaption":"Clients discover a controller through DNS; file access is checked separately.","checks":[["Discover controllers","Domain controller","Get-ADDomainController -Filter *","Both controllers are listed."],["Check core services","Domain controller","Get-Service NTDS,DNS,Netlogon,Kdc,W32Time","Listed services are Running."],["Replication","Domain controller","repadmin /replsummary","Zero failures."]],"recorded":"Client continuity and replication convergence were recorded.","images":["dc02-sysvol-available","dc01-recovery-gpupdate"],"incidents":[["Controlled · dc01 outage","Clients discovered DC02 while DC01 was offline.","dc01-outage"],["Controlled · replication divergence","Interrupted replication was detected and restored.","replication-divergence"]],"related":[["active directory","learn/active-directory/"],["dns","learn/dns/"],["kerberos","learn/kerberos/"],["replication","learn/replication/"],["FSMO responsibilities","systems/nova-dc02/#fsmo-roles"]],"pdf":"CR-013_Secondary_Domain_Controller_and_AD_Resilience_Journal","introImages":[],"placeholder":"Domain Controller configuration screenshot"},"acl":{"title":"Access Control List (ACL)","intro":"An ACL contains individual access control entries (ACEs) specifying who may access a resource and what they may do.","problem":"IT staff need their documents without granting every department access.","solution":"Nova Corp assigns rights to resource groups using SMB and NTFS ACLs.","sections":[["Entries and inheritance","An ACE names a principal and permits or denies rights. Inherited entries come from a parent folder."],["Department access","IT_Users is nested in DL_FS_IT_Modify, which has SMB Change and NTFS Modify."],["Finance exception","Management_Users also connects to DL_FS_Finance_FullControl."]],"links":[["Exact permissions","files/permissions/technical/"],["Access matrix","files/permissions/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["👥","Security groups","Group membership","groups/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"]],"flowCaption":"The server compares the user's token with both permission lists.","checks":[["Share ACL","NOVA-FILES01","Get-SmbShareAccess -Name IT","IT resource group has Change."],["Folder ACL","NOVA-FILES01","icacls \"D:\\NovaData\\IT\"","IT resource group has Modify."]],"recorded":"Removing an explicit child-folder deny restored access.","images":["permission-explicit-deny","permission-repair-pass"],"incidents":[["Controlled · file permission denial","An explicit child-folder deny blocked authorized access.","file-permission-denial"],["Unexpected · group acl name mismatch","A group-name comparison error produced a misleading access result.","group-acl-name-mismatch"]],"related":[["smb","learn/smb/"],["ntfs","learn/ntfs/"],["active directory","learn/active-directory/"]],"pdf":"Nova_Corp_CR-014_Engineering_Journal_and_Evidence","introImages":[],"placeholder":"Access Control List (ACL) configuration screenshot"},"ntfs":{"title":"NTFS permissions","intro":"NTFS permissions protect files and folders stored on NOVA-FILES01.","problem":"Moyo can reach the file server but must not automatically read Finance records.","solution":"Windows checks folder ACLs in addition to share ACLs.","sections":[["Modify versus Full Control","Department groups receive Modify via resource groups; the management Finance resource group receives FullControl."],["Inherited and explicit entries","A child folder may inherit its parent's entries or contain explicit entries. An explicit deny prevented the tested access."],["Two layers","Both SMB and NTFS must permit the operation."]],"links":[["Permission matrix","files/permissions/"],["IT folder","files/shares/it/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"],["🔒","NTFS folder","Checks the operation","files/permissions/technical/"]],"flowCaption":"Network access does not bypass the file-system ACL.","checks":[["Inspect folder ACL","NOVA-FILES01","icacls \"D:\\NovaData\\IT\"","IT resource group has Modify."],["Share ACL","NOVA-FILES01","Get-SmbShareAccess -Name IT","IT resource group has Change."]],"recorded":"The controlled denial was isolated and repaired.","images":["permission-denial-observed","permission-explicit-deny","permission-repair-pass"],"incidents":[["Controlled · file permission denial","An explicit child-folder deny blocked authorized access.","file-permission-denial"],["Controlled · two faults one symptom","Incorrect DNS concealed a separate authorization fault.","two-faults-one-symptom"]],"related":[["acl","learn/acl/"],["smb","learn/smb/"]],"pdf":"Nova_Corp_CR-014_Engineering_Journal_and_Evidence","introImages":[],"placeholder":"NTFS permissions configuration screenshot"},"dfs":{"title":"DFS namespace","intro":"Nova Corp uses a domain-based DFS namespace to provide stable folder addresses.","problem":"Employees should not have to learn a new server name when storage moves.","solution":"The namespace directs each department link to its configured SMB target.","sections":[["Company address","The domain namespace is \\\\nova.corp\\shares."],["Five targets","IT, Finance, HR, Management and Sales point to their respective NOVA-FILES01 shares."],["Not file replication","All targets are on one file server; DFS does not bypass permissions."]],"links":[["Five DFS links","files/dfs/"],["File Center","files/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["📂","DFS namespace","Returns target","files/dfs/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"]],"flowCaption":"The client receives a referral and opens the target using SMB.","checks":[["Inspect target","NOVA-FILES01","Get-DfsnFolderTarget -Path '\\\\nova.corp\\shares\\IT'","The IT target is listed."],["Check mapped drive","NOVA-CLIENT as Moyo","Test-Path Z:\\","True when the IT drive is accessible."]],"recorded":"Mapped drive access and a separate offline-target probe were recorded.","images":["dfs-targets-online-audit","dfs-client-mapped-drive"],"incidents":[["Controlled · dns client outage","Incorrect client DNS prevented name-based access.","dns-client-outage"],["Controlled · file permission denial","An explicit child-folder deny blocked authorized access.","file-permission-denial"]],"related":[["smb","learn/smb/"],["dns","learn/dns/"],["ntfs","learn/ntfs/"]],"pdf":"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED","introImages":["dfs-namespace-gui"],"placeholder":"DFS namespace configuration screenshot"},"shadow-copy":{"title":"Shadow Copy","intro":"Shadow Copies preserve earlier versions of files on Nova Corp's data volume.","problem":"An employee overwrites a document and needs the earlier version.","solution":"Previous Versions can retrieve an available snapshot without a full backup restore.","sections":[["Schedule","Two daily triggers at 07:00 and 12:00."],["Recovery points","30 snapshot objects were recorded across two volume identifiers."],["Separate backup","Windows Server Backup protects data at 22:00. VSS may be stopped while idle."]],"links":[["Snapshot inventory","files/shadow-copies/"],["Backup","files/backup/"]],"flow":[["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"],["💾","Earlier versions","Available snapshots","files/shadow-copies/"],["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"]],"flowCaption":"The employee retrieves a saved earlier version.","checks":[["List snapshots","NOVA-FILES01","vssadmin list shadows /for=D:","Available data-volume snapshots are listed."]],"recorded":"An earlier IT file version matched the original fingerprint; a Finance previous version was recorded.","images":["shadow-copy-previous-it","vss-previous-versions","shadow-copy-two-triggers"],"incidents":[["Controlled · backup target unavailable","An offline backup disk interrupted backup; file recovery was verified.","backup-target-unavailable"]],"related":[["smb","learn/smb/"],["system state","learn/system-state/"]],"pdf":"NovaCorp_CR-010_DFS_and_Shadow_Copies_CORRECTED","introImages":["shadow-copy-created"],"placeholder":"Shadow Copy configuration screenshot"},"vlan":{"title":"VLAN","intro":"Nova Corp separates its network into five virtual LANs using Proxmox and pfSense.","problem":"Employee workstations should not have unrestricted access to management.","solution":"VLANs separate logical networks; pfSense controls routed connections.","sections":[["Five networks","MGMT 10, INFRA 20, APP 30, CLIENT 40, DMZ 50. VPN_REMOTE is a tunnel, not a sixth VLAN."],["Placement","DC01, DC02 and FILES01 use VLAN 20; the workstation uses VLAN 40."],["Policy","pfSense provides gateways and evaluates rules; some zones still have broad pass rules."]],"links":[["Network zones","network/"],["Firewall rules","network/rules/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🛡️","NOVA-FW01","Firewall and routing","systems/nova-fw01/"],["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"]],"flowCaption":"Permitted traffic crosses CLIENT 40 to INFRA 20 through pfSense.","checks":[["Client settings","NOVA-CLIENT","ipconfig /all","10.10.40.100/24 and gateway 10.10.40.1."],["Virtual NIC tag","Proxmox shell","qm config 103","net0 uses vmbr1 with tag 40."]],"recorded":"Management paths were blocked while business services continued.","images":[],"incidents":[["Unexpected · firewall management exposure","Overbroad management access was corrected and business services retested.","firewall-management-exposure"]],"related":[["firewall","learn/firewall/"],["proxmox","learn/proxmox/"],["tcp","learn/tcp/"]],"pdf":"change_request_cr002","introImages":["subnet-vlan40-positive"],"placeholder":"VLAN configuration screenshot"},"firewall":{"title":"Firewall","intro":"NOVA-FW01 uses pfSense to route and filter company traffic.","problem":"A workstation needs business services but should not reach protected management tools.","solution":"Ordered firewall rules allow required traffic and block protected destinations.","sections":[["Inventory","17 rules: 13 pass and 4 block."],["CLIENT rule order","GUI ports 80/443 and management network access are blocked before the broader allow."],["Remote access","VPN_REMOTE allows selected services and blocks protected destinations. Stronger isolation is future work."]],"links":[["Rules","network/rules/"],["Aliases","network/aliases/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🛡️","NOVA-FW01","Firewall and routing","systems/nova-fw01/"],["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"]],"flowCaption":"The firewall evaluates incoming traffic before routing permitted connections.","checks":[["Inspect rules","pfSense shell","pfctl -sr","Rules reflect the intended policy."],["Business connectivity","NOVA-CLIENT","Test-NetConnection 10.10.20.20 -Port 445","True from authorized client."]],"recorded":"Management exposure was corrected and business services retested.","images":[],"incidents":[["Unexpected · firewall management exposure","Overbroad management access was corrected and business services retested.","firewall-management-exposure"],["Unexpected · wireguard handshake","Packets reached pfSense but the handshake failed until peer configuration was corrected.","wireguard-handshake"]],"related":[["vlan","learn/vlan/"],["wireguard","learn/wireguard/"],["tcp","learn/tcp/"]],"pdf":"CR-007_Remote_Access_VPN_WireGuard","introImages":[],"placeholder":"Firewall configuration screenshot"},"proxmox":{"title":"Proxmox","intro":"NOVA-PROX01 hosts Nova Corp's firewall, controllers, workstation and file server.","problem":"Separate physical computers for each service would require more hardware.","solution":"Proxmox runs inside VMware Workstation on one Windows host.","sections":[["Six VMs","Five service/workstation guests and one spare."],["Bridges","vmbr0 connects outer management/WAN; vmbr1 connects tagged networks."],["Storage","local, local-lvm and nova-backup contain different storage types; active VM disks are not backup archives."],["Recovery limits","Six archived VM backups and one retained snapshot were recorded. The underlying host is shared."]],"links":[["Hypervisor","systems/nova-prox01/"],["Network","network/"]],"flow":[["🖥️","Windows / VMware","Outer host","systems/nova-prox01/"],["🖥️","NOVA-PROX01","Virtual machine host","systems/nova-prox01/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"]],"flowCaption":"Proxmox runs company guests on shared physical hardware.","checks":[["List guests","Proxmox shell","qm list","Expected VM IDs are listed."],["Storage","Proxmox shell","pvesm status","Stores are available; review capacity."],["Bridges","Proxmox shell","ip -br link","vmbr0 and vmbr1 present."]],"recorded":"Gateway, GUI and snapshot pressure investigations were documented.","images":[],"incidents":[["Controlled · proxmox default gateway","Local connectivity remained while external access failed.","proxmox-default-gateway"],["Controlled · proxmox webgui outage","The web interface failed while SSH and guests remained available.","proxmox-webgui-outage"],["Unexpected · proxmox storage pressure","Retained snapshots consumed thin-pool storage.","proxmox-storage-pressure"]],"related":[["vlan","learn/vlan/"],["firewall","learn/firewall/"]],"pdf":"change_request_cr001","introImages":["fileserver-proxmox-hardware"],"placeholder":"Proxmox configuration screenshot"},"wireguard":{"title":"WireGuard","intro":"WireGuard creates an encrypted tunnel from a remote client to Nova Corp's pfSense firewall.","problem":"A remote employee needs selected services without exposing every internal server.","solution":"The tunnel authenticates the peer; VPN_REMOTE rules restrict destinations.","sections":[["Tunnel","tun_wg0, UDP 51820, MTU 1440; peer 10.10.60.10/32, gateway 10.10.60.1/24."],["Network path","Outer router forwarding, WAN rule, peer authentication and VPN_REMOTE policy matter."],["Limits","Historical handshake repair was verified; separate external-laptop validation remains deferred."]],"links":[["Firewall","systems/nova-fw01/"],["Network","network/"]],"flow":[["💻","Remote laptop","Encrypted tunnel","learn/wireguard/"],["🛡️","NOVA-FW01","Firewall and routing","systems/nova-fw01/"],["🛡️","DC01 / DC02","Directory services","systems/nova-dc01/"]],"flowCaption":"The gateway authenticates the peer and routes permitted traffic.","checks":[["Handshake","pfSense shell","wg show","Configured peer and recent handshake during an active test."],["DNS","Authorized remote client","Resolve-DnsName nova-files01.nova.corp -Server 10.10.20.10","10.10.20.20 when permitted."]],"recorded":"Peer configuration was corrected after packets reached pfSense without a handshake.","images":[],"incidents":[["Unexpected · wireguard handshake","Packets reached pfSense but the handshake failed until peer configuration was corrected.","wireguard-handshake"]],"related":[["firewall","learn/firewall/"],["dns","learn/dns/"],["vlan","learn/vlan/"]],"pdf":"CR-007_Remote_Access_VPN_WireGuard","introImages":[],"placeholder":"WireGuard configuration screenshot"},"tcp":{"title":"TCP port","intro":"TCP ports identify application endpoints on a server.","problem":"","solution":"Nova Corp uses port checks to separate network reachability from authentication and permissions.","sections":[["Examples","SMB TCP 445, LDAP TCP 389, DNS TCP/UDP 53, Kerberos TCP/UDP 88."],["Firewall rules","Destination ports help identify allowed services."],["Interpretation","A successful TCP connection does not prove valid credentials or resource authorization."]],"links":[["Firewall rules","network/rules/"],["SMB","learn/smb/"]],"flow":[["💻","NOVA-CLIENT","Employee workstation","systems/nova-client/"],["🛡️","NOVA-FW01","Firewall and routing","systems/nova-fw01/"],["🗄️","NOVA-FILES01","Company files","systems/nova-files01/"]],"flowCaption":"The client connects to a specific IP and application port.","checks":[["SMB port","NOVA-CLIENT","Test-NetConnection 10.10.20.20 -Port 445","TcpTestSucceeded: True."]],"recorded":"TCP 445 by IP remained reachable during the DNS fault.","images":["dns-timeout"],"incidents":[["Controlled · dns client outage","Incorrect client DNS prevented name-based access.","dns-client-outage"],["Unexpected · fileserver subnet","Mismatched subnet prefixes caused asymmetric traffic.","fileserver-subnet"]],"related":[["smb","learn/smb/"],["ldap","learn/ldap/"],["firewall","learn/firewall/"]],"pdf":"Nova_Corp_CR-014_Engineering_Journal_and_Evidence","introImages":[],"placeholder":"TCP port configuration screenshot"}};
const d=data[slug], evidence=termEvidence[slug];
const locations:Record<string,string[]>={"active-directory":["nova-dc01","nova-dc02"],dns:["nova-dc01","nova-dc02","nova-fw01"],"group-policy":["nova-dc01","nova-dc02","nova-client"]};
const found=(locations[slug]??techTerms.find(t=>t.slug===slug)?.related??[]).flatMap(id=>systems.filter(s=>s.id===id));
---
<section class="section compact"><div class="container grid-main glossary-pilot"><article>
<section class="content-section"><h2>What is {d.title}?</h2><p>{d.intro}</p>{d.introImages.length>0?<Files01DocumentImages ids={d.introImages}/>:d.images.length===0&&slug!=="group-policy"?<EvidencePanel subject={d.title+" configuration"} requested={d.placeholder}/>:null}</section>
{slug==="group-policy"&&<figure class="policy-original"><img src={base+"evidence/05-firewall-gpo-configuration.png"} alt="Original Windows Firewall Group Policy configuration"/><figcaption>Configured Windows Firewall settings in Group Policy, not proof of effective processing on every client.</figcaption></figure>}
<section class="content-section"><h2>Why does Nova Corp need it?</h2><div class="pilot-story">{d.problem&&<><h4 class="story-label problem-label">Problem</h4><p>{d.problem.split("Moyo").map((part,i)=><Fragment>{i>0&&<a href={base+"people/moyo/"}>Moyo</a>}{part}</Fragment>)}</p><h4 class="story-label solution-label">Solution</h4></>}<p>{d.solution.split("Moyo").map((part,i)=><Fragment>{i>0&&<a href={base+"people/moyo/"}>Moyo</a>}{part}</Fragment>)}</p></div></section>
<section class="content-section"><h2>How it works in Nova Corp</h2>{d.sections.map(([title,body])=><div class="pilot-story"><h3>{title}</h3><p>{body.split("Moyo").map((part,i)=><Fragment>{i>0&&<a href={base+"people/moyo/"}>Moyo</a>}{part}</Fragment>)}</p></div>)}<div class="card-list">{d.links.map(([label,route])=><a class="system-card" href={base+route}><h3>{label}</h3><span class="readmore">Explore →</span></a>)}</div></section>
<section class="content-section"><h2>How {d.title} connects to Nova Corp</h2><figure class="glossary-flow">{["active-directory","domain-controller","dns","smb","kerberos","netlogon"].includes(slug)?<div class="split-flow"><div class="path-row"><a class="flow-node" href={base+"systems/nova-client/"}>💻 NOVA-CLIENT</a><span class="flow-arrow">↔<small>{slug==="dns"?"DNS · 53":slug==="netlogon"?"NETLOGON · SMB":slug==="kerberos"?"Kerberos · 88":"DNS / domain authentication"}</small></span><div class="flow-node"><a href={base+"systems/nova-dc01/"}>NOVA-DC01</a><a href={base+"systems/nova-dc02/"}>NOVA-DC02</a></div></div><div class="path-row"><a class="flow-node" href={base+"systems/nova-client/"}>💻 NOVA-CLIENT</a><span class="flow-arrow">↔<small>Direct SMB · TCP 445</small></span><a class="flow-node" href={base+"systems/nova-files01/"}>🗄️ NOVA-FILES01</a></div><p class="flow-partner">Routed connections cross <a href={base+"systems/nova-fw01/"}>NOVA-FW01</a>. File contents do not pass through a domain controller.</p></div>:<div class="flow-track">{d.flow.map(([icon,title,detail,route],i)=><Fragment>{i>0&&<div class="flow-arrow" aria-hidden="true">→</div>}<a class="flow-node" href={base+route}><span aria-hidden="true">{icon}</span><strong>{title}</strong><small>{detail}</small></a></Fragment>)}</div>}{["active-directory","dns","replication","domain-controller"].includes(slug)&&<p class="flow-partner"><a href={base+"systems/nova-dc01/"}>NOVA-DC01</a> ↔ <a href={base+"systems/nova-dc02/"}>NOVA-DC02</a> · {slug==="dns"?"Both host internal DNS":"Directory replication"}</p>}<figcaption>{d.flowCaption}</figcaption></figure></section>
<section class="content-section"><details><summary>Technical checks</summary><p>Run these on the system named in each step, with an authorized account.</p>{d.checks.map(([title,where,command,expected])=><div class="check"><h3>{title}</h3><p><strong>Where:</strong> {where}</p><pre><code>{command}</code></pre><p><strong>Expected:</strong> {expected}</p></div>)}</details><h3>Recorded outcome</h3><p>{d.recorded}</p>{d.images.length>0&&<Files01DocumentImages ids={d.images}/>}</section>
<section class="content-section"><h2>Related tests and incidents</h2>{d.incidents.length===0&&<p>No complete System State restoration incident is documented. See the backup record and its limits.</p>}<div class="card-list">{d.incidents.map(([title,body,route])=><a class="system-card" href={base+"incidents/"+route+"/"}><h3>{title}</h3><p>{body}</p><span class="readmore">Read investigation →</span></a>)}</div></section>
<section class="content-section"><details><summary>Related topics</summary><ul>{d.related.map(([title,route])=><li><a href={base+route}>{title}</a></li>)}</ul>{d.related.length===0&&<p><a href={base+"learn/active-directory/"}>Active Directory</a> · <a href={base+"recovery/"}>Recovery</a></p>}</details></section>
<section class="content-section"><h2>Engineering journals</h2><p><a href={base+"pdf-journals/"+d.pdf+".pdf"}>Open the complete original engineering PDF →</a></p>{evidence.journal&&<p><a href={internalArticle(evidence.journal,base)}>Read the original engineering journal →</a></p>}<p><a href={internalArticle(evidence.primary,base)}>Complete original {d.title} reference →</a></p>{evidence.supporting.map(path=><p><a href={internalArticle(path,base)}>{path.split("/").at(-1)?.replace(/\.md$/,"").replaceAll("_"," ")} →</a></p>)}</section>
</article><aside><div class="sidebox"><h3>Where you can find it</h3><p>Systems that host or use this technology in Nova Corp.</p><div class="term-related">{found.map(s=><a href={base+"systems/"+s.slug+"/"}>{s.name.toUpperCase()} ↗</a>)}</div></div></aside></div></section>
<style>.glossary-pilot{min-width:0}.glossary-pilot aside{min-width:0}.glossary-pilot article{min-width:0}.glossary-pilot .content-section{margin-bottom:48px;min-width:0}.glossary-pilot .content-section p{margin:12px 0;line-height:1.65}.glossary-pilot .content-section h3{margin-top:18px}.pilot-story{border-top:1px solid var(--line,rgba(150,150,150,.25));padding:24px 0}.story-label{font-size:1rem;letter-spacing:.02em;margin:25px 0 6px}.problem-label{color:var(--c-red)}.solution-label{color:var(--c-green)}.glossary-flow{margin:24px 0 32px;padding:20px;border:1px solid var(--rule);border-radius:12px;background:var(--surface)}.flow-track{display:flex;align-items:center;gap:10px}.flow-node{flex:1;min-width:0;display:grid;text-align:center;gap:6px;padding:15px 8px;border:1px solid var(--rule);border-radius:10px;background:var(--surface);text-decoration:none!important;color:var(--ink)!important;overflow-wrap:anywhere}.flow-node span{font-size:2rem}.flow-node small{font-size:.75rem;color:var(--ink)}.flow-arrow{color:var(--c-amber);font-size:1.3rem;animation:flow 2s ease-in-out infinite}.flow-partner{text-align:center;font-size:.85rem}.glossary-flow figcaption{text-align:center;color:var(--ink);font-size:.82rem;margin-top:18px;line-height:1.5}.check{padding:12px 0;border-bottom:1px solid var(--line,var(--rule))}.check pre{max-width:100%;overflow:auto;box-sizing:border-box}.glossary-pilot summary{cursor:pointer;font-weight:650;padding:12px 0}.glossary-pilot details{min-width:0}@keyframes flow{50%{transform:translateX(4px);opacity:.6}}@media(prefers-reduced-motion:reduce){.flow-arrow{animation:none}}@media(max-width:600px){.flow-track{flex-direction:column}.flow-node{width:100%;box-sizing:border-box}.flow-arrow{transform:rotate(90deg);animation:none}}.split-flow{display:grid;gap:12px}.path-row{display:flex;align-items:center;gap:8px}.path-row .flow-arrow{display:grid;text-align:center;min-width:0;max-width:38%;gap:3px}.path-row .flow-arrow small{font-size:.72rem;line-height:1.2}.policy-original img{width:100%;height:auto}.policy-original figcaption{text-align:center;font-size:.84rem;color:var(--ink)}@media(max-width:600px){.path-row{flex-direction:column}.path-row .flow-arrow{transform:none;max-width:100%}}</style>
