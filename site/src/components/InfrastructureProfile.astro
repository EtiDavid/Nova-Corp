---
import Files01DocumentImages from "./Files01DocumentImages.astro";
import EvidencePanel from "./EvidencePanel.astro";
interface Props{firewall:boolean}
const {firewall}=Astro.props;
const base=import.meta.env.BASE_URL;
const d=firewall?{"name":"NOVA-FW01","intro":"NOVA-FW01 is the virtual pfSense firewall and gateway that connects Nova Corp’s networks. It decides which connections may cross between them, assigns network settings, supports name resolution and provides the WireGuard remote-access tunnel.","stories":[["Separating staff from infrastructure","Employees need to work with company files without sharing unrestricted access to management interfaces.","Nova Corp places staff on CLIENT VLAN 40 and servers on INFRA VLAN 20. pfSense routes permitted traffic between them and blocks selected management paths. The actual inventory records eight interfaces and five VLANs."],["Protecting administration tools","A normal employee workstation should not be able to open the firewall administration page.","The validation exercise found management access was too broad. I placed the two CLIENT management blocks before the broader allow rule and retested DNS, directory, file and Internet connectivity. Some other zones still have broad allow rules; full privileged management isolation is future work."],["Providing network settings","Configuring every workstation’s address and gateway by hand would introduce unnecessary mistakes.","The firewall has six DHCP scopes and five aliases for reusable rule definitions. Its DNS Resolver forwards nova.corp requests to DC01; a second override target is not established by the record."],["Connecting a remote employee","An employee away from the office needs selected resources without exposing every internal service to the Internet.","Nova Corp configured one active WireGuard tunnel and one peer. The historical handshake failure was traced to peer configuration and repaired. VPN_REMOTE firewall rules limit reachable services. Independent external-laptop validation remains deferred. Automatic outbound NAT supports Internet access; no pfSense port-forward rule is configured. The upstream router’s forwarding is separate."]],"specs":[["VM","100 · nova-fw01"],["OS hostname","pfSense.home.arpa"],["Platform","pfSense CE 2.8.1"],["CPU / RAM","2 vCPU / 2 GiB"],["Disk","16G on local-lvm"],["WAN","vtnet0 · DHCP · recorded 192.168.178.71"],["LAN trunk","vtnet1 · vmbr1"],["MGMT gateway","10.10.10.1"],["INFRA gateway","10.10.20.1"],["CLIENT gateway","10.10.40.1"],["VPN gateway","10.10.60.1"],["Firewall","17 filter rules: 13 pass, 4 block"],["DNS","Unbound; nova.corp → DC01"],["NAT","Automatic outbound NAT"],["Web admin","HTTPS"]],"inside":[["Network areas","Eight interfaces and their purposes","network/"],["Firewall rules","All 17 rules in their configured order","network/rules/"],["Aliases","Five reusable address and port groups","network/aliases/"],["DHCP","Six scopes and address assignment","reference/explore/network/DHCP/"],["DNS Resolver","Internal DNS forwarding","learn/dns/"],["WireGuard","Encrypted remote-access tunnel","learn/wireguard/"],["NAT and gateways","Routing and address translation","reference/explore/network/NAT_AND_GATEWAYS/"]],"inc":[["Unexpected · Management exposure","Rule ordering corrected; management and business paths retested.","firewall-management-exposure"],["Unexpected · VPN handshake failure","Packets arrived but peer authentication failed until configuration was corrected.","wireguard-handshake"],["Unexpected · DC01 VLAN migration","Gateway connectivity failed after migration.","dc01-vlan-migration"],["Unexpected · Same-VLAN subnet mismatch","Different subnet prefixes caused asymmetric traffic.","fileserver-subnet"],["Deferred · External VPN validation","Independent remote-client validation was not performed.","vpn-validation-deferred"]],"checks":[["Review the active firewall rules","pfSense shell","pfctl -sr","Expected rule ordering and relevant blocks appear; compare the exported configuration."],["Inspect interface addresses","pfSense shell","ifconfig","WAN, LAN, VLAN and WireGuard interfaces have their intended addresses."],["Inspect routing","pfSense shell","netstat -rn","Expected connected networks and upstream default route are present."],["Check WireGuard","pfSense shell","wg show","Expected tunnel and peer exist; recent handshake during an active authorized test."],["Confirm a permitted business path","NOVA-CLIENT","Test-NetConnection 10.10.20.20 -Port 445","TcpTestSucceeded: True."],["Confirm protected GUI access is denied","NOVA-CLIENT","Test-NetConnection 10.10.40.1 -Port 443","TcpTestSucceeded: False under the recorded CLIENT block policy."]],"journal":[["Firewall and VLAN setup","change_request_cr002"],["Remote access and WireGuard","CR-007_Remote_Access_VPN_WireGuard"]],"refs":["reference/explore/systems/NOVA-FW01/","reference/explore/network/RULES/","reference/Documentation/Change-Requests/CR-015_Phase_2_Validation_and_Closure/"],"flow":[["💻","NOVA-CLIENT","CLIENT VLAN 40","systems/nova-client/"],["🛡️","NOVA-FW01","Evaluate rules and route","systems/nova-fw01/"],["🗄️","INFRA VLAN 20","Permitted DNS / AD / SMB","network/zones/infra/"]],"caption":"The firewall routes the allowed traffic between network areas. Protected management traffic is a separate denied path; VPN traffic is also filtered."}:{"name":"NOVA-PROX01","intro":"NOVA-PROX01 runs the virtual machines behind Nova Corp. Proxmox itself is nested in VMware Workstation on a Windows physical host, allowing the firewall, two domain controllers, file server and workstation to operate as distinct guests.","stories":[["Running several systems on one host","Building a separate physical machine for every company service would require more equipment.","Nova Corp uses virtual machines with their own allocated CPU, RAM, disks and networking. Six VMs are recorded: five service/workstation guests and one unassigned spare VM201."],["Connecting the virtual office","The client and servers need distinct logical networks even though their virtual machines share hardware.","Proxmox uses vmbr0 for upstream management and the firewall WAN; vmbr1 connects tagged company networks. pfSense routes traffic, rather than hosting the VMs itself."],["Recovering after changes","A failed infrastructure change can make the management interface inaccessible even while the guests continue running.","The lab retains a pfSense rollback snapshot and six VM backup archives. The controlled gateway and web interface failures tested recovery. A running guest and an available backup do not prove application health or a successful restore."],["Avoiding storage exhaustion","Old snapshots consume storage as virtual disks change. Without reviewing capacity, services may run out of space.","I removed 20 obsolete snapshots, reducing thin-pool use from 86.73% to 52.88%. The recorded follow-up was 53.67% used. The monthly backup job selects VMs 100 and 101; an older schedule file needs reconciliation. Two active qcow2 disks on nova-backup are not backup archives."]],"specs":[["Hostname","nova-prox01.nova.local"],["Platform","Proxmox VE 9.2.2"],["Base OS","Debian 13.5"],["Kernel","7.0.2-6-pve"],["Management","192.168.178.26/24 · vmbr0"],["Gateway","192.168.178.1"],["Outer host","Windows / VMware Workstation"],["VM inventory","6 VMs"],["Virtual NICs","7"],["Disk/media attachments","28"],["Storage","local · local-lvm · nova-backup"],["Recovery","6 archives · 1 retained snapshot"],["Management isolation","Still on upstream network; target MGMT isolation pending"]],"inside":[["Virtualization floor","Six guests, disks and network connections","reference/explore/virtualization/README/"],["VM 100 · Firewall","pfSense","systems/nova-fw01/"],["VM 101 · DC01","Identity and DNS","systems/nova-dc01/"],["VM 102 · DC02","Second writable controller","systems/nova-dc02/"],["VM 103 · Client","Employee workstation","systems/nova-client/"],["VM 104 · Files","Company documents","systems/nova-files01/"],["VM 201 · Spare","Unassigned guest","reference/explore/virtualization/vms/201/"],["vmbr0","Outer management and WAN","reference/explore/virtualization/bridges/vmbr0/"],["vmbr1","Internal company switching","reference/explore/virtualization/bridges/vmbr1/"],["Backup inventory","Archives and scheduled backup job","reference/explore/virtualization/BACKUPS/"]],"inc":[["Controlled · Default gateway failure","Local access remained available while Internet connectivity failed.","proxmox-default-gateway"],["Controlled · WebGUI failure","The management UI failed while SSH and guests remained available.","proxmox-webgui-outage"],["Unexpected · Snapshot storage pressure","Twenty obsolete snapshots were removed after an inventory review.","proxmox-storage-pressure"]],"checks":[["List virtual machines","Proxmox shell","qm list","All six expected VM IDs are listed; compare intended state."],["Check storage capacity","Proxmox shell","pvesm status","All intended stores are available and have adequate free space."],["Review thin pool","Proxmox shell","lvs -o lv_name,lv_size,data_percent,metadata_percent","Thin-pool data and metadata utilization are below the operational alert threshold."],["Inspect routing","Proxmox shell","ip route","Default route via 192.168.178.1 and connected management subnet."],["Check web management service","Proxmox shell","systemctl is-active pveproxy","active"],["Inspect NIC tags","Proxmox shell","qm config 103","net0 connects to vmbr1 with tag 40."]],"journal":[["Proxmox installation and recovery","change_request_cr001"]],"refs":["reference/explore/systems/NOVA-PROX01/","reference/explore/virtualization/BACKUPS/","reference/Documentation/Change-Requests/CR-015_Phase_2_Validation_and_Closure/"],"flow":[["🖥️","Windows / VMware","Physical host and outer virtualization","systems/nova-prox01/"],["🗄️","NOVA-PROX01","Nested hypervisor","systems/nova-prox01/"],["💻","Company VMs","Firewall, DCs, file server, workstation","company/"]],"caption":"The five service/workstation guests share one physical failure domain. The spare is separate in the VM inventory; Proxmox hosts guests, not the firewall."};
---
<section class="section compact"><div class="container grid-main deep-system-profile infra-profile"><article>
<section class="content-section"><h2>What is {d.name}?</h2><p>{d.intro}</p>{firewall?<EvidencePanel subject="pfSense firewall dashboard" requested="A reviewed pfSense dashboard and rule configuration screenshot is needed."/>:<p class="muted">The exact virtual machine inventory and hardware records are linked below. A reviewed hypervisor dashboard image is still needed.</p>}</section>
<section class="content-section"><h2>Why does Nova Corp need it and what problems does it solve?</h2>{d.stories.map(([title,problem,solution],i)=><div class="pilot-story"><h3>{i+1}. {title}</h3><h4 class="story-label problem-label">Problem</h4><p>{problem}</p><h4 class="story-label solution-label">Solution</h4><p>{solution}</p>{firewall&&i===1&&<figure class="document-image"><img src={base+"journal-figures/cr007/04_rule_order.png"} alt="Original journal diagram showing firewall rule ordering"/><figcaption><strong>Firewall rule order</strong><p>Original explanatory illustration, not a screenshot of the currently configured rules.</p></figcaption></figure>}{firewall&&i===3&&<figure class="document-image"><img src={base+"journal-figures/cr007/03_two_stage_firewall.png"} alt="Original journal diagram showing two firewall stages"/><figcaption><strong>Remote network path</strong><p>Original illustration of the upstream and pfSense firewall stages.</p></figcaption></figure>}{!firewall&&i===0&&<Files01DocumentImages ids={["fileserver-proxmox-hardware"]}/>}</div>)}</section>
<section class="content-section"><h2>Inside this server</h2><div class="card-list">{d.inside.map(([title,desc,route])=><a class="system-card" href={base+route}><h3>{title}</h3><p>{desc}</p><span class="readmore">Explore →</span></a>)}</div></section>
<section class="content-section"><h2>How {d.name} connects to Nova Corp</h2><figure class="infra-flow"><div class="flow-track">{d.flow.map(([icon,title,desc,route],i)=><Fragment>{i>0&&<span class="flow-arrow" aria-hidden="true">→</span>}<a class="flow-node" href={base+route}><span>{icon}</span><strong>{title}</strong><small>{desc}</small></a></Fragment>)}</div><figcaption>{d.caption}</figcaption></figure></section>
<section class="content-section"><h2>Related tests and incidents</h2><div class="card-list">{d.inc.map(([title,desc,slug])=><a class="system-card" href={base+"incidents/"+slug+"/"}><h3>{title}</h3><p>{desc}</p><span class="readmore">Read investigation →</span></a>)}</div></section>
<section class="content-section"><details><summary>Technical checks</summary><p>Run these read-only diagnostics where indicated. Expected output is what a healthy system returns.</p>{d.checks.map(([purpose,where,cmd,result])=><div class="health-check"><h3>{purpose}</h3><p><strong>Where:</strong> {where}</p><pre><code>{cmd}</code></pre><p><strong>Expected:</strong> {result}</p></div>)}</details></section>
<section class="content-section"><details><summary>Related topics</summary><p><a href={base+"learn/vlan/"}>VLAN</a> · <a href={base+"learn/firewall/"}>Firewall</a> · <a href={base+"learn/proxmox/"}>Proxmox</a> · <a href={base+"learn/wireguard/"}>WireGuard</a></p></details></section>
<section class="content-section"><h2>Engineering journals</h2><div class="card-list">{d.journal.map(([title,slug])=><a class="system-card" href={base+"journals/"+slug+"/"}><h3>{title}</h3><span class="readmore">Read original PDF and text →</span></a>)}</div><p><a href={base+d.refs[0]}>Original engineering records →</a></p>{d.refs.slice(1).map(route=><p><a href={base+route}>{route.includes("CR-015")?"Phase 2 validation and closure":"Complete technical inventory"} →</a></p>)}</section>
</article><aside><div class="sidebox"><h3>Technical Profile</h3><dl class="fact-list">{d.specs.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></aside></div></section>
<style>.infra-profile>*{min-width:0}.infra-profile .content-section{margin-bottom:45px;min-width:0}.infra-profile p{line-height:1.65;margin:12px 0}.pilot-story{border-top:1px solid var(--line,var(--rule));padding:24px 0}.story-label{font-size:1rem;margin:25px 0 6px;letter-spacing:.02em}.problem-label{color:var(--c-red)}.solution-label{color:var(--c-green)}.document-image{margin:26px 0}.document-image img{display:block;width:100%;height:auto}.document-image figcaption{text-align:center;font-size:.84rem;color:var(--ink)}.infra-flow{padding:20px;border:1px solid var(--rule);background:var(--surface);border-radius:12px}.flow-track{display:flex;align-items:center;gap:8px}.flow-node{flex:1;min-width:0;display:grid;gap:6px;padding:12px 8px;text-align:center;border:1px solid var(--rule);background:var(--surface);border-radius:10px;overflow-wrap:anywhere;text-decoration:none!important;color:var(--ink)!important}.flow-node span{font-size:1.8rem}.flow-node small{font-size:.75rem;color:var(--ink)}.flow-arrow{color:var(--c-amber);animation:travel 2s ease-in-out infinite}.infra-flow figcaption{text-align:center;margin-top:18px;font-size:.82rem;color:var(--ink)}.health-check pre{overflow:auto;max-width:100%}.infra-profile summary{cursor:pointer;font-weight:650;padding:12px 0}@keyframes travel{50%{transform:translateX(4px);opacity:.6}}@media(prefers-reduced-motion:reduce){.flow-arrow{animation:none}}@media(max-width:600px){.flow-track{flex-direction:column}.flow-node{width:100%;box-sizing:border-box}.flow-arrow{transform:rotate(90deg);animation:none}}</style>
