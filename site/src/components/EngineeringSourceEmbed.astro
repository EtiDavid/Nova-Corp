---
/** Embed the full exact repository explanation within an existing curated
 * profile. The source is copied at build from docs/*.md, so descriptions do
 * not silently diverge from the canonical GitHub Markdown.
 */
import {getEntry,render} from "astro:content";
interface Props{sourcePath:string;title?:string}
const {sourcePath,title="Complete engineering explanation"}=Astro.props;
const id=sourcePath.replace(/^docs\//,"").replace(/\.md$/i,"");
const entry=await getEntry("reference",id);
if(!entry)throw Error("Missing source document for public profile: "+sourcePath);
const {Content}=await render(entry);
const base=import.meta.env.BASE_URL;
---
<section class="content-section engineer-source-section" aria-label={title}>
<div class="engineering-source-label"><span>ORIGINAL DOCUMENTATION / VERIFIED PUBLIC REPOSITORY SOURCE</span><span class="engineering-source-status">Complete article</span></div>
<h2>{title}</h2>
<p class="muted engineering-source-intro">This section uses the actual public Markdown record, not a shortened AI-generated description. It includes the documented configuration, reasons, links to related components and engineering evidence.</p>
<article class="reference-content source-document inline-source-doc"><Content /></article>
<div class="engineering-source-bottom"><a href={base+"reference/"+id+"/"}>Open this as a standalone article ↗</a><a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">Original GitHub Markdown ↗</a></div>
</section>
