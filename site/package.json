{
  "name": "novacorp-world-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/stage-source-docs.mjs && python3 scripts/stage-complete-pdf-journals.py && npm run stage:evidence && npm run stage:journals && npm run stage:pdf-evidence",
    "dev": "astro dev",
    "start": "astro dev",
    "validate": "node scripts/validate-graph.mjs && node scripts/validate-nova.mjs",
    "build": "npm run validate && npm run stage:evidence && astro build && node scripts/make-sitemap.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:links": "node scripts/check-built-links.mjs",
    "test:coverage": "node scripts/check-public-catalog.mjs",
    "test:sources": "node scripts/check-public-sources.mjs",
    "test:evidence": "node scripts/check-published-evidence.mjs",
    "test:acls": "node scripts/validate-public-acls.mjs",
    "stage:evidence": "node scripts/stage-public-evidence.mjs",
    "precheck": "node scripts/stage-source-docs.mjs && python3 scripts/stage-complete-pdf-journals.py",
    "prebuild": "node scripts/stage-source-docs.mjs && python3 scripts/stage-complete-pdf-journals.py && node scripts/stage-journal-figures.mjs && python3 scripts/stage-approved-pdf-evidence.py",
    "stage:pdf-evidence": "python3 scripts/stage-approved-pdf-evidence.py",
    "stage:journals": "node scripts/stage-journal-figures.mjs",
    "stage:complete-pdfs": "python3 scripts/stage-complete-pdf-journals.py",
    "test:references": "node scripts/check-source-mirror.mjs",
    "test:incidents": "node scripts/check-incident-fidelity.mjs",
    "test:site-parity": "node scripts/audit-site-source-coverage.mjs",
    "test:pdf-evidence": "node scripts/check-approved-pdf-evidence.mjs",
    "test:complete-pdfs": "node scripts/check-complete-pdf-journals.mjs",
    "test:browser": "node scripts/smoke-v2.mjs && node scripts/smoke-archive.mjs && node scripts/smoke-explainer.mjs && node scripts/smoke-a11y.mjs",
    "test:all-pages": "node scripts/audit-every-page-browser.mjs",
    "test:legacy": "node scripts/audit-legacy-routes.mjs",
    "test:secrets": "node scripts/scan-secrets.mjs",
    "test:facts": "node scripts/fact-check.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xyflow/react": "^12.9.2",
    "astro": "^5.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.1",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.11"
  }
}
